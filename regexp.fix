// Simple regular expression.
//
// Currently it only supports patterns below:
// - Character classes: `[xyz]`, `[^xyz]`, `.`, `\d`, `\D`, `\w`, `\W`, `\s`,
//   `\S`, `\t`, `\r`, `\n`, `\v`, `\f`, `[\b]`, `x|y`
// - Assertions: `^`, `$`
// - Groups: `(x)`
// - Quantifiers: `x*`, `x+`, `x?`, `x{n}`, `x{n,}`, `x{n,m}`
//
// This follows JavaScript but for one thing: where several alternatives match at one place, the
// longest wins. `a|ab` matched against `ab` gives `ab`; JavaScript gives `a`.
//
// For what the pattern syntax above means, see
// [mdn web docs: Regular expressions](https://developer.mozilla.org/en-US/docs/Web/JavaScript/Guide/Regular_expressions).
//
// LIMITATION:
//
// A character class holds single byte characters (U+0001..U+007F). UTF-8 writes a character from
// U+0080 upward as two or more bytes, and a Fix string holds no null character (U+0000).
//
module RegExp;

import RegExp.RegExpNFA::{
    DFA, Group, NFA, DFA::{find, make, search_every, search_from}, NFA::compile, 
    Replacement::{calc_replacement, compile}
};
import RegExp.RegExpPattern::Pattern::{parse, pgroup};
import RegExp.StringEx::{find_byte, substring};
import Std::{
    Array, Bool, ErrMsg, I64, Iterator, Option, Result, String, U8, 
    Array::{@, @size, empty, is_empty, pop_back, push_back, to_iter}, Functor::map, 
    Iterator::{Item, fold, map, to_array}, LessThan::max, Option::{as_some, is_none, is_some, none, some}, 
    Result::{err, ok}, 
    String::{@size, concat_iter, get_bytes}
};

// Type of a compiled regular expression.
type RegExp = unbox struct {
    flags: String,   // the flags it was compiled with, of which `g` is read
    nfa: NFA         // the automaton the pattern compiled to
};

namespace RegExp {

    // `RegExp::compile(pattern, flags)` compiles `pattern` into a regular expression.
    // `flags` change behavior of regular expression matching.
    // Currently only global flag (`"g"`) is supported.
    compile: String -> String -> Result ErrMsg RegExp;
    compile = |pattern_str, flags| (
        let pattern = *Pattern::parse(pattern_str);
        let pattern = pgroup $ (0, pattern); // since whole pattern is group 0
        let nfa = NFA::compile(pattern);
        ok $ RegExp { flags: flags, nfa:nfa }
    );

    // `regexp.matcher` is the regular expression together with a scanner of its own.
    //
    // A scanner works out what the automaton does with a byte the first time it reads that byte in
    // that state, and keeps the answer. `Matcher`'s matching functions hand the scanner back, so a
    // program that matches many strings against one regular expression pays for the working out
    // once, where `RegExp`'s own matching functions make a scanner for each match and let it go.
    //
    // Example:
    // ```
    // let matcher = RegExp::compile("[a-z]+", "g").as_ok.matcher;
    // let (first, matcher) = matcher.match_all("abc def");
    // let (second, matcher) = matcher.match_all("ghi jkl");
    // ```
    matcher: RegExp -> Matcher;
    matcher = |regexp| Matcher {
        global: regexp.@flags.find_byte('g').is_some, dfa: DFA::make(regexp.@nfa)
    };

    // `regexp.match(target)` matches `target` against `regexp`.
    //
    // If the global flag (`"g"`) is not set, it returns an array of the groups of the first match.
    // Group 0 is a substring that matches the entire regular expression.
    // Group 1 and beyond are the captured substrings in each group. If not captured, the group will be an empty string.
    //
    // Example:
    // ```
    // let regexp = RegExp::compile("[a-z]+([0-9]+)", "").as_ok;
    // let groups = regexp.match_one("abc012 def345").as_ok;
    // // groups == ["abc012", "012"]
    // ```
    //
    // If the global flag (`"g"`) is set, all matching results will be returned, but captured groups will not be included.
    //
    // Example:
    // ```
    // let regexp = RegExp::compile("[a-z]+([0-9]+)", "g").as_ok;
    // let groups = regexp.match_one("abc012 def345").as_ok;
    // // groups == ["abc012", "def345"]
    // ```
    //
    // If the match against the regular expression fails, an error `"NotMatch"` is reported.
    //
    // This function is similar to [String.match()](https://developer.mozilla.org/ja/docs/Web/JavaScript/Reference/Global_Objects/String/match)
    // function of JavaScript.
    match_one: String -> RegExp -> Result ErrMsg (Array String);
    match_one = |target, regexp| (
        let (found, _) = regexp.matcher.match_one(target);
        found
    );


    // `regexp.match_all(target)` matches `target` against `regexp`.
    // All matching results will be returned including captured groups.
    //
    // If the match against the regular expression fails, an empty array is returned.
    //
    // This function is similar to [String.matchAll()](https://developer.mozilla.org/ja/docs/Web/JavaScript/Reference/Global_Objects/String/matchAll)
    // function of JavaScript.
    match_all: String -> RegExp -> Array (Array String);
    match_all = |target, regexp| (
        let (found, _) = regexp.matcher.match_all(target);
        found
    );

    // `regexp.replace_all(target, replacement)` matches `target` against `regexp`,
    // and replace all matching substrings with `replacement`.
    // If `replacement` contains `$&`, it is substituted with entire matched substring.
    // If `replacement` contains `$n` where `n` is an integer, it is substituted with
    // the captured group.
    // If `replacement` contains `$$`, it is substituted with single `$`.
    //
    // Example:
    // ```
    // let regexp = RegExp::compile("(\\w\\w)(\\w)", "").as_ok;
    // let result = regexp.replace_all("abc def ijk", "$2$1");
    // // result == "cab fde kij"
    // ```
    //
    // This function is similar to [String.replaceAll()](https://developer.mozilla.org/ja/docs/Web/JavaScript/Reference/Global_Objects/String/replaceAll)
    // function of JavaScript.
    // Note that `$'`, `` $` ``, `$<Name>` are not supported yet.
    replace_all: String -> String -> RegExp -> String;
    replace_all = |target, replacement, regexp| (
        let (replaced, _) = regexp.matcher.replace_all(target, replacement);
        replaced
    );

    // `regexp.find_all(bytes)` is an iterator over the matches in `bytes`, taken left to right,
    // none of them overlapping another, each reported as where its groups stand. Each match is
    // looked for when the iterator is advanced to it, so a program that stops early does not pay
    // for the matches after.
    //
    // A match is reported as one `(begin, end)` pair of byte positions per group, the whole match
    // first. A group that captured nothing stands as `(-1, -1)`. Where several matches begin at one
    // place, the longest is taken, and after a match that holds no byte the search goes on from the
    // next byte. The global flag (`"g"`) makes no difference here.
    //
    // A string's positions are those of its bytes, which `get_bytes.pop_back` gives.
    //
    // Example:
    // ```
    // let regexp = RegExp::compile("([a-z]+)([0-9]+)", "").as_ok;
    // let found = regexp.find_all("abc012 def345".get_bytes.pop_back).to_array;
    // // found == [[(0, 6), (0, 3), (3, 6)], [(7, 13), (7, 10), (10, 13)]]
    // ```
    //
    // # Parameters
    // * `bytes` - The bytes to search.
    // * `regexp` - The regular expression.
    find_all: [?it : Iterator, Item ?it = Array (I64, I64)] Array U8 -> RegExp -> ?it;
    find_all = |bytes, regexp| Matches {
        _bytes: bytes, _from: 0, _dfa: DFA::make(regexp.@nfa), _fitted: false
    };

    // `regexp.find_from(from, bytes)` finds the match in `bytes` that begins first at or after the
    // byte position `from`, taking the longest of those that begin there, and reports where each of
    // its groups stands, as `find_all` reports them. It reports `none()` where no match begins at
    // or after `from`. A negative `from` counts as `0`.
    //
    // Example:
    // ```
    // let regexp = RegExp::compile("[0-9]+", "").as_ok;
    // let found = regexp.find_from(4, "abc012 def345".get_bytes.pop_back);
    // // found == some([(4, 6)])
    // ```
    //
    // # Parameters
    // * `from` - The byte position the match has to begin at or after.
    // * `bytes` - The bytes to search.
    // * `regexp` - The regular expression.
    find_from: I64 -> Array U8 -> RegExp -> Option (Array (I64, I64));
    find_from = |from, bytes, regexp| (
        let (found, _) = regexp.matcher.find_from(from, bytes);
        found
    );
}

// The stretches of a string the groups of a match cover, a group that captured nothing giving the
// empty string.
//
// # Parameters
// * `groups` - Where each group of the match runs from and to.
// * `target` - The string the match was found in.
_groups_to_strings: Array Group -> String -> Array String;
_groups_to_strings = |groups, target| (
    groups.to_iter.map(|(begin, end)|
        if begin < 0 || end < 0 { "" };
        target.substring(begin, end)
    ).to_array
);

// The matches `RegExp::find_all` reports, each looked for when the iterator is advanced to it.
type Matches = unbox struct {
    _bytes: Array U8,   // the bytes searched
    _from: I64,         // the position the next match has to begin at or after
    _dfa: DFA,          // the scanner, and what it has worked out so far
    // Whether the scanner has been told what to look for over these bytes. The first search tells
    // it, and the searches after it search as it stands.
    _fitted: Bool
};

impl Matches : Iterator {
    type Item Matches = Array (I64, I64);
    advance = |matches| (
        let Matches { _bytes: bytes, _from: from, _dfa: dfa, _fitted: fitted } = matches;
        let (found, dfa) = if fitted { dfa.find(bytes, from) } else { dfa.search_from(bytes, from) };
        if found.is_none { none() };
        let groups = found.as_some;
        let (begin, end) = groups.@(0);
        // A match that read nothing would be found again where it was found.
        let next = if end > begin { end } else { begin + 1 };
        some $ (Matches { _bytes: bytes, _from: next, _dfa: dfa, _fitted: true }, groups)
    );
}

// A compiled regular expression together with the scanner it has built so far. See
// `RegExp::matcher`.
type Matcher = unbox struct {
    global: Bool,   // whether the global flag was given, which `match_one` reads
    dfa: DFA        // the automaton, and what the scanner has worked out of it so far
};

namespace Matcher {

    // `matcher.match_one(target)` matches `target` against the regular expression, and reports the
    // scanner as the match left it.
    //
    // What it reports is what `RegExp::match_one` reports.
    //
    // # Parameters
    // * `target` - The string to match against.
    // * `matcher` - The regular expression and its scanner.
    match_one: String -> Matcher -> (Result ErrMsg (Array String), Matcher);
    match_one = |target, matcher| (
        let bytes = target.get_bytes.pop_back;
        if matcher.@global {
            let (matches, dfa) = matcher.@dfa.search_every(bytes);
            let matcher = matcher.set_dfa(dfa);
            if matches.is_empty {
                (err $ "NotMatch", matcher)
            };
            (ok $ target._groups_to_strings(matches.map(|groups| groups.@(0))), matcher)
        } else {
            let (opt, dfa) = matcher.@dfa.search_from(bytes, 0);
            let matcher = matcher.set_dfa(dfa);
            if opt.is_none {
                (err $ "NotMatch", matcher)
            };
            (ok $ target._groups_to_strings(opt.as_some), matcher)
        }
    );

    // `matcher.match_all(target)` matches `target` against the regular expression, and reports the
    // scanner as the match left it.
    //
    // What it reports is what `RegExp::match_all` reports.
    //
    // # Parameters
    // * `target` - The string to match against.
    // * `matcher` - The regular expression and its scanner.
    match_all: String -> Matcher -> (Array (Array String), Matcher);
    match_all = |target, matcher| (
        let bytes = target.get_bytes.pop_back;
        let (matches, dfa) = matcher.@dfa.search_every(bytes);
        (matches.map(|groups| target._groups_to_strings(groups)), matcher.set_dfa(dfa))
    );

    // `matcher.replace_all(target, replacement)` replaces every stretch of `target` the regular
    // expression matches with `replacement`, and reports the scanner as the work left it.
    //
    // What it reports is what `RegExp::replace_all` reports.
    //
    // # Parameters
    // * `target` - The string to work over.
    // * `replacement` - The text to put in place of every match.
    // * `matcher` - The regular expression and its scanner.
    replace_all: String -> String -> Matcher -> (String, Matcher);
    replace_all = |target, replacement, matcher| (
        let bytes = target.get_bytes.pop_back;
        let (matches, dfa) = matcher.@dfa.search_every(bytes);
        let matcher = matcher.set_dfa(dfa);
        let rep_frags = Replacement::compile(replacement);
        let output: Array String = Array::empty(matches.@size * 2 + 1);
        let (output, last) = matches.to_iter.fold(
            (output, 0), |groups, (output, last)|
            let (begin, end) = groups.@(0);
            let output = output.push_back(target.substring(last, begin));
            let output = output.push_back(calc_replacement(target, rep_frags, groups));
            (output, end)
        );
        let output = output.push_back(target.substring(last, target.@size));
        (output.to_iter.concat_iter, matcher)
    );

    // `matcher.find_all(bytes)` finds every match in `bytes`, and reports the scanner as the search
    // left it.
    //
    // What it reports is what `RegExp::find_all` reports.
    //
    // # Parameters
    // * `bytes` - The bytes to search.
    // * `matcher` - The regular expression and its scanner.
    find_all: Array U8 -> Matcher -> (Array (Array (I64, I64)), Matcher);
    find_all = |bytes, matcher| (
        let (matches, dfa) = matcher.@dfa.search_every(bytes);
        (matches, matcher.set_dfa(dfa))
    );

    // `matcher.find_from(from, bytes)` finds the match in `bytes` that begins first at or after the
    // byte position `from`, and reports the scanner as the search left it.
    //
    // What it reports is what `RegExp::find_from` reports.
    //
    // # Parameters
    // * `from` - The byte position the match has to begin at or after.
    // * `bytes` - The bytes to search.
    // * `matcher` - The regular expression and its scanner.
    find_from: I64 -> Array U8 -> Matcher -> (Option (Array (I64, I64)), Matcher);
    find_from = |from, bytes, matcher| (
        let (found, dfa) = matcher.@dfa.search_from(bytes, max(from, 0));
        (found, matcher.set_dfa(dfa))
    );
}