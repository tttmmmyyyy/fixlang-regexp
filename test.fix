module Test;

import RegExp::{
    Matcher::{match_all, match_one, replace_all}, 
    RegExp::{compile, match_all, match_one, matcher, replace_all, @nfa}
};
import RegExp.RegExpNFA::{
    DFA, Groups, NFA, DFA::{find, make, _insert_at, _with_forced_set}, 
    NFA::{search, search_all, @forced_sets, @prefix, _search_threads}
};
import RegExp.StdBytes::{find_byte, find_bytes, find_bytes_within};
import Std::{
    loop, Array, Bool, I64, IO, Option, String, U8, 
    Array::{empty, pop_back, push_back, to_iter, @, @size}, 
    Debug::{assert, assert_eq}, Iterator::{fold, fold_m, range}, LoopState::{break, continue}, 
    Monad::pure, Option::{as_some, is_none, none, some}, Result::{as_ok, is_err}, 
    String::get_bytes, ToString::to_string
};

// A case for `match_one` and `match_all`.
type MatchCase = unbox struct {
    pattern: String,            // the pattern to compile
    flags: String,              // the flags to compile it with
    target: String,             // the string to match against
    one: Array String,          // what `match_one` gives, an empty array standing for `NotMatch`
    all: Array (Array String)   // what `match_all` gives
};

// A case for `replace_all`.
type ReplaceCase = unbox struct {
    pattern: String,       // the pattern to compile
    flags: String,         // the flags to compile it with
    target: String,        // the string to work over
    replacement: String,   // the text to put in place of every match
    result: String         // the string that comes back
};

// The cases `match_one` and `match_all` are held to. The groups below take the features of the
// pattern language one at a time.
_match_cases: Array MatchCase;
_match_cases = [
    // Characters and classes.
    MatchCase { pattern: "a", flags: "", target: "banana",
                one: ["a"], all: [["a"], ["a"], ["a"]] },
    MatchCase { pattern: "a", flags: "g", target: "banana",
                one: ["a", "a", "a"], all: [["a"], ["a"], ["a"]] },
    MatchCase { pattern: "[a-c]+", flags: "g", target: "abcxabz",
                one: ["abc", "ab"], all: [["abc"], ["ab"]] },
    MatchCase { pattern: "[^a-c]+", flags: "g", target: "abcxabz",
                one: ["x", "z"], all: [["x"], ["z"]] },
    MatchCase { pattern: "\\d+", flags: "g", target: "a12b345",
                one: ["12", "345"], all: [["12"], ["345"]] },
    MatchCase { pattern: "\\w+", flags: "g", target: "a_1 b-2",
                one: ["a_1", "b", "2"], all: [["a_1"], ["b"], ["2"]] },
    MatchCase { pattern: "\\s+", flags: "g", target: "a  b\tc",
                one: ["  ", "\t"], all: [["  "], ["\t"]] },

    // A match may begin anywhere, on either side of a line break included.
    MatchCase { pattern: "a", flags: "g", target: "a\na\na",
                one: ["a", "a", "a"], all: [["a"], ["a"], ["a"]] },
    MatchCase { pattern: "a", flags: "g", target: "b\na", one: ["a"], all: [["a"]] },
    MatchCase { pattern: "a", flags: "", target: "b\na", one: ["a"], all: [["a"]] },
    MatchCase { pattern: "[0-9]+", flags: "g", target: "x1\nx22\nx333",
                one: ["1", "22", "333"], all: [["1"], ["22"], ["333"]] },
    // `.` stands for every character but a line break, so it matches on either side of one without
    // matching the break itself.
    MatchCase { pattern: ".", flags: "g", target: "ab", one: ["a", "b"], all: [["a"], ["b"]] },
    MatchCase { pattern: ".", flags: "g", target: "a\nb", one: ["a", "b"], all: [["a"], ["b"]] },

    // Where several matches begin at one place the longest is taken, so an alternative is chosen by
    // how far it reaches rather than by the order it is written in.
    MatchCase { pattern: "a|ab", flags: "", target: "ab", one: ["ab"], all: [["ab"]] },
    MatchCase { pattern: "ab|a", flags: "", target: "ab", one: ["ab"], all: [["ab"]] },
    MatchCase { pattern: "a|ab", flags: "g", target: "ab ab",
                one: ["ab", "ab"], all: [["ab"], ["ab"]] },
    MatchCase { pattern: "(a|b)+", flags: "", target: "abab",
                one: ["abab", "b"], all: [["abab", "b"]] },

    // Quantifiers. A match that reads nothing is taken once at each place it can be taken, and the
    // walk then moves on by one so that it is not taken there again.
    MatchCase { pattern: "a*", flags: "", target: "b", one: [""], all: [[""], [""]] },
    MatchCase { pattern: "a*", flags: "g", target: "aab",
                one: ["aa", "", ""], all: [["aa"], [""], [""]] },
    MatchCase { pattern: "a+", flags: "g", target: "aab", one: ["aa"], all: [["aa"]] },
    MatchCase { pattern: "a?", flags: "g", target: "ab",
                one: ["a", "", ""], all: [["a"], [""], [""]] },
    MatchCase { pattern: "a{2}", flags: "g", target: "aaa", one: ["aa"], all: [["aa"]] },
    MatchCase { pattern: "a{2,}", flags: "g", target: "aaaa", one: ["aaaa"], all: [["aaaa"]] },
    MatchCase { pattern: "a{2,3}", flags: "g", target: "aaaaa",
                one: ["aaa", "aa"], all: [["aaa"], ["aa"]] },
    MatchCase { pattern: "(ab){2}", flags: "", target: "ababab",
                one: ["abab", "ab"], all: [["abab", "ab"]] },

    // Groups.
    MatchCase { pattern: "([a-z]+)([0-9]+)", flags: "", target: "abc012 def345",
                one: ["abc012", "abc", "012"],
                all: [["abc012", "abc", "012"], ["def345", "def", "345"]] },
    MatchCase { pattern: "([a-z]+)([0-9]+)", flags: "g", target: "abc012 def345",
                one: ["abc012", "def345"],
                all: [["abc012", "abc", "012"], ["def345", "def", "345"]] },
    MatchCase { pattern: "(a)(b)?", flags: "", target: "a",
                one: ["a", "a", ""], all: [["a", "a", ""]] },
    MatchCase { pattern: "((a)(b))", flags: "", target: "ab",
                one: ["ab", "ab", "a", "b"], all: [["ab", "ab", "a", "b"]] },

    // Assertions. `^` holds at the start of the string, not after a line break.
    MatchCase { pattern: "^a", flags: "", target: "ab", one: ["a"], all: [["a"]] },
    MatchCase { pattern: "^a", flags: "", target: "ba", one: [], all: [] },
    MatchCase { pattern: "^a", flags: "", target: "\na", one: [], all: [] },
    MatchCase { pattern: "b$", flags: "", target: "ab", one: ["b"], all: [["b"]] },
    MatchCase { pattern: "b$", flags: "", target: "ba", one: [], all: [] },

    // A quantifier inside a quantifier counts its rounds from the beginning again each time the one
    // around it comes round, so the two multiply.
    MatchCase { pattern: "(a{2}){2}", flags: "", target: "aaaaa",
                one: ["aaaa", "aa"], all: [["aaaa", "aa"]] },

    // A byte a match cannot begin with is passed over whatever its value, so text a pattern says
    // nothing about is read through to the match behind it.
    MatchCase { pattern: "\\d+", flags: "g", target: "\u3042\u3061\u306f12\u30443345",
                one: ["12", "3345"], all: [["12"], ["3345"]] },

    // A run of bytes every match begins with is taken from the automaton, and the run stops where
    // a match can end: `x*$` is met where the input ends, so nothing is forced past that and the
    // `x` before the end is not read past.
    MatchCase { pattern: "x*$", flags: "g", target: "bbx1ax",
                one: ["x", ""], all: [["x"], [""]] },

    // Nothing to match.
    MatchCase { pattern: "z", flags: "", target: "abc", one: [], all: [] },
    MatchCase { pattern: "z", flags: "g", target: "abc", one: [], all: [] }
];

// The cases `replace_all` is held to.
_replace_cases: Array ReplaceCase;
_replace_cases = [
    ReplaceCase { pattern: "(\\w\\w)(\\w)", flags: "", target: "abc def ijk",
                  replacement: "$2$1", result: "cab fde kij" },
    ReplaceCase { pattern: "a", flags: "g", target: "banana",
                  replacement: "-", result: "b-n-n-" },
    ReplaceCase { pattern: "a", flags: "g", target: "b\na\na",
                  replacement: "-", result: "b\n-\n-" },
    ReplaceCase { pattern: "(a)(b)", flags: "g", target: "abab",
                  replacement: "$2$1", result: "baba" },
    ReplaceCase { pattern: "x", flags: "g", target: "abc", replacement: "-", result: "abc" }
];

// A case for the byte searches the automaton reads text with.
type BytesCase = unbox struct {
    wanted: String,      // the bytes to look for
    from: I64,           // the position to look from
    text: String,        // the bytes to read
    found: Option I64    // where they stand, `none` where they stand nowhere at or after `from`
};

// The cases the byte searches are held to. `find_bytes_within` is held to the same answers with the
// looking stopped at the end of the text, since no run begins past that, and `find_byte` is held to
// them wherever the bytes looked for are one byte.
_bytes_cases: Array BytesCase;
_bytes_cases = [
    BytesCase { wanted: "b", from: 0, text: "abcabc", found: some(1) },
    BytesCase { wanted: "b", from: 2, text: "abcabc", found: some(4) },
    BytesCase { wanted: "z", from: 0, text: "abc", found: none() },
    // The end of the text, and a text holding no bytes at all.
    BytesCase { wanted: "c", from: 3, text: "abc", found: none() },
    BytesCase { wanted: "a", from: 0, text: "", found: none() },
    BytesCase { wanted: "bc", from: 0, text: "abcabc", found: some(1) },
    BytesCase { wanted: "bc", from: 2, text: "abcabc", found: some(4) },
    // The first byte of the run stands where the whole run does not, so the reading goes on from
    // the byte after it.
    BytesCase { wanted: "aab", from: 0, text: "aaab", found: some(1) },
    BytesCase { wanted: "abd", from: 0, text: "abcabd", found: some(3) },
    // A run reaching past the end of the text stands nowhere.
    BytesCase { wanted: "abc", from: 4, text: "abcabc", found: none() },
    BytesCase { wanted: "abcd", from: 0, text: "abc", found: none() },
    // No bytes at all stand at every position the text reaches.
    BytesCase { wanted: "", from: 2, text: "abc", found: some(2) },
    BytesCase { wanted: "", from: 3, text: "abc", found: some(3) },
    BytesCase { wanted: "", from: 4, text: "abc", found: none() }
];

// The cases the bounded search is held to: the bytes to look for, the position to look from, the
// position to stop looking at, the text to read, and where the bytes stand.
_bounded_bytes_cases: Array (String, I64, I64, String, Option I64);
_bounded_bytes_cases = [
    ("bc", 0, 6, "abcabc", some(1)),
    ("bc", 2, 5, "abcabc", some(4)),
    // The run at 4 begins past the position the looking stops at.
    ("bc", 2, 3, "abcabc", none()),
    ("abcd", 0, 6, "abc", none())
];

// The byte searches report the first position at or after the one they are given where the bytes
// they look for stand.
_test_byte_searches: IO ();
_test_byte_searches = (
    _bytes_cases.to_iter.fold_m((), |case, _|
        let wanted = case.@wanted.get_bytes.pop_back;
        let text = case.@text.get_bytes.pop_back;
        let name = "looking for " + case.@wanted.to_string + " in " + case.@text.to_string
            + " from " + case.@from.to_string;
        assert_eq(|_| name + " find_bytes", text.find_bytes(wanted, case.@from), case.@found);;
        assert_eq(
            |_| name + " find_bytes_within",
            text.find_bytes_within(wanted, case.@from, text.@size),
            case.@found
        );;
        if wanted.@size != 1 { pure() };
        assert_eq(|_| name + " find_byte", text.find_byte(wanted.@(0), case.@from), case.@found)
    );;
    _bounded_bytes_cases.to_iter.fold_m((), |(wanted, from, limit, text, found), _|
        assert_eq(
            |_| "looking for " + wanted.to_string + " in " + text.to_string + " from "
                + from.to_string + " up to " + limit.to_string,
            text.get_bytes.pop_back.find_bytes_within(wanted.get_bytes.pop_back, from, limit),
            found
        )
    )
);

// Names a case, so that a failure says which one failed.
//
// # Parameters
// * `pattern` - The pattern of the case.
// * `flags` - Its flags.
// * `target` - The string it works over.
_named: String -> String -> String -> String;
_named = |pattern, flags, target| "/" + pattern + "/" + flags + " over " + target.to_string;

// The scanner and the automaton are two ways of reading the same pattern over the same bytes, and
// they are held to the same answers: the section below draws patterns and strings at random and
// runs the two against each other. The automaton is the one to trust, since it walks every thread
// standing at a position and needs nothing remembered between positions.

// The numbers the random cases are drawn from. The same numbers come out on every run, so a case
// that fails can be looked at again.
type Draws = unbox struct {
    state: I64   // the number the next draw is worked out from
};

namespace Draws {
    // A number below a bound, and the draws that follow it.
    //
    // # Parameters
    // * `bound` - The number the draw stays below.
    // * `draws` - The numbers to draw from.
    _below: I64 -> Draws -> (I64, Draws);
    _below = |bound, draws| (
        let state = (draws.@state * 1103515245 + 12345) % 2147483648;
        (state / 65536 % bound, Draws { state: state })
    );

    // One of the strings offered, and the draws that follow it.
    //
    // # Parameters
    // * `offered` - The strings to draw from.
    // * `draws` - The numbers to draw from.
    _one_of: Array String -> Draws -> (String, Draws);
    _one_of = |offered, draws| (
        let (i, draws) = draws._below(offered.@size);
        (offered.@(i), draws)
    );
}

// The pieces a drawn pattern is put together from.
_atoms: Array String;
_atoms = ["a", "b", "c", ".", "[ab]", "[^a]", "\\d", "\\w", "\\s", "(a|b)", "(ab)", "(a)", "x"];

// The ways a drawn piece may be repeated. Most pieces stand once, so the empty repeat is offered
// several times over.
_repeats: Array String;
_repeats = ["", "", "", "", "*", "+", "?", "{2}", "{1,2}", "{2,}", "{0,2}"];

// The characters a drawn string is put together from. A line break is among them because a pattern
// may be read over one, and `.` may not.
_letters: Array String;
_letters = ["a", "b", "c", "x", " ", "\n", "1"];

// A run of pieces, each possibly repeated.
//
// # Parameters
// * `count` - How many pieces.
// * `draws` - The numbers to draw from.
_draw_run: I64 -> Draws -> (String, Draws);
_draw_run = |count, draws| (
    range(0, count).fold(("", draws), |_, (pattern, draws)|
        let (atom, draws) = draws._one_of(_atoms);
        let (repeat, draws) = draws._one_of(_repeats);
        (pattern + atom + repeat, draws)
    )
);

// A pattern: one or two runs of pieces, possibly held to the beginning or the end of the string.
//
// # Parameters
// * `draws` - The numbers to draw from.
_draw_pattern: Draws -> (String, Draws);
_draw_pattern = |draws| (
    let (extra_pieces, draws) = draws._below(3);
    let (left, draws) = _draw_run(extra_pieces + 1, draws);
    let (branch_draw, draws) = draws._below(3);
    let (pattern, draws) = if branch_draw == 0 {
        let (extra_pieces, draws) = draws._below(2);
        let (right, draws) = _draw_run(extra_pieces + 1, draws);
        (left + "|" + right, draws)
    } else {
        (left, draws)
    };
    let (begin_draw, draws) = draws._below(6);
    let (end_draw, draws) = draws._below(6);
    (
        (if begin_draw == 0 { "^" } else { "" }) + pattern + (if end_draw == 0 { "$" } else { "" }),
        draws
    )
);

// A string for a pattern to be read over.
//
// # Parameters
// * `draws` - The numbers to draw from.
_draw_target: Draws -> (String, Draws);
_draw_target = |draws| (
    let (length, draws) = draws._below(40);
    range(0, length).fold(("", draws), |_, (target, draws)|
        let (letter, draws) = draws._one_of(_letters);
        (target + letter, draws)
    )
);

// Every match the automaton finds, taken left to right, none of them overlapping another. This is
// what `NFA::search_all` reports, worked out by walking every thread rather than by the states the
// scanner builds.
//
// # Parameters
// * `bytes` - The bytes to read.
// * `nfa` - The automaton to run.
_search_all_threads: Array U8 -> NFA -> Array Groups;
_search_all_threads = |bytes, nfa| (
    let length = bytes.@size;
    let (matches, _) = loop((Array::empty(8), 0), |(matches, from)|
        if from > length { break $ (matches, from) };
        let opt = NFA::_search_threads(bytes, from, nfa);
        if opt.is_none { break $ (matches, from) };
        let groups = opt.as_some;
        let (begin, end) = groups.@(0);
        continue $ (matches.push_back(groups), if end > begin { end } else { begin + 1 })
    );
    matches
);

// How many random cases to draw.
_random_cases: I64;
_random_cases = 4000;

// Draws patterns and strings, and holds the scanner to what the automaton finds: every match of
// `search_all`, and the match `search` finds from each position of the string.
_test_against_threads: IO ();
_test_against_threads = (
    let (_, compiled, found) = *range(0, _random_cases).fold_m(
        (Draws { state: 20260821 }, 0, 0), |_, (draws, compiled, found)|
        let (pattern, draws) = _draw_pattern(draws);
        let (target, draws) = _draw_target(draws);
        let result = RegExp::compile(pattern, "g");
        if result.is_err { pure $ (draws, compiled, found) };
        let nfa = result.as_ok.@nfa;
        let bytes = target.get_bytes.pop_back;
        let name = _named(pattern, "g", target);
        let matches = nfa.search_all(bytes);
        assert_eq(|_| name + " search_all", matches, _search_all_threads(bytes, nfa));;
        range(0, bytes.@size + 1).fold_m((), |from, _|
            assert_eq(
                |_| name + " search from " + from.to_string,
                nfa.search(bytes, from),
                NFA::_search_threads(bytes, from, nfa)
            )
        );;
        pure $ (draws, compiled + 1, found + matches.@size)
    );
    // The draws are held to producing work. A generator that stopped producing patterns that
    // compile, or strings that the patterns are ever met by, would let every case agree without
    // anything having been compared.
    assert(|_| "the drawn patterns compile", compiled * 10 >= _random_cases * 9);;
    assert(|_| "the drawn patterns are met by the drawn strings", found >= _random_cases / 4)
);

// Every match the scanner finds while looking for a set of forced byte strings, the automaton
// finds by following its threads, and no other.
//
// Which set a search looks for turns on the text it is over, so the scanner is held to the
// automaton over every set the pattern offers. That is what tries a set that is wrong and that the
// texts drawn here would have led the search past.
_test_forced_sets: IO ();
_test_forced_sets = (
    let (_, tried) = *range(0, _random_cases).fold_m(
        (Draws { state: 20260904 }, 0), |_, (draws, tried)|
        let (pattern, draws) = _draw_pattern(draws);
        let (target, draws) = _draw_target(draws);
        let result = RegExp::compile(pattern, "g");
        if result.is_err { pure $ (draws, tried) };
        // The text is written out twice over, so that a string the pattern forces stands in it more
        // than once and the scanner has to go on after the first match it finds.
        let tried = *_forced_sets_agree(result.as_ok.@nfa, pattern, target + target, tried);
        pure $ (draws, tried)
    );
    // The draws are held to producing work. A generator that stopped producing patterns that force
    // anything would let every case agree without a set having been looked for at all.
    assert(|_| "the patterns drawn force byte strings", tried >= _random_cases / 4)
);


// Holds the scanner, looking for each set of forced byte strings the automaton offers in turn, to
// what the automaton finds by following its threads, and reports how many sets were tried.
//
// # Parameters
// * `nfa` - The automaton to search with.
// * `pattern` - The pattern it was compiled from, which names a failure.
// * `target` - The text to search.
// * `tried` - How many sets were tried before this text.
_forced_sets_agree: NFA -> String -> String -> I64 -> IO I64;
_forced_sets_agree = |nfa, pattern, target, tried| (
    let bytes = target.get_bytes.pop_back;
    let name = _named(pattern, "g", target);
    let by_threads = _search_all_threads(bytes, nfa);
    let sets = nfa.@forced_sets;
    range(0, sets.@size).fold_m(tried, |i, tried|
        let dfa = DFA::make(nfa)._with_forced_set(bytes, sets.@(i));
        assert_eq(|_| name + " forced set " + i.to_string, _search_all_by(bytes, dfa), by_threads);;
        pure $ tried + 1
    )
);

// The patterns whose forced byte strings take shapes a drawn pattern does not reach, together with
// texts holding those strings where no match is. A run longer than the room kept for one is broken
// in two, and what may be read before the second run is what says how far back a match holding it
// begins; a run repeated past that room is cut to it.
_forced_shape_cases: Array (String, String);
_forced_shape_cases = [
    ("abcdefghijklmnopqr", "zzqrz abcdefghijklmnopqr qr"),
    ("[ab]+abcdefghijklmnopqr", "qr bababcdefghijklmnopqr abcdefghijklmnop"),
    ("(ab){10}", "ababab abababababababababab"),
    ("a{20}", "aaaa aaaaaaaaaaaaaaaaaaaaaa")
];

// Holds the scanner to the automaton over the patterns whose forced byte strings take shapes a
// drawn pattern does not reach.
_test_forced_shapes: IO ();
_test_forced_shapes = (
    _forced_shape_cases.to_iter.fold_m(0, |(pattern, target), tried|
        let nfa = RegExp::compile(pattern, "g").as_ok.@nfa;
        let next = *_forced_sets_agree(nfa, pattern, target, tried);
        // Each case is written to force byte strings, so one that stopped forcing any would say so
        // here rather than go on passing with nothing looked for.
        assert(|_| _named(pattern, "g", target) + " forces byte strings", next > tried);;
        pure $ next
    );;
    pure()
);

// The bytes `NFA::compile` works out as the beginning of every match are the beginning of every
// match there is.
//
// A search passes over every position the run of bytes does not stand at, so a run reaching past
// what the pattern forces takes the search past matches. Holding the run to the matches says so
// wherever a drawn text holds one, rather than only where the text would have led the search past
// one.
_test_forced_beginning: IO ();
_test_forced_beginning = (
    let (_, checked) = *range(0, _random_cases).fold_m(
        (Draws { state: 20260918 }, 0), |_, (draws, checked)|
        let (pattern, draws) = _draw_pattern(draws);
        let (target, draws) = _draw_target(draws);
        let result = RegExp::compile(pattern, "g");
        if result.is_err { pure $ (draws, checked) };
        let nfa = result.as_ok.@nfa;
        let prefix = nfa.@prefix;
        if prefix.@size == 0 { pure $ (draws, checked) };
        let bytes = target.get_bytes.pop_back;
        let name = _named(pattern, "g", target);
        let checked = *_search_all_threads(bytes, nfa).to_iter.fold_m(checked, |groups, checked|
            let (begin, end) = groups.@(0);
            // The ends of the input are where an assertion may hold, so a match beginning at either
            // is looked for from a state of its own and is never passed over.
            if begin == 0 || begin == bytes.@size { pure $ checked };
            assert(
                |_| name + " match at " + begin.to_string + " begins with the forced bytes",
                _begins_with(bytes, begin, end, prefix)
            );;
            pure $ checked + 1
        );
        pure $ (draws, checked)
    );
    // The draws are held to producing work. A generator that stopped producing patterns that force
    // a beginning would let every case agree with no run having been held to anything.
    assert(
        |_| "the drawn patterns force a beginning the drawn strings meet",
        checked >= _random_cases / 10
    )
);

// Whether a stretch of the text begins with a byte string.
//
// # Parameters
// * `bytes` - The text to read.
// * `begin` - Where the stretch begins.
// * `end` - Where it ends.
// * `wanted` - The byte string it is to begin with.
_begins_with: Array U8 -> I64 -> I64 -> Array U8 -> Bool;
_begins_with = |bytes, begin, end, wanted| (
    if end - begin < wanted.@size { false };
    loop(0, |k|
        if k == wanted.@size { break $ true };
        if bytes.@(begin + k) != wanted.@(k) { break $ false };
        continue $ k + 1
    )
);

// A scanner kept from one match to the next reports what a scanner made for each match reports.
//
// A scanner keeps what it works out, so what it holds when a match begins depends on the matches
// before it. Several strings are matched with one scanner here, so that a scanner carrying what
// one string taught it is what the next string is matched with.
_test_kept_scanner: IO ();
_test_kept_scanner = (
    let (_, found) = *range(0, _random_cases).fold_m(
        (Draws { state: 20260917 }, 0), |_, (draws, found)|
        let (pattern, draws) = _draw_pattern(draws);
        let result = RegExp::compile(pattern, "g");
        if result.is_err { pure $ (draws, found) };
        let regexp = result.as_ok;
        let (targets, draws) = range(0, 4).fold((Array::empty(4), draws), |_, (targets, draws)|
            let (target, draws) = _draw_target(draws);
            (targets.push_back(target), draws)
        );
        let (_, found) = *targets.to_iter.fold_m((regexp.matcher, found), |target, (matcher, found)|
            let name = _named(pattern, "g", target);
            let (all, matcher) = matcher.match_all(target);
            assert_eq(|_| name + " kept match_all", all, regexp.match_all(target));;
            let (one, matcher) = matcher.match_one(target);
            assert_eq(|_| name + " kept match_one", one, regexp.match_one(target));;
            let (replaced, matcher) = matcher.replace_all(target, "<$&>");
            assert_eq(
                |_| name + " kept replace_all", replaced, regexp.replace_all(target, "<$&>")
            );;
            pure $ (matcher, found + all.@size)
        );
        pure $ (draws, found)
    );
    // The draws are held to producing work. A generator that stopped producing strings the patterns
    // are met by would let every case agree without a scanner having carried anything.
    assert(|_| "the kept scanner finds matches", found >= _random_cases / 4)
);

// Every match a scanner finds over a text, taken one after another as a search takes them.
//
// # Parameters
// * `bytes` - The text to search.
// * `dfa` - The scanner to search with.
_search_all_by: Array U8 -> DFA -> Array Groups;
_search_all_by = |bytes, dfa| (
    let length = bytes.@size;
    let (matches, _, _) = loop((Array::empty(8), 0, dfa), |(matches, from, dfa)|
        if from > length { break $ (matches, from, dfa) };
        let (opt, dfa) = dfa.find(bytes, from);
        if opt.is_none { break $ (matches, from, dfa) };
        let groups = opt.as_some;
        let (begin, end) = groups.@(0);
        continue $ (matches.push_back(groups), if end > begin { end } else { begin + 1 }, dfa)
    );
    matches
);

// A drawn string of `a`s and `b`s of the given length. What carries the scanner past the states it
// may hold is a string whose stretches of twenty bytes are nearly all different; drawing the bytes
// gives that, where writing the string out would mean spelling every byte.
//
// # Parameters
// * `length` - How long the string is.
_draw_letters: I64 -> String;
_draw_letters = |length| (
    let (target, _) = range(0, length).fold(("", Draws { state: 20260822 }), |_, (target, draws)|
        let (i, draws) = draws._below(2);
        (target + (if i == 0 { "a" } else { "b" }), draws)
    );
    target
);

// A string holding one string over and over.
//
// # Parameters
// * `unit` - The string to hold.
// * `times` - How many times to hold it.
_repeated: String -> I64 -> String;
_repeated = |unit, times| range(0, times).fold("", |_, held| held + unit);

// The cases that carry the scanner past what it may take, where the search is given back to the
// automaton: the pattern, the string to read, and the matches the string holds. They are written
// out rather than drawn because the bounds are reached only by an input far longer than a drawn
// one, and only by a pattern of a particular shape. The matches are written out rather than taken
// from the automaton because the automaton is what finishes these searches, so taking them from it
// would be comparing it against itself.
//
// The first two patterns stand for more states than the scanner may hold: what the automaton reads
// next depends on the twenty bytes behind it, so the sets of threads it stands in are a million.
// The first meets them where the reading begins, the second behind a byte no match can begin with,
// so that they are met after a position has already been passed over. Both strings end in an `a`
// and twenty `b`s, which is the last place a match can begin whatever the drawn bytes before it
// hold, so each holds one match, running from where a match can first begin to the end.
//
// The third pattern's attempt runs to the end of a long run of letters wherever it begins, which is
// the reading the scanner cannot bound and the automaton does in one pass. The run holds no match,
// since it is met by no `z`, and the match is the one behind it.
_beyond_bounds_cases: Array (String, String, Array Groups);
_beyond_bounds_cases = [
    ("[ab]*a[ab]{20}", _draw_letters(2000) + "a" + _repeated("b", 20), [[(0, 2021)]]),
    ("[ab]*a[ab]{20}", "@" + _draw_letters(2000) + "a" + _repeated("b", 20), [[(1, 2022)]]),
    ("a[a-z]*z", _repeated("a", 2000) + "@abcz", [[(2001, 2005)]])
];

// Holds the scanner to the matches written out for the inputs that carry it past its bounds.
_test_beyond_bounds: IO ();
_test_beyond_bounds = (
    _beyond_bounds_cases.to_iter.fold_m((), |(pattern, target, matches), _|
        let nfa = RegExp::compile(pattern, "g").as_ok.@nfa;
        let bytes = target.get_bytes.pop_back;
        assert_eq(
            |_| "/" + pattern + "/ over " + bytes.@size.to_string + " bytes",
            nfa.search_all(bytes),
            matches
        )
    )
);

// The states the scanner holds are ordered by the threads they stand for, and taking a new state in
// keeps that order: every state standing at or after the place it takes moves along by one, and
// none is lost.
_test_ordered_insertion: IO ();
_test_ordered_insertion = (
    assert_eq(|_| "a state taken in at the front", DFA::_insert_at(0, 5, [10, 30, 50]), [5, 10, 30, 50]);;
    assert_eq(|_| "a state taken in between", DFA::_insert_at(1, 20, [10, 30, 50]), [10, 20, 30, 50]);;
    assert_eq(|_| "a state taken in at the end", DFA::_insert_at(3, 60, [10, 30, 50]), [10, 30, 50, 60])
);

// Runs the whole suite: the matching and replacing cases written out above, then the sections that
// hold the scanner to the automaton.
test: IO ();
test = (
    _match_cases.to_iter.fold_m((), |case, _|
        let name = _named(case.@pattern, case.@flags, case.@target);
        let regexp = RegExp::compile(case.@pattern, case.@flags).as_ok;
        let one = regexp.match_one(case.@target);
        let one = if one.is_err { [] } else { one.as_ok };
        assert_eq(|_| name + " match_one", one, case.@one);;
        assert_eq(|_| name + " match_all", regexp.match_all(case.@target), case.@all)
    );;
    _replace_cases.to_iter.fold_m((), |case, _|
        let name = _named(case.@pattern, case.@flags, case.@target);
        let regexp = RegExp::compile(case.@pattern, case.@flags).as_ok;
        assert_eq(
            |_| name + " replace_all",
            regexp.replace_all(case.@target, case.@replacement),
            case.@result
        )
    );;
    _test_byte_searches;;
    _test_against_threads;;
    _test_forced_sets;;
    _test_forced_shapes;;
    _test_forced_beginning;;
    _test_kept_scanner;;
    _test_beyond_bounds;;
    _test_ordered_insertion;;
    pure()
);
