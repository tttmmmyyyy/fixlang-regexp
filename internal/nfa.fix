// NFA (Nondeterministic Finite Automaton). This is internal module of `RegExp`.
//
// For details, see web pages below.
// - https://swtch.com/~rsc/regexp/regexp1.html
// - https://zenn.dev/canalun/articles/regexp_and_automaton
//
module RegExp.Internal.NFA;

import RegExp.Internal.Pattern::{
    _all_bytes, _bytes_of_class, _bytes_union, _no_bytes, forced_of, CharClass, ForcedRun, PAssertion, 
    Pattern, Forced::@sets, ForcedRun::{@back_class, @back_max, @bytes}, 
    PAssertion::{is_pa_begin, is_pa_end}, 
    Pattern::{
        _assign_group_number, as_passert, as_pclass, as_peither, as_pgroup, as_pquant, as_psequence, 
        is_passert, is_pclass, is_peither, is_pgroup, is_pquant, is_psequence, psequence, reverse
    }
};
import RegExp.Internal.StdBytes::{find_byte, find_bytes_by, find_bytes_within};
import RegExp.Internal.StringEx::{_unsafe_to_string, substring};
import Std::{
    loop, undefined, Array, Bool, I64, Option, String, U64, U8, 
    Array::{
        @, @size, append, empty, fill, from_map, get_last, mod, pop_back, push_back, set, sort_by, to_iter, 
        truncate
    }, 
    Functor::map, I64::{bit_and, bit_or, maximum, shift_right}, Indexable::ixchg, 
    Iterator::{check_any, fold, map, range}, 
    LessThan::{max, min}, LoopState::{break, continue}, 
    Option::{as_some, as_some_or, is_none, is_some, none, some}, 
    String::{@size, get_bytes}, ToI64::i64, ToString::to_string, ToU64::u64, ToU8::u8, 
    U64::{bit_and, bit_or, shift_right}
};

// Where a group was matched: the two stream positions `(begin, end)`. `-1` stands for a position
// that was never written.
type Group = (I64, I64);

// The groups a match captured, the whole match first. Group `n` of the pattern stands at index `n`.
type Groups = Array Group;

// Which special quantifier a node belongs to. `X{n}`, `X{n,}` and `X{n,m}` are the special
// quantifiers, and a thread counts the rounds it has taken through each of them, since how many it
// has taken decides where it may go and the node it stands at does not say. The `sa_quant_*`
// actions are where the counting happens.
type QuantID = I64;

// The automaton a pattern compiles to.
//
// A node is a place a thread may stand at, and the transitions out of it say where the thread may
// go next. A node may offer a thread more than one way on, so a search follows several threads at
// once.
//
// It is boxed because a scanner holds one and reads it back at every match it reports: boxed, that
// reading raises one reference count for the automaton, where unboxed it raises one for each array
// the automaton holds.
type NFA = box struct {
    _nodes: Array NFANode,           // every node, each named by its place here
    _initial_node: NodeID,           // the node a thread starts at
    _accepting_node: NodeID,         // the node a thread has matched at
    _group_count: I64,               // how many groups the pattern captures, the whole match
                                     // counted as one
    _quant_bounds: Array (I64, I64), // fewest and most rounds each special quant admits
    // The character classes the nodes are guarded by, as one bit per byte value, four words to a
    // class. Keeping them here rather than in the node leaves a node holding nothing but numbers,
    // so that walking the nodes costs no reference counting at all.
    _classes: Array U64,
    // The kind of each byte value. Two bytes are of one kind where every character class above
    // holds both or neither of them, so that they lead every thread the same way, and a table works
    // out what a byte does once for the bytes of its kind.
    _kind_of: Array I64,
    _kinds: Array (Array U8),        // the bytes of each kind
    // Sets of byte strings the pattern forces every text it matches to hold. Every match holds a
    // member of each of these sets, so a search may look for whichever set the text it is over
    // holds least often.
    _forced_sets: Array (Array ForcedRun),
    // The bytes every match begins with. Working them out means walking the automaton, and doing
    // it here leaves every scanner made from this automaton with nothing to walk.
    _prefix: Array U8,
    // What the automaton does between one byte and the next where it offers one way on, which is
    // how a match's groups are read without running the threads over it again.
    _one_way: OneWayTable,
    // The automaton of the pattern read from right to left, which a search walks back from where a
    // match ends to find where it begins. An automaton compiled from a reversed pattern holds
    // `none` here, and so does an automaton with no node.
    _reversed: Option NFA,
    // The scanner a search with this automaton starts from, holding the states a search meets first
    // worked out. Only `NFA::compile` gives an automaton one: the automaton the scanner walks holds
    // `none` here.
    _scanner: Option DFA
};

namespace NFA {
    // An automaton with no node and no group.
    empty: NFA;
    empty = NFA {
        _nodes: Array::empty(0),
        _initial_node: __INVALID_NODE_ID,
        _accepting_node: __INVALID_NODE_ID,
        _group_count: 0,
        _quant_bounds: Array::empty(0),
        _classes: Array::empty(0),
        _kind_of: Array::fill(256, 0),
        _kinds: [Array::from_map(256, |byte| byte.u8)],
        _forced_sets: Array::empty(0),
        _prefix: Array::empty(0),
        _one_way: OneWayTable::empty,
        _reversed: none(),
        _scanner: none()
    };

    // Adds a node that guards nothing and leads nowhere, and reports its id.
    new_node: NFA -> (NFA, NodeID);
    new_node = |nfa| (
        let id = NodeID { val: nfa.@_nodes.@size };
        let node = NFANode::empty;
        let node = node.set_id(id);
        let nfa = nfa.mod__nodes(push_back(node));
        (nfa, id)
    );

    // Stores a character class and returns where its four words begin.
    //
    // # Parameters
    // * `cls` - The class to store.
    // * `nfa` - The automaton to store it in.
    new_class: CharClass -> NFA -> (NFA, I64);
    new_class = |cls, nfa| (
        let base = nfa.@_classes.@size;
        let (bits, _) = _bytes_of_class(cls);
        (nfa.mod__classes(append(bits)), base)
    );

    // Whether a byte belongs to the class whose words begin at a position.
    //
    // # Parameters
    // * `base` - Where the class's words begin.
    // * `byte` - The byte to test.
    // * `nfa` - The automaton holding the classes.
    class_holds: I64 -> U8 -> NFA -> Bool;
    class_holds = |base, byte, nfa| (
        nfa.@_classes._holds_byte(base, byte)
    );

    // The node an id names.
    get_node: NodeID -> NFA -> NFANode;
    get_node = |id, nfa| (
        nfa.@_nodes.@(id.@val)
    );

    // Replaces the node an id names by what a function makes of it.
    mod_node: NodeID -> (NFANode -> NFANode) -> NFA -> NFA;
    mod_node = |id, f, nfa| (
        nfa.mod__nodes(|nodes| nodes.set(id.@val, f(nodes.@(id.@val))))
    );

    // Points every node a fragment leads out of at one node.
    //
    // # Parameters
    // * `frag` - The fragment to point onward.
    // * `out` - The node it is to lead to.
    // * `nfa` - The automaton the fragment was built in.
    set_frag_output: NFAFrag -> NodeID -> NFA -> NFA;
    set_frag_output = |frag, out, nfa| (
        (frag.@set_output)(out, nfa)
    );

    // Adds a special quantifier and reports its id.
    //
    // # Parameters
    // * `least` - The fewest rounds the quantifier admits.
    // * `most` - The most rounds it admits.
    // * `nfa` - The automaton to add the quantifier to.
    new_quant: I64 -> I64 -> NFA -> (NFA, QuantID);
    new_quant = |least, most, nfa| (
        let id = nfa.@_quant_bounds.@size;
        (nfa.mod__quant_bounds(push_back((least, most))), id)
    );

    // The rounds a thread standing at a special quantifier's loop has counted after one more
    // round, or `-1` when the quantifier admits no further round.
    //
    // A round past the most the quantifier admits leaves the thread nowhere to go: the quantifier's
    // end admits no such count, and the count is never brought down again, since coming back to the
    // quantifier's beginning means leaving through its end first.
    //
    // Counting past what the quantifier can still tell apart would give every round a state of its
    // own; holding the counter there keeps their number finite and admits the same paths, since
    // `most` being unbounded makes every count at or above `least` alike.
    //
    // # Parameters
    // * `qid` - The quantifier the thread stands in.
    // * `counted` - The rounds it has counted so far.
    // * `nfa` - The automaton the quantifier belongs to.
    quant_next_round: QuantID -> I64 -> NFA -> I64;
    quant_next_round = |qid, counted, nfa| (
        let (least, most) = nfa.@_quant_bounds.@(qid);
        let round = counted + 1;
        if most != I64::maximum && round > most { -1 };
        min(round, if most == I64::maximum { least } else { most })
    );

    // What a node's action lets a thread standing at it do: where it may step, the rounds it writes
    // there, and the group whose beginning or end it records. `next` is `-1` where the action lets
    // the thread nowhere, and `quant`, `opens` and `closes` are `-1` where the step writes and
    // records nothing.
    //
    // Every walk of the automaton asks this, and each writes the answer into threads of its own
    // shape, which is why the answer is numbers rather than a thread.
    //
    // # Parameters
    // * `at_begin` - Whether the position is the beginning of the input, where `^` holds.
    // * `at_end` - Whether it is the end of the input, where `$` holds.
    // * `counted` - The rounds the thread has counted for the quantifier the action reads.
    // * `node` - The node whose action to read.
    // * `nfa` - The automaton the node belongs to.
    action_step: Bool -> Bool -> I64 -> NFANode -> NFA -> ActionStep;
    action_step = |at_begin, at_end, counted, node, nfa| (
        let blocked = ActionStep { next: -1, quant: -1, round: 0, opens: -1, closes: -1 };
        let action = node.@action;
        // A node guarded by a character class leads nowhere until a byte is read, and one guarding
        // nothing leads nowhere through its action.
        if action.is_sa_char_match || action.is_sa_none { blocked };
        let step = blocked.set_next(node.@output_on_action.@val);
        if action.is_sa_assert {
            let assertion = action.as_sa_assert;
            let holds = (assertion.is_pa_begin && at_begin) || (assertion.is_pa_end && at_end);
            if holds { step } else { blocked }
        };
        if action.is_sa_group_begin { step.set_opens(action.as_sa_group_begin) };
        if action.is_sa_group_end { step.set_closes(action.as_sa_group_end) };
        if action.is_sa_quant_begin { step.set_quant(action.as_sa_quant_begin) };
        if action.is_sa_quant_loop {
            let qid = action.as_sa_quant_loop;
            let round = nfa.quant_next_round(qid, counted);
            if round < 0 { blocked };
            step.set_quant(qid).set_round(round)
        };
        let (qid, least, most) = action.as_sa_quant_end;
        if counted < least || most < counted { blocked };
        step
    );

    // The special quantifier whose rounds a node's action reads, or `-1` where it reads none. A
    // walk reads that many rounds off the thread and hands them to `action_step`.
    //
    // # Parameters
    // * `action` - The action to read.
    action_quant: NFANodeAction -> I64;
    action_quant = |action| (
        if action.is_sa_quant_loop { action.as_sa_quant_loop };
        if action.is_sa_quant_end {
            let (qid, _, _) = action.as_sa_quant_end;
            qid
        };
        -1
    );

    // Compiles a pattern to an automaton, together with what a search reads off it before it
    // begins: the byte strings every match holds, the bytes every match begins with, the ways on
    // that carry one thread, the automaton of the pattern read from right to left, and the scanner.
    compile: Pattern -> NFA;
    compile = |pattern| (
        let (nfa, pattern) = NFA::_nodes_of(pattern);
        let kind_of = _kinds_of_bytes(nfa.@_classes);
        let kind_count = kind_of.to_iter.fold(0, |kind, count| max(count, kind + 1));
        let kinds = range(0, 256).fold(Array::fill(kind_count, Array::empty(0)), |byte, kinds|
            kinds.mod(kind_of.@(byte), push_back(byte.u8))
        );
        let nfa = nfa.set__kind_of(kind_of).set__kinds(kinds);
        let nfa = nfa.set__forced_sets(forced_of(pattern).@sets);
        let nfa = nfa.set__prefix(DFA::forced_beginning(nfa));
        // Read from right to left, the pattern holds the same character classes, so its bytes are
        // of the same kinds.
        let (reversed, _) = NFA::_nodes_of(pattern.reverse);
        let reversed = reversed.set__kind_of(nfa.@_kind_of).set__kinds(nfa.@_kinds);
        let nfa = nfa.set__reversed(some(reversed));
        let nfa = nfa.set__one_way(_one_way_table(nfa));
        nfa.set__scanner(some $ DFA::_worked_out(nfa))
    );

    // The automaton a pattern compiles to, holding its nodes and classes and nothing a search reads
    // off them, together with the pattern with its groups numbered. The groups are numbered first,
    // so that a thread can write down what it captures by number, and an accepting node is put
    // after the fragment the pattern compiles to.
    //
    // # Parameters
    // * `pattern` - The pattern to compile.
    _nodes_of: Pattern -> (NFA, Pattern);
    _nodes_of = |pattern| (
        let (group_count, pattern) = pattern._assign_group_number(0);
        let nfa = NFA::empty.set__group_count(group_count);
        let (nfa, frag) = nfa.compile_pattern(pattern);
        let nfa = nfa.set__initial_node(frag.@input);
        let (nfa, accept_id) = nfa.new_node;
        let nfa = nfa.set__accepting_node(accept_id);
        (nfa.set_frag_output(frag, accept_id), pattern)
    );

}

// What a thread has to do, or what has to hold, before it may take a node's `output_on_action`.
type NFANodeAction = unbox union {
    sa_none: (),                            // nothing, so the action output is never taken
    sa_char_match: I64,                     // read a byte of a class: where the class's words begin
    sa_assert: PAssertion,                  // let a thread through where an assertion holds
    sa_group_begin: I64,                    // write down where a group begins: which group
    sa_group_end: I64,                      // write down where a group ends: which group
    sa_quant_begin: QuantID,                // begin counting a special quantifier's rounds
    sa_quant_loop: QuantID,                 // count one more round of a special quantifier
    sa_quant_end: (QuantID, I64, I64)       // leave a special quantifier: its id, then its bounds
};

// What a node's action lets a thread standing at it do. See `NFA::action_step`.
type ActionStep = unbox struct {
    next: I64,     // the node the thread steps to, or `-1`
    quant: I64,    // the special quantifier whose rounds the step writes, or `-1`
    round: I64,    // the rounds to write there
    opens: I64,    // the group whose beginning the step records, or `-1`
    closes: I64    // the group whose end it records, or `-1`
};

// A node of the automaton. It has one input, which is its own id, and three outputs: one a thread
// takes when the node's action lets it through, and two it takes without reading anything.
type NFANode = unbox struct {
    id: NodeID,                // this node's own id
    action: NFANodeAction,     // what a thread has to do to take `output_on_action`
    output_on_action: NodeID,  // where a thread goes when the action lets it through
    output: NodeID,            // where a thread goes without reading anything
    output2: NodeID            // a second such node, where the node offers two ways on
};

// A node's name: its place in the automaton's `_nodes`.
type NodeID = unbox struct {
    val: I64   // the place in `_nodes`, or `-1` for no node
};

namespace NFANode {
    // The id standing for no node.
    __INVALID_NODE_ID: NodeID;
    __INVALID_NODE_ID = NodeID { val: -1 };

    // A node that has no id, guards nothing and leads nowhere.
    empty: NFANode;
    empty = NFANode {
        id: __INVALID_NODE_ID,
        action: sa_none(),
        output_on_action: __INVALID_NODE_ID,
        output: __INVALID_NODE_ID,
        output2: __INVALID_NODE_ID
    };
}

// A stretch of the automaton, compiled from a stretch of the pattern. A thread enters it at one
// node and may leave it from several, so where it leads onward is held as a function that points
// every one of those nodes at the same place.
type NFAFrag = unbox struct {
    input: NodeID,                     // the node a thread enters the fragment at
    set_output: NodeID -> NFA -> NFA   // points every node the fragment leads out of at one node
};

namespace NFAFrag {

    // Compiles a pattern to a fragment.
    compile_pattern: Pattern -> NFA -> (NFA, NFAFrag);
    compile_pattern = |pat, nfa| (
        if pat.is_pclass {
            let cls = pat.as_pclass;
            let (nfa, base) = nfa.new_class(cls);
            let (nfa, frag) = nfa._compile_action(sa_char_match(base));
        (nfa, frag)
        };
        if pat.is_psequence {
            let patterns = pat.as_psequence;
            if patterns.@size == 0 {
                nfa._compile_null_sequence
            };
            if patterns.@size == 1 {
                nfa.compile_pattern(patterns.@(0))
            };
            let (nfa, frag1) = nfa.compile_pattern(
                psequence $ patterns.pop_back);
            let (nfa, frag2) = nfa.compile_pattern(
                patterns.get_last.as_some);
            nfa._compile_seq(frag1, frag2)
        };
        if pat.is_peither {
            let (pat1, pat2) = pat.as_peither;
            let (nfa, frag1) = nfa.compile_pattern(pat1);
            let (nfa, frag2) = nfa.compile_pattern(pat2);
            nfa._compile_either(frag1, frag2)
        };
        if pat.is_pquant {
            let (pat1, least, most) = pat.as_pquant;
            let (nfa, frag1) = nfa.compile_pattern(pat1);
            if (least == 0 && most == 1) {
                nfa._compile_zero_or_once(frag1)
            };
            if (least == 0 && most == I64::maximum) {
                nfa._compile_zero_or_more(frag1)
            };
            if (least == 1 && most == I64::maximum) {
                nfa._compile_one_or_more(frag1)
            };
            if (least <= most) {
                nfa._compile_special_quant(frag1, least, most)
            };
            undefined("invalid quantifier: (least,most)=" + (least, most).to_string)
        };
        if pat.is_pgroup {
            let (group, pat1) = pat.as_pgroup;
            let (nfa, frag0) = nfa._compile_action(sa_group_begin(group));
            let (nfa, frag1) = nfa.compile_pattern(pat1);
            let (nfa, frag2) = nfa._compile_action(sa_group_end(group));
            let (nfa, frag) = nfa._compile_seq(frag0, frag1);
            let (nfa, frag) = nfa._compile_seq(frag, frag2);
            (nfa, frag)
        };
        if pat.is_passert {
            nfa._compile_action(sa_assert(pat.as_passert))
        };
        undefined("invalid pattern:" + pat.to_string)
    );

    // Compiles an action to a fragment of one node, which a thread leaves by the action's output.
    _compile_action: NFANodeAction -> NFA -> (NFA, NFAFrag);
    _compile_action = |action, nfa| (
        let (nfa, id) = nfa.new_node;
        let nfa = nfa.mod_node(id, set_action(action));
        let frag = NFAFrag {
            input: id,
            set_output: |out, nfa| (
                nfa.mod_node(id, set_output_on_action(out))
            )
        };
        (nfa, frag)
    );

    // Compiles the empty sequence to a fragment of one node, which a thread passes straight
    // through.
    _compile_null_sequence: NFA -> (NFA, NFAFrag);
    _compile_null_sequence = |nfa| (
        let (nfa, id) = nfa.new_node;
        let frag = NFAFrag {
            input: id,
            set_output: |out, nfa| (
                nfa.mod_node(id, set_output(out))
            )
        };
        (nfa, frag)
    );

    // Compiles a sequence of two fragments (`e1 e2`) to a fragment.
    _compile_seq: NFAFrag -> NFAFrag -> NFA -> (NFA, NFAFrag);
    _compile_seq = |frag1, frag2, nfa| (
        let nfa = nfa.set_frag_output(frag1, frag2.@input);
        let frag = NFAFrag {
            input: frag1.@input,
            set_output: |out, nfa| (
                nfa.set_frag_output(frag2, out)
            )
        };
        (nfa, frag)
    );

    // Compiles an alternative of two fragments (`e1|e2`) to a fragment.
    _compile_either: NFAFrag -> NFAFrag -> NFA -> (NFA, NFAFrag);
    _compile_either = |frag1, frag2, nfa| (
        let (nfa, id) = nfa.new_node;
        let nfa = nfa.mod_node(id, set_output(frag1.@input));
        let nfa = nfa.mod_node(id, set_output2(frag2.@input));
        let frag = NFAFrag {
            input: id,
            set_output: |out, nfa| (
                nfa.set_frag_output(frag1, out)
                   .set_frag_output(frag2, out)
            )
        };
        (nfa, frag)

    );

    // Compiles `e?` to a fragment: a thread may take the fragment once, or pass it by.
    _compile_zero_or_once: NFAFrag -> NFA -> (NFA, NFAFrag);
    _compile_zero_or_once = |frag1, nfa| (
        let (nfa, id) = nfa.new_node;
        let nfa = nfa.mod_node(id, set_output(frag1.@input));
        let frag = NFAFrag {
            input: id,
            set_output: |out, nfa| (
                let nfa = nfa.set_frag_output(frag1, out);
                nfa.mod_node(id, set_output2(out))
            )
        };
        (nfa, frag)
    );

    // Creates the node a repeated fragment goes round: its plain output enters the fragment, and
    // the fragment's output comes back to it, so that a thread may take the fragment any number of
    // times. Returns the new node id.
    //
    // # Parameters
    // * `body` - The fragment to be repeated.
    // * `nfa` - The automaton to add the node to.
    _new_loop_node: NFAFrag -> NFA -> (NFA, NodeID);
    _new_loop_node = |body, nfa| (
        let (nfa, id) = nfa.new_node;
        let nfa = nfa.mod_node(id, set_output(body.@input));
        let nfa = nfa.set_frag_output(body, id);
        (nfa, id)
    );

    // Compiles `e*` to a fragment: a thread may take the fragment any number of times, none
    // included.
    _compile_zero_or_more: NFAFrag -> NFA -> (NFA, NFAFrag);
    _compile_zero_or_more = |frag1, nfa| (
        // A thread enters at the loop node, so it may leave without taking the fragment at all.
        let (nfa, id) = nfa._new_loop_node(frag1);
        let frag = NFAFrag {
            input: id,
            set_output: |out, nfa| (
                nfa.mod_node(id, set_output2(out))
            )
        };
        (nfa, frag)
    );

    // Compiles `e+` to a fragment: a thread takes the fragment once, then as many more times as it
    // will.
    _compile_one_or_more: NFAFrag -> NFA -> (NFA, NFAFrag);
    _compile_one_or_more = |frag1, nfa| (
        // A thread enters at the fragment, so it takes the fragment once before reaching the loop
        // node.
        let (nfa, id) = nfa._new_loop_node(frag1);
        let frag = NFAFrag {
            input: frag1.@input,
            set_output: |out, nfa| (
                nfa.mod_node(id, set_output2(out))
            )
        };
        (nfa, frag)
    );

    // Compiles `e{least,most}` to a fragment: a thread counts its rounds through the fragment, and
    // leaves only where the count stands between the two bounds.
    _compile_special_quant: NFAFrag -> I64 -> I64 -> NFA -> (NFA, NFAFrag);
    _compile_special_quant = |frag1, least, most, nfa| (
        let (nfa, qid) = nfa.new_quant(least, most);
        let (nfa, branch_id) = nfa.new_node;
        let (nfa, frag_begin) = nfa._compile_action(sa_quant_begin $ qid);
        let (nfa, frag_loop) = nfa._compile_action(sa_quant_loop $ qid);
        let (nfa, frag_end) = nfa._compile_action(sa_quant_end $ (qid, least, most));
        let nfa = nfa.set_frag_output(frag_begin, branch_id);
        let nfa = nfa.mod_node(branch_id, set_output(frag1.@input));
        let nfa = nfa.mod_node(branch_id, set_output2(frag_end.@input));
        let nfa = nfa.set_frag_output(frag1, frag_loop.@input);
        let nfa = nfa.set_frag_output(frag_loop, branch_id);
        let frag = NFAFrag {
            input: frag_begin.@input,
            set_output: |out, nfa| (
                nfa.set_frag_output(frag_end, out)
            )
        };
        (nfa, frag)
    );
}

// Gets specified group. If the group index is out of range, returns `(-1, -1)`.
//
// # Parameters
// * `group_idx` - The index of the group.
// * `groups` - The captured groups.
group_at: I64 -> Groups -> Group;
group_at = |group_idx, groups| (
    if group_idx < 0 || groups.@size <= group_idx {
        (-1, -1)
    };
    groups.@(group_idx)
);

// Whether a byte stands among a set of bytes held as one bit each in the four words beginning at a
// place.
//
// # Parameters
// * `base` - Where the four words begin.
// * `byte` - The byte to look for.
// * `words` - The words the set stands in.
_holds_byte: I64 -> U8 -> Array U64 -> Bool;
_holds_byte = |base, byte, words| (
    let index = byte.i64;
    words.@(base + index / 64).shift_right((index % 64).u64).bit_and(1_U64) == 1_U64
);

// The kind of each byte value: two bytes are of one kind where every class holds both or neither of
// them. The kinds are numbered from 0 in the order of the first byte of each.
//
// # Parameters
// * `classes` - The classes, four words to a class, one bit per byte value.
_kinds_of_bytes: Array U64 -> Array I64;
_kinds_of_bytes = |classes| (
    // Each class splits every kind in two, the bytes it holds and the bytes it does not. A byte's
    // kind and whether the class holds it say which half it goes to, and the halves are numbered
    // anew in the order they are met.
    range(0, classes.@size / 4).fold(Array::fill(256, 0), |class, kind_of|
        let (split, _, _) = range(0, 256).fold(
            (Array::empty(256), Array::fill(512, -1), 0), |byte, (split, numbers, count)|
            let held = classes._holds_byte(4 * class, byte.u8);
            let half = 2 * kind_of.@(byte) + (if held { 1 } else { 0 });
            let number = numbers.@(half);
            if number >= 0 { (split.push_back(number), numbers, count) };
            (split.push_back(count), numbers.set(half, count), count + 1)
        );
        split
    )
);

// The one byte a set of bytes holds, or `-1` where it holds any other number of them.
//
// A set holding one byte is what lets the search for the next position a match may begin at be
// handed to `memchr`, which reads many bytes at a time.
//
// # Parameters
// * `words` - The words the set stands in, one bit to a byte.
_lone_byte_of: Array U64 -> I64;
_lone_byte_of = |words| (
    // `-1` stands for no byte seen yet, `-2` for more than one seen.
    let found = range(0, 256).fold(-1, |byte, found|
        if !words._holds_byte(0, byte.u8) { found };
        if found == -1 { byte } else { -2 }
    );
    if found == -2 { -1 };
    found
);

// Whether a run of numbers stands among runs laid end to end, each as long as the one looked for:
// the rounds a thread has counted among those the threads at one node have, or a thread among the
// threads at one node.
//
// # Parameters
// * `run` - The numbers to look for, one or more of them.
// * `runs` - The runs to look among, one after another.
_run_among: Array I64 -> Array I64 -> Bool;
_run_among = |run, runs| (
    let width = run.@size;
    range(0, runs.@size / width).check_any(|k|
        range(0, width).fold(true, |j, same| same && runs.@(k * width + j) == run.@(j))
    )
);

// The threads an automaton is walked with, and what each of them has captured.
//
// A thread stands at a node, has captured a beginning and an end for each group, and has counted
// rounds for each special quantifier. All three are numbers, and the threads share three arrays of
// them, so that carrying a thread forward writes numbers and allocates nothing. Gathering what one
// thread holds into a value of its own would put an array behind every thread and have it copied
// once per node the thread reaches.
//
// Thread `t` stands at `nodes.@(t)`, has captured the `slot_width` numbers of `slots` beginning at
// `t * slot_width` - a beginning and an end to a group, the whole match first - and has counted the
// `count_width` numbers of `counts` beginning at `t * count_width`.
type Walk = box struct {
    slot_width: I64,     // how many numbers a thread's captures take: two to a group
    count_width: I64,    // how many numbers a thread's counts take: one per special quantifier
    nodes: Array I64,    // the node each thread stands at
    slots: Array I64,    // what every thread has captured, laid end to end
    counts: Array I64,   // what every thread has counted, laid end to end
    // The threads whose empty-string transitions are still to be followed, taken from the end.
    pending: Array I64,
    // Per node, the step at which a thread took it, so that nothing has to be cleared between
    // positions.
    at_step: Array I64,
    // Per node, the rounds counted by the threads that took it at that step, since two threads
    // standing at one node having counted differently do not have the same future.
    counts_at_step: Array (Array I64),
    // How many bytes the walk has read, which tells the marks left at one position from those left
    // at another.
    step: I64
};

namespace Walk {
    // A walk carrying no thread.
    //
    // # Parameters
    // * `nfa` - The automaton to walk.
    make: NFA -> Walk;
    make = |nfa| (
        let node_count = nfa.@_nodes.@size;
        let count_width = nfa.@_quant_bounds.@size;
        let slot_width = 2 * max(1, nfa.@_group_count);
        Walk {
            slot_width: slot_width,
            count_width: count_width,
            nodes: Array::empty(node_count),
            slots: Array::empty(node_count * slot_width),
            counts: Array::empty(node_count * count_width),
            pending: Array::empty(node_count),
            at_step: Array::fill(node_count, -1),
            counts_at_step: if count_width > 0 {
                Array::fill(node_count, Array::empty(0))
            } else {
                Array::empty(0)
            },
            step: 0
        }
    );

    // Reports whether a node had not been taken at this step, and marks it as taken.
    //
    // # Parameters
    // * `node` - The node to take.
    // * `walk` - The walk taking it.
    _take_node: I64 -> Walk -> (Bool, Walk);
    _take_node = |node, walk| (
        let step = walk.@step;
        if walk.@at_step.@(node) == step { (false, walk) };
        (true, walk.mod_at_step(set(node, step)))
    );

    // Reports whether a node had not been taken at this step by a thread having counted the same
    // rounds, and marks it as taken by one.
    //
    // # Parameters
    // * `node` - The node to take.
    // * `counts` - The rounds the thread taking it has counted.
    // * `walk` - The walk taking it.
    _take_counted: I64 -> Array I64 -> Walk -> (Bool, Walk);
    _take_counted = |node, counts, walk| (
        let step = walk.@step;
        if walk.@at_step.@(node) != step {
            let walk = walk.mod_at_step(set(node, step));
            (true, walk.mod_counts_at_step(set(node, counts)))
        };
        if _run_among(counts, walk.@counts_at_step.@(node)) { (false, walk) };
        (true, walk.mod_counts_at_step(mod(node, append(counts))))
    );

    // Adds a thread standing at a node, having captured and counted what a thread of this walk has,
    // with one round put where `qid` names, unless a thread standing at that node having counted
    // the same rounds is there already.
    //
    // Reports where the thread was put, or `-1` when it was not added. Two threads standing at one
    // node having counted the same rounds have the same future, so keeping the earlier of them,
    // which is the one that started earliest, loses no match and keeps the leftmost one.
    //
    // # Parameters
    // * `node` - The node the thread stands at.
    // * `source` - The thread it carries the captures and the counts of.
    // * `qid` - The quantifier whose rounds to put a number at, or `-1` to carry them all forward.
    // * `round` - The rounds to put there.
    // * `walk` - The walk to add it to.
    _offer_here: I64 -> I64 -> I64 -> I64 -> Walk -> (I64, Walk);
    _offer_here = |node, source, qid, round, walk| (
        if node < 0 { (-1, walk) };
        let count_width = walk.@count_width;
        let (fresh, walk) = if count_width == 0 {
            walk._take_node(node)
        } else {
            let counts = walk._counts_of(source, qid, round);
            walk._take_counted(node, counts)
        };
        if !fresh { (-1, walk) };
        let slot_width = walk.@slot_width;
        let placed = walk.@nodes.@size;
        let walk = walk.mod_nodes(push_back(node));
        let walk = walk.mod_slots(|slots|
            range(0, slot_width).fold(slots, |j, slots|
                let value = slots.@(source * slot_width + j);
                slots.push_back(value)
            )
        );
        let walk = walk.mod_counts(|counts|
            range(0, count_width).fold(counts, |j, counts|
                let value = if j == qid { round } else { counts.@(source * count_width + j) };
                counts.push_back(value)
            )
        );
        (placed, walk.mod_pending(push_back(placed)))
    );

    // The rounds a thread has counted, with one of them put where `qid` names.
    //
    // # Parameters
    // * `source` - The thread to read.
    // * `qid` - The quantifier whose rounds to put a number at, or `-1` to read them all.
    // * `round` - The rounds to put there.
    // * `walk` - The walk the thread belongs to.
    _counts_of: I64 -> I64 -> I64 -> Walk -> Array I64;
    _counts_of = |source, qid, round, walk| (
        let count_width = walk.@count_width;
        Array::from_map(count_width, |j|
            if j == qid { round } else { walk.@counts.@(source * count_width + j) }
        )
    );

    // Adds a thread standing at a node, having captured and counted what a thread standing at the
    // position before this one has, unless one is there already. Reports where it was put, or `-1`.
    //
    // # Parameters
    // * `node` - The node the thread stands at.
    // * `read_slots` - What the threads of the position before captured.
    // * `read_counts` - What they counted.
    // * `source` - Which of them the thread carries forward.
    // * `walk` - The walk to add it to.
    _offer_moved: I64 -> Array I64 -> Array I64 -> I64 -> Walk -> (I64, Walk);
    _offer_moved = |node, read_slots, read_counts, source, walk| (
        if node < 0 { (-1, walk) };
        let count_width = walk.@count_width;
        let (fresh, walk) = if count_width == 0 {
            walk._take_node(node)
        } else {
            let counts = Array::from_map(count_width, |j| read_counts.@(source * count_width + j));
            walk._take_counted(node, counts)
        };
        if !fresh { (-1, walk) };
        let slot_width = walk.@slot_width;
        let placed = walk.@nodes.@size;
        let walk = walk.mod_nodes(push_back(node));
        let walk = walk.mod_slots(|slots|
            range(0, slot_width).fold(slots, |j, slots|
                slots.push_back(read_slots.@(source * slot_width + j))
            )
        );
        let walk = walk.mod_counts(|counts|
            range(0, count_width).fold(counts, |j, counts|
                counts.push_back(read_counts.@(source * count_width + j))
            )
        );
        (placed, walk.mod_pending(push_back(placed)))
    );

    // Adds the thread a match begins with: one standing at the initial node, having captured
    // nothing and counted nothing.
    //
    // # Parameters
    // * `initial` - The node the automaton begins at.
    // * `walk` - The walk to add it to.
    _offer_start: I64 -> Walk -> Walk;
    _offer_start = |initial, walk| (
        let count_width = walk.@count_width;
        let (fresh, walk) = if count_width == 0 {
            walk._take_node(initial)
        } else {
            walk._take_counted(initial, Array::fill(count_width, 0))
        };
        if !fresh { walk };
        let slot_width = walk.@slot_width;
        let placed = walk.@nodes.@size;
        let walk = walk.mod_nodes(push_back(initial));
        let walk = walk.mod_slots(|slots|
            range(0, slot_width).fold(slots, |_, slots| slots.push_back(-1))
        );
        let walk = walk.mod_counts(|counts|
            range(0, count_width).fold(counts, |_, counts| counts.push_back(0))
        );
        walk.mod_pending(push_back(placed))
    );

    // Records where a group began, on a thread just added.
    //
    // # Parameters
    // * `group` - The group, the whole match counted as group zero.
    // * `at` - Where it began.
    // * `thread` - The thread to record it on.
    // * `walk` - The walk the thread belongs to.
    _open_group: I64 -> I64 -> I64 -> Walk -> Walk;
    _open_group = |group, at, thread, walk| (
        let base = thread * walk.@slot_width + 2 * group;
        walk.mod_slots(|slots| slots.set(base, at).set(base + 1, -1))
    );

    // Records where a group ended, on a thread just added.
    //
    // # Parameters
    // * `group` - The group, the whole match counted as group zero.
    // * `at` - Where it ended.
    // * `thread` - The thread to record it on.
    // * `walk` - The walk the thread belongs to.
    _close_group: I64 -> I64 -> I64 -> Walk -> Walk;
    _close_group = |group, at, thread, walk| (
        let base = thread * walk.@slot_width + 2 * group;
        walk.mod_slots(set(base + 1, at))
    );

    // Applies the action a node guards to a thread standing at it, adding the thread it leads to
    // when the action lets it through. A node guarded by a character class leads nowhere until a
    // byte is read.
    //
    // # Parameters
    // * `nfa` - The automaton being walked.
    // * `at` - The position the thread stands at.
    // * `length` - How many bytes there are, where `$` holds.
    // * `node` - The node whose action to apply.
    // * `thread` - The thread standing at it.
    // * `walk` - The walk it belongs to.
    _act: NFA -> I64 -> I64 -> NFANode -> I64 -> Walk -> Walk;
    _act = |nfa, at, length, node, thread, walk| (
        let qid = action_quant(node.@action);
        let counted = if qid < 0 { 0 } else { walk.@counts.@(thread * walk.@count_width + qid) };
        let step = nfa.action_step(at == 0, at == length, counted, node);
        if step.@next < 0 { walk };
        let (placed, walk) = walk._offer_here(step.@next, thread, step.@quant, step.@round);
        if placed < 0 { walk };
        if step.@opens >= 0 { walk._open_group(step.@opens, at, placed) };
        if step.@closes >= 0 { walk._close_group(step.@closes, at, placed) };
        walk
    );

    // Follows the empty-string transitions of every thread waiting on them.
    //
    // # Parameters
    // * `nfa` - The automaton being walked.
    // * `at` - The position the threads stand at.
    // * `length` - How many bytes there are, where `$` holds.
    // * `walk` - The walk to follow them in.
    _close: NFA -> I64 -> I64 -> Walk -> Walk;
    _close = |nfa, at, length, walk| (
        loop(walk, |walk|
            let waiting = walk.@pending.@size;
            if waiting == 0 { break $ walk };
            let thread = walk.@pending.@(waiting - 1);
            let walk = walk.mod_pending(pop_back);
            let node = nfa.get_node(NodeID { val: walk.@nodes.@(thread) });
            // The action is followed first, so that the two plain outputs are taken off the waiting
            // threads before it is, and `output` before `output2`, which is the order the automaton
            // prefers its alternatives in.
            let walk = walk._act(nfa, at, length, node, thread);
            let (_, walk) = walk._offer_here(node.@output2.@val, thread, -1, 0);
            let (_, walk) = walk._offer_here(node.@output.@val, thread, -1, 0);
            continue $ walk
        )
    );

    // Reads a byte and carries every thread whose node admits it to the position after it.
    //
    // # Parameters
    // * `nfa` - The automaton being walked.
    // * `at` - The position after the byte, which the threads move to.
    // * `length` - How many bytes there are, where `$` holds.
    // * `byte` - The byte read.
    // * `read_nodes` - Where the threads that read it stand.
    // * `read_slots` - What they captured.
    // * `read_counts` - What they counted.
    // * `walk` - The walk they move into, holding no thread yet.
    _step: NFA -> I64 -> I64 -> U8 -> Array I64 -> Array I64 -> Array I64 -> Walk -> Walk;
    _step = |nfa, at, length, byte, read_nodes, read_slots, read_counts, walk| (
        range(0, read_nodes.@size).fold(walk, |thread, walk|
            let node = nfa.get_node(NodeID { val: read_nodes.@(thread) });
            let action = node.@action;
            if !action.is_sa_char_match { walk };
            if !nfa.class_holds(action.as_sa_char_match, byte) { walk };
            let (_, walk) = walk._offer_moved(node.@output_on_action.@val, read_slots, read_counts, thread);
            walk._close(nfa, at, length)
        )
    );

    // The groups a thread has captured.
    //
    // # Parameters
    // * `thread` - The thread to read.
    // * `walk` - The walk it belongs to.
    _captured: I64 -> Walk -> Groups;
    _captured = |thread, walk| (
        let slot_width = walk.@slot_width;
        _groups_of(thread * slot_width, slot_width, walk.@slots)
    );

    // The better of the match found so far and any match the threads standing here have reached:
    // the one beginning earlier, or the one reaching further where they begin together.
    //
    // # Parameters
    // * `accepting` - The node a thread reaches when it has matched.
    // * `best` - The match found so far.
    // * `walk` - The walk whose threads to weigh.
    _better: I64 -> Option Groups -> Walk -> Option Groups;
    _better = |accepting, best, walk| (
        if walk.@at_step.@(accepting) != walk.@step { best };
        let slot_width = walk.@slot_width;
        range(0, walk.@nodes.@size).fold(best, |thread, best|
            if walk.@nodes.@(thread) != accepting { best };
            let begin = walk.@slots.@(thread * slot_width);
            let end = walk.@slots.@(thread * slot_width + 1);
            if best.is_none { some $ walk._captured(thread) };
            let (best_begin, best_end) = best.as_some.@(0);
            if begin < best_begin || (begin == best_begin && end > best_end) {
                some $ walk._captured(thread)
            };
            best
        )
    );
}

// The ways on from a node that carry one thread: what the automaton does between one byte and
// the next, worked out once for the automaton rather than once for every byte of every match.
type OneWayTable = box struct {
    // Five numbers to a way: where its class's words begin, the node the byte leads to, which
    // assertions the way stands on (one for the beginning of the input, two for its end), and
    // the stretch of `writes` it performs.
    ways: Array I64,
    // Node `n` offers the ways from `bounds.@(n)` to `bounds.@(n + 1)`, counted in ways. It
    // holds nothing where the automaton is walked by its threads.
    bounds: Array I64,
    // Three numbers to a node: which assertions the way from it to the accepting node stands
    // on, and the stretch of `writes` that way performs. The assertions read `-1` where no
    // empty-string way leads from the node to the accepting node.
    accepts: Array I64,
    // What a way writes down: a slot doubled, and one more where the slot takes `-1` rather
    // than the position the walk stands at.
    writes: Array I64,
    // Per node, whether its empty-string transitions reach some node two ways. One thread
    // stands for the automaton only where they reach each node one way.
    twice: Array Bool
};

namespace OneWayTable {
    // A table offering no way, which sends every walk to the threads.
    empty: OneWayTable;
    empty = OneWayTable {
        ways: Array::empty(0),
        bounds: Array::empty(0),
        accepts: Array::empty(0),
        writes: Array::empty(0),
        twice: Array::empty(0)
    };

    // Whether the assertions a way stands on hold where the walk stands.
    //
    // # Parameters
    // * `flags` - The assertions the way stands on.
    // * `at_begin` - Whether the walk stands where the input begins.
    // * `at_end` - Whether it stands where the input ends.
    _flags_hold: I64 -> Bool -> Bool -> Bool;
    _flags_hold = |flags, at_begin, at_end| (
        (Std::I64::bit_and(1, flags) == 0 || at_begin) && (Std::I64::bit_and(2, flags) == 0 || at_end)
    );

    // The one way on from a node that a byte takes, or `-1` where the byte takes none,
    // together with whether the node offered a second.
    //
    // The table's fields are fields of a boxed value, so reading one raises and lowers a reference
    // count. The walk reads them once and hands them here, rather than once for every byte.
    //
    // # Parameters
    // * `bounds` - Where each node's ways stand.
    // * `classes` - The character classes the ways are guarded by.
    // * `node` - The node the walk stands at.
    // * `byte` - The byte to read.
    // * `at_begin` - Whether the walk stands where the input begins.
    // * `at_end` - Whether it stands where the input ends.
    // * `ways` - The ways to read.
    _way_for: Array I64 -> Array U64 -> I64 -> U8 -> Bool -> Bool -> Array I64 -> (I64, Bool);
    _way_for = |bounds, classes, node, byte, at_begin, at_end, ways| (
        let to = bounds.@(node + 1);
        loop((bounds.@(node), -1), |(i, found)|
            if i >= to { break $ (found, false) };
            if !_flags_hold(ways.@(5 * i + 2), at_begin, at_end) { continue $ (i + 1, found) };
            if !classes._holds_byte(ways.@(5 * i), byte) { continue $ (i + 1, found) };
            if found >= 0 { break $ (found, true) };
            continue $ (i + 1, i)
        )
    );

    // The slots a stretch of writes leaves behind.
    //
    // # Parameters
    // * `from` - Where the stretch begins.
    // * `to` - One past where it ends.
    // * `at` - The position the walk stands at, which a write records.
    // * `slots` - The slots to write in.
    // * `writes` - What the ways write down.
    _written: I64 -> I64 -> I64 -> Array I64 -> Array I64 -> Array I64;
    _written = |from, to, at, slots, writes| (
        loop((slots, from), |(slots, i)|
            if i >= to { break $ slots };
            let write = writes.@(i);
            continue $ (slots.set(write / 2, if write % 2 == 0 { at } else { -1 }), i + 1)
        )
    );
}

// What the ways on from one node come to while they are worked out.
type WayBuild = box struct {
    ways: Array I64,     // the ways worked out so far, for this node and the ones before it
    writes: Array I64,   // what they write down, laid end to end
    accept: Array I64,   // the three numbers this node's way to the accepting node takes
    seen: Array I64,     // per node, the node whose ways were being worked out when it was passed
    twice: Bool          // whether a node was passed twice while this node's ways were worked out
};

namespace NFA {
    // Runs the automaton over the bytes and reports the match beginning earliest, taking the one
    // reaching furthest among those that begin at the same place.
    //
    // A search that does not know where the match begins starts a thread at every position until a
    // match is found; after that a later start could not be the leftmost one, so none is added and
    // the threads still running are followed only to see how far the match reaches. A search that
    // knows where the match begins and how far it reaches - one reading the groups off a match the
    // scanner has already found - starts one thread and stops where the match ends.
    //
    // Every byte between where the walk begins and where it ends is read once whatever the pattern,
    // which is what the scanner cannot promise, so this is where a search the scanner gives up on
    // is finished.
    //
    // # Parameters
    // * `bytes` - The bytes to read.
    // * `length` - How many of the bytes the text holds. Any after them stand beyond its end.
    // * `from` - The position to begin at.
    // * `stop` - The position to stop at.
    // * `anchored` - Whether the match has to begin where the walk does.
    // * `nfa` - The automaton to run.
    _walk_threads: Array U8 -> I64 -> I64 -> I64 -> Bool -> NFA -> Option Groups;
    _walk_threads = |bytes, length, from, stop, anchored, nfa| (
        let node_count = nfa.@_nodes.@size;
        let initial = nfa.@_initial_node.@val;
        let accepting = nfa.@_accepting_node.@val;
        let walk = Walk::make(nfa);
        let (spare_nodes, spare_slots, spare_counts) = (
            Array::empty(node_count),
            Array::empty(node_count * walk.@slot_width),
            Array::empty(node_count * walk.@count_width)
        );
        let (best, _, _, _, _, _) = loop(
            (none(), walk, spare_nodes, spare_slots, spare_counts, from),
            |(best, walk, spare_nodes, spare_slots, spare_counts, at)|
            let starts_here = if anchored { at == from } else { best.is_none };
            let walk = if starts_here { walk._offer_start(initial) } else { walk };
            let walk = walk._close(nfa, at, length);
            let best = walk._better(accepting, best);
            let done = at >= stop || (walk.@nodes.@size == 0 && (anchored || best.is_some));
            if done { break $ (best, walk, spare_nodes, spare_slots, spare_counts, at) };
            // The threads move into the buffers the position before them left behind, and leave
            // theirs to be moved into next.
            let byte = bytes.@(at);
            let read_nodes = walk.@nodes;
            let walk = walk.set_nodes(spare_nodes.truncate(0));
            let read_slots = walk.@slots;
            let walk = walk.set_slots(spare_slots.truncate(0));
            let read_counts = walk.@counts;
            let walk = walk.set_counts(spare_counts.truncate(0));
            let walk = walk.mod_step(|step| step + 1);
            let walk = walk._step(nfa, at + 1, length, byte, read_nodes, read_slots, read_counts);
            continue $ (best, walk, read_nodes, read_slots, read_counts, at + 1)
        );
        best
    );

    // The leftmost match beginning at or after a position, taking the longest of those that begin
    // at the same place.
    //
    // # Parameters
    // * `bytes` - The bytes to read.
    // * `length` - How many of the bytes the text holds. Any after them stand beyond its end.
    // * `from` - The position at or after which the match has to begin.
    // * `nfa` - The automaton to run.
    _search_threads: Array U8 -> I64 -> I64 -> NFA -> Option Groups;
    _search_threads = |bytes, length, from, nfa| (
        if from > length { none() };
        _walk_threads(bytes, length, from, length, false, nfa)
    );

    // Follows the empty-string transitions from a node, gathering the ways on that the node the
    // walk began at offers.
    //
    // # Parameters
    // * `start` - The node whose ways are being worked out, which marks the nodes passed.
    // * `node` - The node to walk from.
    // * `flags` - The assertions the way to `node` stands on.
    // * `path` - What the way to `node` writes down.
    // * `build` - What the ways come to so far.
    // * `nfa` - The automaton to walk.
    _gather_ways: I64 -> I64 -> I64 -> Array I64 -> WayBuild -> NFA -> WayBuild;
    _gather_ways = |start, node, flags, path, build, nfa| (
        if node < 0 { build };
        if build.@seen.@(node) == start { build.set_twice(true) };
        let build = build.mod_seen(set(node, start));
        let build = if node == nfa.@_accepting_node.@val {
            let from = build.@writes.@size;
            build.mod_writes(append(path)).set_accept([flags, from, from + path.@size])
        } else { build };
        let node_val = nfa.get_node(NodeID { val: node });
        let action = node_val.@action;
        let build = if action.is_sa_char_match {
            // A way is where the byte carries the walk on, so a class leading to no node offers
            // none.
            if node_val.@output_on_action.@val < 0 { build };
            let from = build.@writes.@size;
            let build = build.mod_writes(append(path));
            build.mod_ways(|ways| ways
                .push_back(action.as_sa_char_match)
                .push_back(node_val.@output_on_action.@val)
                .push_back(flags)
                .push_back(from)
                .push_back(from + path.@size)
            )
        } else {
            let next = node_val.@output_on_action.@val;
            if action.is_sa_assert {
                let bit = if action.as_sa_assert.is_pa_begin { 1 } else { 2 };
                nfa._gather_ways(start, next, Std::I64::bit_or(bit, flags), path, build)
            };
            if action.is_sa_group_begin {
                let group = action.as_sa_group_begin;
                nfa._gather_ways(
                    start, next, flags, path.push_back(4 * group).push_back(4 * group + 3), build
                )
            };
            if action.is_sa_group_end {
                let group = action.as_sa_group_end;
                nfa._gather_ways(start, next, flags, path.push_back(4 * group + 2), build)
            };
            build
        };
        let build = nfa._gather_ways(start, node_val.@output2.@val, flags, path, build);
        nfa._gather_ways(start, node_val.@output.@val, flags, path, build)
    );

    // The ways on the automaton offers from each of its nodes.
    //
    // A pattern that counts rounds is walked by its threads, which carry the counts one way on does
    // not, so the table such a pattern gets offers no way.
    //
    // # Parameters
    // * `nfa` - The automaton to read.
    _one_way_table: NFA -> OneWayTable;
    _one_way_table = |nfa| (
        if nfa.@_quant_bounds.@size > 0 { OneWayTable::empty };
        let node_count = nfa.@_nodes.@size;
        let build = WayBuild {
            ways: Array::empty(node_count * 5),
            writes: Array::empty(node_count * 4),
            accept: [-1, 0, 0],
            seen: Array::fill(node_count, -1),
            twice: false
        };
        let (build, bounds, accepts, twice) = range(0, node_count).fold(
            (
                build,
                Array::empty(node_count + 1).push_back(0),
                Array::empty(node_count * 3),
                Array::empty(node_count)
            ),
            |node, (build, bounds, accepts, twice)|
            let build = build.set_accept([-1, 0, 0]).set_twice(false);
            let build = nfa._gather_ways(node, node, 0, Array::empty(4), build);
            (
                build,
                bounds.push_back(build.@ways.@size / 5),
                accepts.append(build.@accept),
                twice.push_back(build.@twice)
            )
        );
        OneWayTable {
            ways: build.@ways,
            bounds: bounds,
            accepts: accepts,
            writes: build.@writes,
            twice: twice
        }
    );

    // The groups a match captured, read by carrying one thread over the stretch the match covers.
    //
    // Where the automaton offers a second way on, one thread stands for less than the automaton
    // does, and the walk reports `none` rather than the groups of a reading it cannot know is the
    // one to report.
    //
    // # Parameters
    // * `bytes` - The bytes the match was found in.
    // * `length` - How many of the bytes the text holds. Any after them stand beyond its end.
    // * `begin` - Where the match begins.
    // * `end` - Where it ends.
    // * `nfa` - The automaton the match was found with.
    _one_way_groups: Array U8 -> I64 -> I64 -> I64 -> NFA -> Option Groups;
    _one_way_groups = |bytes, length, begin, end, nfa| (
        let table = nfa.@_one_way;
        if table.@bounds.@size == 0 { none() };
        let slot_width = 2 * max(1, nfa.@_group_count);
        // Each of these is a field of a boxed value, so reading one raises and lowers a reference
        // count. They are read once here and stand for every byte the walk reads.
        let (ways, bounds, accepts) = (table.@ways, table.@bounds, table.@accepts);
        let (writes, twice, classes) = (table.@writes, table.@twice, nfa.@_classes);
        loop((nfa.@_initial_node.@val, Array::fill(slot_width, -1), begin), |(node, slots, at)|
            if twice.@(node) { break $ none() };
            let (at_begin, at_end) = (at == 0, at == length);
            if at >= end {
                let flags = accepts.@(3 * node);
                if flags < 0 || !_flags_hold(flags, at_begin, at_end) { break $ none() };
                let slots = writes._written(
                    accepts.@(3 * node + 1), accepts.@(3 * node + 2), at, slots
                );
                break $ some $ _groups_of(0, slot_width, slots)
            };
            let (way, forked) = ways._way_for(
                bounds, classes, node, bytes.@(at), at_begin, at_end
            );
            if forked || way < 0 { break $ none() };
            let slots = writes._written(ways.@(5 * way + 3), ways.@(5 * way + 4), at, slots);
            continue $ (ways.@(5 * way + 1), slots, at + 1)
        )
    );

    // The groups a stretch of slots holds, as pairs.
    //
    // # Parameters
    // * `base` - Where the stretch begins.
    // * `slot_width` - How many slots it holds, two to a group.
    // * `slots` - The slots to read.
    _groups_of: I64 -> I64 -> Array I64 -> Groups;
    _groups_of = |base, slot_width, slots| (
        Array::from_map(slot_width / 2, |k| (slots.@(base + 2 * k), slots.@(base + 2 * k + 1)))
    );

    // The groups a match captured, read off by walking the automaton over the stretch it covers.
    //
    // # Parameters
    // * `bytes` - The bytes the match was found in.
    // * `length` - How many of the bytes the text holds. Any after them stand beyond its end.
    // * `begin` - Where the match begins.
    // * `end` - Where it ends.
    // * `nfa` - The automaton the match was found with.
    _capture_groups: Array U8 -> I64 -> I64 -> I64 -> NFA -> Option Groups;
    _capture_groups = |bytes, length, begin, end, nfa| (
        let one_way = nfa._one_way_groups(bytes, length, begin, end);
        if one_way.is_some { one_way };
        _walk_threads(bytes, length, begin, end, true, nfa)
    );
}

// How many states a table may take before the search is given back to the automaton. Each state
// costs a row of 256 transitions, which bounds the table a search builds.
__DFA_MAX_STATES: I64;
__DFA_MAX_STATES = 1024;

// The states an automaton is walked through, worked out as the input calls for them and kept, so
// that reading a byte in a state met before costs one lookup.
//
// A state is the threads the automaton stands at, each ranked by where it began: the threads of
// rank 0 began earliest. A thread is `width` numbers: the node it stands at, then the rounds it has
// counted for each special quantifier. Two threads that stand alike have the same future, so a
// state holds a thread once, at the earliest rank that reached it, and a rank left holding nothing
// is dropped.
//
// A state is seeking while no thread of it has reached the accepting node: reading a byte in it
// starts a new rank at the position after the byte, so that one reading of the text tries every
// position a match may begin at. Once a rank reaches the accepting node, a match beginning later
// could not be the leftmost one, so the ranks after it are dropped and no rank is started again.
// The walk then goes on only to see how far the match reaches, and whether an earlier rank reaches
// a match of its own.
//
// A state's key is what tells two states apart: `1` where it is seeking and `0` where it is not,
// then its threads, each as its rank followed by its `width` numbers, ordered by rank and, within a
// rank, by the numbers.
type StateTable = box struct {
    _nfa: NFA,                  // the automaton the states are worked out from
    _width: I64,                // numbers to a thread: the node, then one count per special
                                // quantifier
    _keys: Array I64,           // the key of every state, laid end to end
    _bounds: Array I64,         // state `i` has the key from `_bounds.@(i)` to `_bounds.@(i + 1)`
    _ordered_states: Array I64, // the states, ordered by their keys
    _transitions: Array I64,    // `state * 256 + byte` -> how a walk takes the byte; see `_entry`
    _accepts: Array Bool,       // whether the state holds the accepting node
    _accepts_at_end: Array I64, // the earliest rank of the state that reaches the accepting node
                                // where the input ends: `-1` where none does, `-2` until asked
    _starting: Array I64,       // the threads a rank begins with away from either end of the input
    _interior: I64,             // the state a search begins in away from the beginning of the input
    _fresh: I64,                // `_interior` where it is seeking, which is where no rank began
                                // before the position the walk stands at; `-1` where it is not
    _full: Bool                 // whether the states have outgrown what the table may take
};

namespace StateTable {
    // The state that holds no thread. It is taken first, so that it stands as `0`.
    __DEAD_STATE: I64;
    __DEAD_STATE = 0;

    // The number standing in the table for a transition not worked out yet. Read the way `_entry`
    // says a number below `0` is read, it says a walk stops there.
    __UNTAKEN: I64;
    __UNTAKEN = -1;

    // What a table holds in place of its transitions while a walk holds them apart from it. It is
    // one value for the program, so that holding them apart allocates nothing.
    __HELD_APART: Array I64;
    __HELD_APART = Array::empty(0);

    // The row a state is added with: one transition per byte value, each of them untaken. One row
    // serves every table, so it is written once for the program.
    __UNTAKEN_ROW: Array I64;
    __UNTAKEN_ROW = Array::fill(256, __UNTAKEN);

    // A table that has walked nothing yet, holding the state with no thread and no other.
    //
    // # Parameters
    // * `nfa` - The automaton to walk.
    make: NFA -> StateTable;
    make = |nfa| (
        let (_, table) = StateTable::_holding_nothing(nfa)._intern([0]);
        table.set__starting(table._closure(false, false, table._initial_thread))
    );

    // A table that has given the search back to the automaton before it took a state, so that a
    // search with it walks the automaton's threads from the beginning.
    //
    // # Parameters
    // * `nfa` - The automaton.
    given_up: NFA -> StateTable;
    given_up = |nfa| StateTable::_holding_nothing(nfa).set__full(true);

    // A table holding no state.
    //
    // # Parameters
    // * `nfa` - The automaton to walk.
    _holding_nothing: NFA -> StateTable;
    _holding_nothing = |nfa| (
        StateTable {
            _nfa: nfa,
            _width: 1 + nfa.@_quant_bounds.@size,
            _keys: Array::empty(64),
            _bounds: [0],
            _ordered_states: Array::empty(16),
            _transitions: Array::empty(256 * 2),
            _accepts: Array::empty(16),
            _accepts_at_end: Array::empty(16),
            _starting: Array::empty(0),
            _interior: -1,
            _fresh: -1,
            _full: false
        }
    );

    // A table that has walked nothing yet, holding the state with no thread and the state a search
    // begins in away from the beginning of the input.
    //
    // # Parameters
    // * `nfa` - The automaton to walk.
    make_seeking: NFA -> StateTable;
    make_seeking = |nfa| (
        let (interior, table) = StateTable::make(nfa)._start(true, false, false);
        let table = table.set__interior(interior);
        if table._seeking(interior) { table.set__fresh(interior) } else { table }
    );

    // The table with every transition worked out from the states offered and the states they lead
    // to, taken in the order they are reached, until it holds a number of states.
    //
    // # Parameters
    // * `starts` - The states to begin from.
    // * `most` - How many states the table may hold before it stops.
    // * `table` - The table.
    _worked_out_from: Array I64 -> I64 -> StateTable -> StateTable;
    _worked_out_from = |starts, most, table| (
        let kinds = table.@_nfa.@_kinds;
        let (table, _, _) = loop((table, starts, 0), |(table, queue, taken)|
            let held = table.@_bounds.@size - 1;
            if taken >= queue.@size || held >= most { break $ (table, queue, taken) };
            let state = queue.@(taken);
            let (table, queue) = kinds.to_iter.fold((table, queue), |alike, (table, queue)|
                let byte = alike.@(0);
                if table.@_transitions.@(state * 256 + byte.i64) != __UNTAKEN { (table, queue) };
                let count = table.@_bounds.@size;
                let (next, table) = table._next(state, byte);
                if next < 0 || table.@_bounds.@size == count { (table, queue) };
                (table, queue.push_back(next))
            );
            continue $ (table, queue, taken + 1)
        );
        table
    );

    // The thread the automaton begins with: the initial node, having counted nothing.
    //
    // # Parameters
    // * `table` - The table, for the automaton and the width of a thread.
    _initial_thread: StateTable -> Array I64;
    _initial_thread = |table| (
        Array::from_map(table.@_width, |j| if j == 0 { table.@_nfa.@_initial_node.@val } else { 0 })
    );

    // The state a walk begins in at a position.
    //
    // # Parameters
    // * `seeking` - Whether the walk starts a new rank at every position, which a walk looking for
    //   where a match begins does and a walk from where one begins does not.
    // * `at_begin` - Whether the position is the beginning of the input, where `^` holds.
    // * `at_end` - Whether it is the end of the input, where `$` holds.
    // * `table` - The table.
    _start: Bool -> Bool -> Bool -> StateTable -> (I64, StateTable);
    _start = |seeking, at_begin, at_end, table| (
        let threads = if at_begin || at_end {
            table._closure(at_begin, at_end, table._initial_thread)
        } else {
            table.@_starting
        };
        let (key, _) = table._key_of(seeking, [threads]);
        table._intern(key)
    );

    // Whether a state starts a new rank at every position.
    //
    // # Parameters
    // * `state` - The state to read.
    // * `table` - The table.
    _seeking: I64 -> StateTable -> Bool;
    _seeking = |state, table| table.@_keys.@(table.@_bounds.@(state)) == 1;

    // The key of a state holding ranks of threads, together with the earliest rank holding the
    // accepting node, or `-1` where none holds it. The ranks after that one are dropped, and the
    // state is seeking where it is asked to be and no rank holds that node.
    //
    // # Parameters
    // * `seeking` - Whether the state is to start a new rank at every position.
    // * `ranks` - The threads of each rank, the earliest first, each rank holding some thread and
    //   holding its threads in order.
    // * `table` - The table, for the automaton and the width of a thread.
    _key_of: Bool -> Array (Array I64) -> StateTable -> (Array I64, I64);
    _key_of = |seeking, ranks, table| (
        let width = table.@_width;
        let accepting = table.@_nfa.@_accepting_node.@val;
        let accepted = loop(0, |r|
            if r == ranks.@size { break $ -1 };
            if _holds_node(accepting, width, ranks.@(r)) { break $ r };
            continue $ r + 1
        );
        let kept = if accepted < 0 { ranks.@size } else { accepted + 1 };
        let key = Array::empty(64).push_back(if seeking && accepted < 0 { 1 } else { 0 });
        let key = range(0, kept).fold(key, |r, key|
            let threads = ranks.@(r);
            range(0, threads.@size / width).fold(key, |k, key|
                range(0, width).fold(key.push_back(r), |j, key|
                    key.push_back(threads.@(k * width + j))
                )
            )
        );
        (key, accepted)
    );

    // The threads of each rank a state holds, the earliest first.
    //
    // # Parameters
    // * `state` - The state to read.
    // * `table` - The table.
    _ranks_of: I64 -> StateTable -> Array (Array I64);
    _ranks_of = |state, table| (
        let width = table.@_width;
        let keys = table.@_keys;
        let begin = table.@_bounds.@(state) + 1;
        let end = table.@_bounds.@(state + 1);
        range(0, (end - begin) / (width + 1)).fold(Array::empty(4), |k, ranks|
            let base = begin + k * (width + 1);
            let rank = keys.@(base);
            let ranks = if rank < ranks.@size { ranks } else { ranks.push_back(Array::empty(width)) };
            ranks.mod(rank, |threads|
                range(1, width + 1).fold(threads, |j, threads| threads.push_back(keys.@(base + j)))
            )
        )
    );

    // Whether a node stands among the threads of a state.
    //
    // # Parameters
    // * `node` - The node to look for.
    // * `state` - The state to look in.
    // * `table` - The table.
    _state_holds_node: I64 -> I64 -> StateTable -> Bool;
    _state_holds_node = |node, state, table| (
        let stride = table.@_width + 1;
        let begin = table.@_bounds.@(state) + 1;
        let end = table.@_bounds.@(state + 1);
        let keys = table.@_keys;
        range(0, (end - begin) / stride).check_any(|k| keys.@(begin + k * stride + 1) == node)
    );

    // The state a key stands for, taking it as a new state when it is one.
    //
    // Reports `-1` when the states have outgrown what the table may take; the search is given back
    // to the automaton from there.
    //
    // # Parameters
    // * `key` - The key of the state.
    // * `table` - The table.
    _intern: Array I64 -> StateTable -> (I64, StateTable);
    _intern = |key, table| (
        let (existing, place) = table._locate(key);
        if existing >= 0 { (existing, table) };
        let id = table.@_bounds.@size - 1;
        if id >= __DFA_MAX_STATES { (-1, table.set__full(true)) };
        let table = table
            .mod__bounds(|bounds| bounds.push_back(bounds.get_last.as_some + key.@size))
            .mod__keys(append(key))
            .mod__transitions(append(__UNTAKEN_ROW))
            .mod__accepts_at_end(push_back(-2))
            .mod__ordered_states(_insert_at(place, id));
        let accepts = table._state_holds_node(table.@_nfa.@_accepting_node.@val, id);
        (id, table.mod__accepts(push_back(accepts)))
    );

    // Puts a state where it belongs among the states ordered by their keys.
    //
    // # Parameters
    // * `place` - Where it belongs.
    // * `state` - The state to put there.
    // * `ordered` - The states, ordered.
    _insert_at: I64 -> I64 -> Array I64 -> Array I64;
    _insert_at = |place, state, ordered| (
        let ordered = ordered.push_back(state);
        loop((ordered.@size - 1, ordered), |(i, ordered)|
            if i == place { break $ ordered.set(place, state) };
            let earlier = ordered.@(i - 1);
            continue $ (i - 1, ordered.set(i, earlier))
        )
    );

    // Where a key stands among the states: the state having it, or `-1` and the place it would take
    // among the states ordered by their keys.
    //
    // # Parameters
    // * `wanted` - The key to look for.
    // * `table` - The table.
    _locate: Array I64 -> StateTable -> (I64, I64);
    _locate = |wanted, table| (
        loop((0, table.@_ordered_states.@size), |(low, high)|
            if low == high { break $ (-1, low) };
            let middle = (low + high) / 2;
            let state = table.@_ordered_states.@(middle);
            let order = table._compare(state, wanted);
            if order == 0 { break $ (state, middle) };
            if order < 0 { continue $ (middle + 1, high) };
            continue $ (low, middle)
        )
    );

    // How a state's key stands against the key offered, taken number by number: a negative number
    // when the state comes first, zero when the two are the same, and a positive number when the
    // offered key comes first.
    //
    // # Parameters
    // * `state` - The state whose key to weigh.
    // * `wanted` - The key to weigh it against.
    // * `table` - The table.
    _compare: I64 -> Array I64 -> StateTable -> I64;
    _compare = |state, wanted, table| (
        let begin = table.@_bounds.@(state);
        let held_size = table.@_bounds.@(state + 1) - begin;
        let offered_size = wanted.@size;
        loop(0, |i|
            if i == held_size || i == offered_size { break $ held_size - offered_size };
            let difference = table.@_keys.@(begin + i) - wanted.@(i);
            if difference != 0 { break $ difference };
            continue $ i + 1
        )
    );

    // The state reached from a state by reading a byte, worked out and kept where the table does
    // not hold it yet, for that byte and every byte of its kind. Reports `-1` when the states have
    // outgrown what the table may take.
    //
    // # Parameters
    // * `state` - The state the threads stand in.
    // * `byte` - The byte they read.
    // * `table` - The table.
    _next: I64 -> U8 -> StateTable -> (I64, StateTable);
    _next = |state, byte, table| (
        let (ranks, first_lives) = table._after(state, byte);
        let (key, accepted) = table._key_of(table._seeking(state), ranks);
        let (next, table) = table._intern(key);
        if next < 0 { (-1, table) };
        let entry = table._entry(state, next, first_lives && accepted <= 0);
        let nfa = table.@_nfa;
        let row = state * 256;
        let table = table.mod__transitions(|transitions|
            nfa.@_kinds.@(nfa.@_kind_of.@(byte.i64)).to_iter.fold(transitions, |alike, transitions|
                transitions.set(row + alike.i64, entry)
            )
        );
        (next, table)
    );

    // The ranks of the state reached from a state by reading a byte, the earliest first, before the
    // ranks after the first one holding the accepting node are dropped, together with whether rank
    // 0 of the state lives on as rank 0 of them.
    //
    // Each rank's threads that admit the byte are carried over it and followed through the
    // empty-string transitions. A thread an earlier rank reached already is left out of a later
    // one: the earlier rank's threads reach everything it would, and began earlier.
    //
    // # Parameters
    // * `state` - The state the threads stand in.
    // * `byte` - The byte they read.
    // * `table` - The table.
    _after: I64 -> U8 -> StateTable -> (Array (Array I64), Bool);
    _after = |state, byte, table| (
        if table.@_width == 1 { table._after_nodes(state, byte) };
        let carried = table._ranks_of(state).map(|threads|
            table._closure(false, false, table._advance(threads, byte))
        );
        let first_lives = carried.@size > 0 && carried.@(0).@size > 0;
        let seeking = table._seeking(state);
        let carried = if seeking { carried.push_back(table.@_starting) } else { carried };
        (table._without_repeats(carried), first_lives)
    );

    // What `_after` does for a pattern with no special quantifier, where a thread is a node and
    // nothing besides. One mark per node tells which nodes an earlier rank reached, so following a
    // later rank's empty-string transitions stops wherever an earlier rank's did, and every rank is
    // worked out in one pass over the automaton.
    //
    // # Parameters
    // * `state` - The state the threads stand in.
    // * `byte` - The byte they read.
    // * `table` - The table.
    _after_nodes: I64 -> U8 -> StateTable -> (Array (Array I64), Bool);
    _after_nodes = |state, byte, table| (
        let nfa = table.@_nfa;
        let seeds = table._ranks_of(state).map(|nodes| table._advance(nodes, byte));
        let first_lives = seeds.@size > 0;
        let seeds = if table._seeking(state) { seeds.push_back(table.@_starting) } else { seeds };
        let (ranks, _, first_lives) = range(0, seeds.@size).fold(
            (Array::empty(seeds.@size), Array::fill(nfa.@_nodes.@size, false), first_lives),
            |r, (ranks, marks, first_lives)|
            let (reached, marks) = _reach_unmarked(nfa, false, false, seeds.@(r), marks);
            if reached.@size == 0 { (ranks, marks, first_lives && r > 0) };
            (ranks.push_back(reached.sort_by(|(left, right)| left < right)), marks, first_lives)
        );
        (ranks, first_lives)
    );

    // The ranks left once every thread an earlier rank holds is taken out of a later one, a rank
    // left holding nothing dropped.
    //
    // # Parameters
    // * `ranks` - The threads of each rank, the earliest first.
    // * `table` - The table, for the automaton and the width of a thread.
    _without_repeats: Array (Array I64) -> StateTable -> Array (Array I64);
    _without_repeats = |ranks, table| (
        let width = table.@_width;
        let node_count = table.@_nfa.@_nodes.@size;
        let (kept, _) = ranks.to_iter.fold(
            (Array::empty(ranks.@size), Array::fill(node_count, Array::empty(0))),
            |threads, (kept, held)|
            let (unheld, held) = _unheld(width, threads, held);
            (if unheld.@size == 0 { kept } else { kept.push_back(unheld) }, held)
        );
        kept
    );

    // The threads that admit a byte, carried to the nodes reading it leads to.
    //
    // # Parameters
    // * `threads` - The threads, laid end to end.
    // * `byte` - The byte they read.
    // * `table` - The table, for the automaton and the width of a thread.
    _advance: Array I64 -> U8 -> StateTable -> Array I64;
    _advance = |threads, byte, table| (
        let nfa = table.@_nfa;
        let width = table.@_width;
        range(0, threads.@size / width).fold(Array::empty(threads.@size), |k, seeds|
            let base = k * width;
            let node = nfa.get_node(NodeID { val: threads.@(base) });
            let action = node.@action;
            if !action.is_sa_char_match { seeds };
            if !nfa.class_holds(action.as_sa_char_match, byte) { seeds };
            let seeds = seeds.push_back(node.@output_on_action.@val);
            range(1, width).fold(seeds, |j, seeds| seeds.push_back(threads.@(base + j)))
        )
    );

    // How a walk takes a transition from one state into another.
    //
    // Most transitions a walk takes say nothing but where they lead, and such a transition stands
    // in the table as the row of the state it leads into: the state times 256. Any other transition
    // stands as a number below `-1`: `-2` less the row times eight, less one where the state it
    // leads into holds the accepting node, less two where a walk stops at the transition, and less
    // four where it leaves the fresh state, so that rank 0 of the state it leads into began at the
    // byte it reads. So the one test a walk makes on a byte that says nothing more is whether the
    // number is negative.
    //
    // A walk stops where the transition leads into the state holding no thread, which ends it, and
    // where it leaves the walk unable to read where a match begins off where rank 0 began: where
    // rank 0 dies, unless the transition leads into the fresh state, where a new rank 0 begins, or
    // where a later rank reaches the accepting node.
    //
    // # Parameters
    // * `state` - The state the transition leads from.
    // * `next` - The state the transition leads into.
    // * `keeps_begin` - Whether rank 0 lives on, and is the rank holding the accepting node where
    //   any is.
    // * `table` - The table.
    _entry: I64 -> I64 -> Bool -> StateTable -> I64;
    _entry = |state, next, keeps_begin, table| (
        let fresh = table.@_fresh;
        let accepts = table.@_accepts.@(next);
        let stops = next == __DEAD_STATE || (!keeps_begin && next != fresh);
        let leaves_fresh = state == fresh && next != fresh;
        if !accepts && !stops && !leaves_fresh { 256 * next };
        let flags = (if accepts { 1 } else { 0 }) + (if stops { 2 } else { 0 })
            + (if leaves_fresh { 4 } else { 0 });
        -2 - (2048 * next + flags)
    );

    // Every thread the automaton reaches from the threads offered without reading a byte, ordered
    // by the node the thread stands at.
    //
    // # Parameters
    // * `at_begin` - Whether the position is the beginning of the input, where `^` holds.
    // * `at_end` - Whether it is the end of the input, where `$` holds.
    // * `seeds` - The threads to start from, laid end to end.
    // * `table` - The table.
    _closure: Bool -> Bool -> Array I64 -> StateTable -> Array I64;
    _closure = |at_begin, at_end, seeds, table| (
        if table.@_width == 1 { _closure_nodes(at_begin, at_end, seeds, table) };
        let nfa = table.@_nfa;
        let width = table.@_width;
        let node_count = nfa.@_nodes.@size;
        let reached = range(0, seeds.@size / width).fold(
            (Array::fill(node_count, Array::empty(0)), Array::empty(node_count * width)),
            |k, reached| _offer_thread(width, _thread_at(k * width, width, seeds), reached)
        );
        let (taken, _) = loop(reached, |(taken, pending)|
            if pending.@size == 0 { break $ (taken, pending) };
            let base = pending.@size - width;
            let thread = _thread_at(base, width, pending);
            let pending = pending.truncate(base);
            let node = nfa.get_node(NodeID { val: thread.@(0) });
            let reached = _follow_action(nfa, at_begin, at_end, width, node, thread, (taken, pending));
            let reached = _offer_thread(width, thread.set(0, node.@output2.@val), reached);
            continue $ _offer_thread(width, thread.set(0, node.@output.@val), reached)
        );
        _gather_threads(width, taken)
    );

    // Every node the automaton reaches from the nodes offered without reading a byte, in the order
    // the nodes are numbered.
    //
    // This is what `_closure` does for a pattern with no special quantifier, where a thread is a
    // node and nothing besides, so that one mark per node tells which threads were reached.
    //
    // # Parameters
    // * `at_begin` - Whether the position is the beginning of the input, where `^` holds.
    // * `at_end` - Whether it is the end of the input, where `$` holds.
    // * `seeds` - The nodes to start from.
    // * `table` - The table.
    _closure_nodes: Bool -> Bool -> Array I64 -> StateTable -> Array I64;
    _closure_nodes = |at_begin, at_end, seeds, table| (
        let nfa = table.@_nfa;
        let marks = Array::fill(nfa.@_nodes.@size, false);
        let (reached, _) = _reach_unmarked(nfa, at_begin, at_end, seeds, marks);
        reached.sort_by(|(left, right)| left < right)
    );

    // The earliest rank of a state that reaches the accepting node where the input ends, where `$`
    // holds, or `-1` where none does. The answer is worked out on the first ask and kept.
    //
    // # Parameters
    // * `state` - The state to weigh.
    // * `table` - The table.
    _accepts_at_end: I64 -> StateTable -> (I64, StateTable);
    _accepts_at_end = |state, table| (
        let known = table.@_accepts_at_end.@(state);
        if known >= -1 { (known, table) };
        let width = table.@_width;
        let accepting = table.@_nfa.@_accepting_node.@val;
        let ranks = table._ranks_of(state);
        let rank = loop(0, |r|
            if r == ranks.@size { break $ -1 };
            if _holds_node(accepting, width, table._closure(false, true, ranks.@(r))) { break $ r };
            continue $ r + 1
        );
        (rank, table.mod__accepts_at_end(set(state, rank)))
    );

    // The bytes a match may begin with, one bit each: those the nodes of a state admit. A state that
    // accepts stands for a match that reads nothing, which every position admits, so there every
    // bit is set.
    //
    // # Parameters
    // * `state` - The state a match begins in.
    // * `table` - The table.
    _first_bytes_of: I64 -> StateTable -> Array U64;
    _first_bytes_of = |state, table| (
        if table.@_accepts.@(state) { _all_bytes };
        let nfa = table.@_nfa;
        table._ranks_of(state).to_iter.fold(_no_bytes, |threads, first_bytes|
            let width = table.@_width;
            range(0, threads.@size / width).fold(first_bytes, |k, first_bytes|
                let node = nfa.get_node(NodeID { val: threads.@(k * width) });
                let action = node.@action;
                if !action.is_sa_char_match { first_bytes };
                let base = action.as_sa_char_match;
                range(0, 4).fold(first_bytes, |w, first_bytes|
                    first_bytes.mod(w, bit_or(nfa.@_classes.@(base + w)))
                )
            )
        )
    );

    // How many bytes of a forced beginning a walk works out. A longer one is rarer in the text and
    // so rules out more positions, and the reading that looks for it costs the same either way, so
    // what bounds this is the states the walk interns rather than the searching.
    __MAX_PREFIX: I64;
    __MAX_PREFIX = 32;

    // The bytes every match begins with, taken as far as they are forced.
    //
    // A state whose matches may begin with one byte alone forces that byte; the state it leads to
    // forces the next. A state a match can end at forces nothing after it, and there are two ways
    // to end: the state holds the accepting node, where `_first_bytes_of` answers with every byte
    // and the walk stops on its own, or it reaches that node where the input ends, which `$` is
    // matched by and which the state's own threads do not show.
    //
    // # Parameters
    // * `table` - The table to walk, from the state a match begins in.
    _forced_prefix: StateTable -> (Array U8, StateTable);
    _forced_prefix = |table| (
        let (start, table) = table._start(false, false, false);
        loop((Array::empty(__MAX_PREFIX), start, table), |(prefix, state, table)|
            if prefix.@size == __MAX_PREFIX { break $ (prefix, table) };
            let (ends_here, table) = table._accepts_at_end(state);
            if ends_here >= 0 { break $ (prefix, table) };
            let byte = _lone_byte_of(table._first_bytes_of(state));
            if byte < 0 { break $ (prefix, table) };
            let (next, table) = table._next(state, byte.u8);
            if table.@_full || next < 0 { break $ (prefix, table) };
            continue $ (prefix.push_back(byte.u8), next, table)
        )
    );
}

// The threads of a run not held yet, in the order they stand in, together with what is held once
// they are.
//
// # Parameters
// * `width` - How many numbers a thread takes.
// * `threads` - The threads, laid end to end.
// * `held` - Per node, the threads standing there already, laid end to end.
_unheld: I64 -> Array I64 -> Array (Array I64) -> (Array I64, Array (Array I64));
_unheld = |width, threads, held| (
    range(0, threads.@size / width).fold((Array::empty(threads.@size), held), |k, (unheld, held)|
        let thread = _thread_at(k * width, width, threads);
        let node = thread.@(0);
        if _run_among(thread, held.@(node)) { (unheld, held) };
        (unheld.append(thread), held.mod(node, append(thread)))
    )
);

// Whether a node stands among threads laid end to end.
//
// # Parameters
// * `node` - The node to look for.
// * `width` - How many numbers a thread takes.
// * `threads` - The threads to look through.
_holds_node: I64 -> I64 -> Array I64 -> Bool;
_holds_node = |node, width, threads| (
    range(0, threads.@size / width).check_any(|k| threads.@(k * width) == node)
);

// Every node the automaton reaches from the nodes offered without reading a byte and without
// passing a marked node, in the order they are reached, together with the marks with those nodes
// marked.
//
// # Parameters
// * `nfa` - The automaton.
// * `at_begin` - Whether the position is the beginning of the input, where `^` holds.
// * `at_end` - Whether it is the end of the input, where `$` holds.
// * `seeds` - The nodes to start from.
// * `marks` - Per node, whether it is marked.
_reach_unmarked: NFA -> Bool -> Bool -> Array I64 -> Array Bool -> (Array I64, Array Bool);
_reach_unmarked = |nfa, at_begin, at_end, seeds, marks| (
    // Every node is put among those reached once, when it is marked, and its empty-string
    // transitions are followed in the order the nodes were put there.
    let (marks, reached) = seeds.to_iter.fold((marks, Array::empty(seeds.@size)), |node, reached|
        _offer_node(node, reached)
    );
    loop((0, marks, reached), |(followed, marks, reached)|
        if followed == reached.@size { break $ (reached, marks) };
        let node = nfa.get_node(NodeID { val: reached.@(followed) });
        let next = _follow_node_action(nfa, at_begin, at_end, node, (marks, reached));
        let next = _offer_node(node.@output2.@val, next);
        let (marks, reached) = _offer_node(node.@output.@val, next);
        continue $ (followed + 1, marks, reached)
    )
);

// Adds a node to those reached unless it is there already.
//
// # Parameters
// * `node` - The node to add.
// * `reached` - The nodes reached so far, and those whose empty-string transitions are still to
//   be followed.
_offer_node: I64 -> (Array Bool, Array I64) -> (Array Bool, Array I64);
_offer_node = |node, (marks, pending)| (
    if node < 0 { (marks, pending) };
    if marks.@(node) { (marks, pending) };
    (marks.set(node, true), pending.push_back(node))
);

// Applies the action a node guards, adding the node it leads to when the action lets it
// through. A node guarded by a character class leads nowhere until a byte is read, and a
// pattern with no special quantifier guards nothing else that can hold a thread back.
//
// # Parameters
// * `nfa` - The automaton the node belongs to.
// * `at_begin` - Whether the position is the beginning of the input, where `^` holds.
// * `at_end` - Whether it is the end of the input, where `$` holds.
// * `node` - The node whose action to apply.
// * `reached` - The nodes reached so far.
_follow_node_action: NFA -> Bool -> Bool -> NFANode -> (Array Bool, Array I64) -> (Array Bool, Array I64);
_follow_node_action = |nfa, at_begin, at_end, node, reached| (
    // A pattern with no special quantifier has no node that counts, so the action reads and
    // writes no rounds.
    let step = nfa.action_step(at_begin, at_end, 0, node);
    if step.@next < 0 { reached };
    _offer_node(step.@next, reached)
);

// The thread that begins at a place among threads laid end to end.
//
// # Parameters
// * `base` - Where the thread begins.
// * `width` - How many numbers it takes.
// * `threads` - The threads it stands among.
_thread_at: I64 -> I64 -> Array I64 -> Array I64;
_thread_at = |base, width, threads| Array::from_map(width, |j| threads.@(base + j));

// How two runs of numbers laid end to end stand against each other, taken number by number: a
// negative number when the run at `first` comes first, zero when the two are the same, and a
// positive number when the run at `second` comes first.
//
// # Parameters
// * `first` - Where one run begins.
// * `second` - Where the other begins.
// * `width` - How many numbers a run takes.
// * `runs` - The numbers the two runs stand in.
_run_order: I64 -> I64 -> I64 -> Array I64 -> I64;
_run_order = |first, second, width, runs| (
    range(0, width).fold(0, |j, order|
        if order != 0 { order };
        runs.@(first + j) - runs.@(second + j)
    )
);

// Adds a thread to those reached, unless a thread standing at the same node having counted the
// same rounds is there already. Two such threads have the same future, so keeping one loses
// nothing.
//
// # Parameters
// * `width` - How many numbers a thread takes.
// * `thread` - The thread to add.
// * `reached` - The threads reached at each node, and those whose empty-string transitions are
//   still to be followed.
_offer_thread: I64 -> Array I64 -> (Array (Array I64), Array I64) -> (Array (Array I64), Array I64);
_offer_thread = |width, thread, (taken, pending)| (
    let node = thread.@(0);
    if node < 0 { (taken, pending) };
    let counts = _thread_counts(width, thread);
    if _run_among(counts, taken.@(node)) { (taken, pending) };
    (taken.mod(node, append(counts)), pending.append(thread))
);

// The rounds a thread has counted. Two threads reached at one node are told apart by these.
//
// # Parameters
// * `width` - How many numbers a thread takes.
// * `thread` - The thread to read.
_thread_counts: I64 -> Array I64 -> Array I64;
_thread_counts = |width, thread| (
    Array::from_map(width - 1, |j| thread.@(1 + j))
);

// The threads reached at each node, laid end to end in the order the nodes are numbered and,
// at one node, in the order of the rounds they have counted. Two walks that reach the same
// threads write them the same way, which is what makes them one state.
//
// # Parameters
// * `width` - How many numbers a thread takes.
// * `taken` - The counts of the threads reached at each node.
_gather_threads: I64 -> Array (Array I64) -> Array I64;
_gather_threads = |width, taken| (
    let stride = width - 1;
    range(0, taken.@size).fold(Array::empty(taken.@size * width), |node, threads|
        let held = _sorted_counts(stride, taken.@(node));
        range(0, held.@size / stride).fold(threads, |k, threads|
            let threads = threads.push_back(node);
            range(0, stride).fold(threads, |j, threads|
                threads.push_back(held.@(k * stride + j))
            )
        )
    )
);

// The counts of the threads reached at one node, put in order.
//
// # Parameters
// * `stride` - How many numbers a thread's counts take.
// * `held` - The counts, one thread after another.
_sorted_counts: I64 -> Array I64 -> Array I64;
_sorted_counts = |stride, held| (
    let count = held.@size / stride;
    if count <= 1 { held };
    range(1, count).fold(held, |k, held|
        loop((k, held), |(k, held)|
            if k == 0 { break $ held };
            let order = held._run_order((k - 1) * stride, k * stride, stride);
            if order <= 0 { break $ held };
            let held = range(0, stride).fold(held, |j, held|
                let earlier = held.@((k - 1) * stride + j);
                held.set((k - 1) * stride + j, held.@(k * stride + j)).set(k * stride + j, earlier)
            );
            continue $ (k - 1, held)
        )
    )
);

// Applies the action a node guards, adding the thread it leads to when the action lets it
// through. A node guarded by a character class leads nowhere until a byte is read.
//
// # Parameters
// * `nfa` - The automaton the node belongs to.
// * `at_begin` - Whether the position is the beginning of the input, where `^` holds.
// * `at_end` - Whether it is the end of the input, where `$` holds.
// * `width` - How many numbers a thread takes.
// * `node` - The node whose action to apply.
// * `thread` - The thread standing at that node.
// * `reached` - The threads reached so far.
_follow_action: NFA -> Bool -> Bool -> I64 -> NFANode -> Array I64 -> (Array (Array I64), Array I64) -> (Array (Array I64), Array I64);
_follow_action = |nfa, at_begin, at_end, width, node, thread, reached| (
    let qid = action_quant(node.@action);
    let counted = if qid < 0 { 0 } else { thread.@(1 + qid) };
    let step = nfa.action_step(at_begin, at_end, counted, node);
    if step.@next < 0 { reached };
    let next = thread.set(0, step.@next);
    let next = if step.@quant < 0 { next } else { next.set(1 + step.@quant, step.@round) };
    _offer_thread(width, next, reached)
);

// Walks a table forward from a position, taking the transitions it goes on through without
// stopping, and reports where it stopped, the row of the state it stopped in, how far the longest
// match seen so far reaches, and where rank 0 began. It stops where the input ends, or before a
// byte whose transition it does not go on through: one not worked out yet, one
// `StateTable::_entry` says it stops at, or, where it is skipping, one into the fresh state.
//
// A transition leaving the fresh state reads the byte rank 0 begins at. In the fresh state the walk
// reads on with `_fresh_until` for as long as the bytes leave it there.
//
// # Parameters
// * `bytes` - The bytes to read.
// * `length` - How many of the bytes the text holds. Any after them stand beyond its end.
// * `transitions` - The transitions of the table.
// * `fresh_row` - The row of the fresh state, or `-1` where the table has none.
// * `skipping` - Whether the walk stops before entering the fresh state, so that the search can
//   pass over the positions no match begins at.
// * `at` - The position to read from.
// * `row` - The row of the state the walk stands in: the state times 256.
// * `best` - How far the longest match seen so far reaches, or `-1`.
// * `begin` - Where rank 0 began, or `-1` where the walk cannot tell.
_walk_forward: Array U8 -> I64 -> Array I64 -> I64 -> Bool -> I64 -> I64 -> I64 -> I64 -> (I64, I64, I64, I64);
_walk_forward = |bytes, length, transitions, fresh_row, skipping, at, row, best, begin| (
    loop((at, row, best, begin), |(at, row, best, begin)|
        let at = if row != fresh_row { at } else {
            _fresh_until(bytes, length, transitions, fresh_row, at)
        };
        if at >= length { break $ (at, row, best, begin) };
        let entry = transitions.@(row + bytes.@(at).i64);
        if entry >= 0 {
            if skipping && entry == fresh_row { break $ (at, row, best, begin) };
            continue $ (at + 1, entry, best, begin)
        };
        let taken = -2 - entry;
        if taken.bit_and(2) != 0 { break $ (at, row, best, begin) };
        let begin = if taken.bit_and(4) != 0 { at } else { begin };
        let best = if taken.bit_and(1) != 0 { at + 1 } else { best };
        continue $ (at + 1, taken.shift_right(3), best, begin)
    )
);

// Where the bytes from a position on first lead the walk out of the fresh state, or the end of the
// text where they never do.
//
// Each byte read in the fresh state leads back into it or elsewhere, so the row read is the fresh
// state's whatever the bytes before were, and the reading of one byte waits on nothing read
// before it. In any other state each lookup waits on the one before it for the row.
//
// # Parameters
// * `bytes` - The bytes to read.
// * `length` - How many of the bytes the text holds. Any after them stand beyond its end.
// * `transitions` - The transitions of the table.
// * `fresh_row` - The row of the fresh state.
// * `at` - The position to read from.
_fresh_until: Array U8 -> I64 -> Array I64 -> I64 -> I64 -> I64;
_fresh_until = |bytes, length, transitions, fresh_row, at| (
    loop(at, |at|
        if at >= length { break $ at };
        if transitions.@(fresh_row + bytes.@(at).i64) != fresh_row { break $ at };
        continue $ at + 1
    )
);

// Walks a table back from a position, reading the byte before it each time, and reports where it
// stopped, the row of the state it stopped in, and the earliest position a match was seen to
// reach back to. It stops at `floor`, or behind a byte whose transition it does not go on through.
//
// # Parameters
// * `bytes` - The bytes to read.
// * `transitions` - The transitions of the table.
// * `floor` - The position to stop at.
// * `at` - The position to read back from.
// * `row` - The row of the state the walk stands in: the state times 256.
// * `best` - The earliest position a match was seen to reach back to, or `-1`.
_walk_backward: Array U8 -> Array I64 -> I64 -> I64 -> I64 -> I64 -> (I64, I64, I64);
_walk_backward = |bytes, transitions, floor, at, row, best| (
    loop((at, row, best), |(at, row, best)|
        if at <= floor { break $ (at, row, best) };
        let entry = transitions.@(row + bytes.@(at - 1).i64);
        if entry >= 0 { continue $ (at - 1, entry, best) };
        let taken = -2 - entry;
        if taken.bit_and(2) != 0 { break $ (at, row, best) };
        let best = if taken.bit_and(1) != 0 { at - 1 } else { best };
        continue $ (at - 1, taken.shift_right(3), best)
    )
);

// What a search looks for to pass over the positions no match begins at.
//
// It is held apart from the tables the search walks so that the search can read it while it
// changes them.
type Prefilter = box struct {
    _first_bytes: Array U64,           // the bytes a match may begin with, one bit each
    _first_byte: I64,                  // the one byte a match may begin with, or `-1` where a match
                                       // may begin with several bytes or with none
    _prefix: Array U8,                 // the bytes every match begins with, empty where the first
                                       // byte a match may begin with is not forced
    _prefix_size: I64,                 // how many bytes `_prefix` holds, read where the search
                                       // chooses how to look so that the choice costs no reference
                                       // count
    _prefix_anchor: I64,               // where in `_prefix` the byte the C library is asked for
                                       // stands
    _forced_strings: Array (Array U8), // the byte strings every match holds, which the search looks
                                       // for, empty where it looks for what a match begins with
    _forced_anchors: Array I64,        // where in each of `_forced_strings` the byte the C library
                                       // is asked for stands
    _forced_count: I64,                // how many `_forced_strings` holds, read where the search
                                       // chooses how to look so that the choice costs no reference
                                       // count
    _back_max: I64,                    // most bytes the pattern may read before a string of
                                       // `_forced_strings`
    _back_class: Array U64             // the byte values it may read before one, one bit each
};

namespace Prefilter {
    // What a search looks for where it has been told no byte string every match holds.
    //
    // # Parameters
    // * `first_bytes` - The bytes a match may begin with, one bit each.
    // * `prefix` - The bytes every match begins with.
    make: Array U64 -> Array U8 -> Prefilter;
    make = |first_bytes, prefix| Prefilter {
        _first_bytes: first_bytes,
        _first_byte: _lone_byte_of(first_bytes),
        _prefix: prefix,
        _prefix_size: prefix.@size,
        _prefix_anchor: 0,
        _forced_strings: Array::empty(0),
        _forced_anchors: Array::empty(0),
        _forced_count: 0,
        _back_max: 0,
        _back_class: _no_bytes
    };

    // Whether looking for where a match may begin passes over positions faster than walking the
    // table over them: whether there is a byte or a byte string to look for, which the C library
    // reads for many bytes at a time. Without one, the walk in the fresh state reads for the bytes
    // a match may begin with as fast as anything written here would.
    //
    // # Parameters
    // * `prefilter` - What to look for.
    _skips: Prefilter -> Bool;
    _skips = |prefilter| (
        prefilter.@_forced_count > 0 || prefilter.@_prefix_size >= 2 || prefilter.@_first_byte >= 0
    );

    // The next position at or after a position where a match may begin, or the end of the text
    // where none does before it. It is asked only where `_skips` holds.
    //
    // Where the search has been told which byte strings every match holds, it looks for those.
    // Otherwise every match begins with the same two or more bytes, or a match may begin with one
    // byte alone, and the C library looks for that. The C library reads to the end of the bytes, so
    // a place it finds beyond the end of the text stands for none.
    //
    // # Parameters
    // * `bytes` - The bytes to read.
    // * `length` - How many of the bytes the text holds. Any after them stand beyond its end.
    // * `at` - The position to look from.
    // * `prefilter` - What to look for.
    _skip: Array U8 -> I64 -> I64 -> Prefilter -> I64;
    _skip = |bytes, length, at, prefilter| (
        if prefilter.@_forced_count > 0 { prefilter._skip_to_forced(bytes, length, at) };
        if prefilter.@_prefix_size >= 2 {
            let anchor = prefilter.@_prefix_anchor;
            bytes.find_bytes_by(anchor, prefilter.@_prefix, at, length).as_some_or(length)
        };
        min(bytes.find_byte(prefilter.@_first_byte.u8, at).as_some_or(length), length)
    );

    // The next position at or after a position where a match may begin, found by looking for the
    // byte strings every match holds.
    //
    // A match beginning at or after `at` holds one of the strings at or after `at`, and every byte
    // from where that match begins to where the string stands is one the pattern reads. So the
    // first place any of the strings stands bounds where the next match may begin, and backing up
    // from there over the bytes the pattern may read before the string finds that place.
    //
    // # Parameters
    // * `bytes` - The bytes to read.
    // * `length` - How many bytes there are.
    // * `at` - The position to look from.
    // * `prefilter` - The strings, and what may stand before them.
    _skip_to_forced: Array U8 -> I64 -> I64 -> Prefilter -> I64;
    _skip_to_forced = |bytes, length, at, prefilter| (
        // The strings stand in the order the text holds them most often, so the one looked for
        // first bounds how far the rest are looked for.
        let (strings, anchors) = (prefilter.@_forced_strings, prefilter.@_forced_anchors);
        let hit = range(0, prefilter.@_forced_count).fold(length, |i, earliest|
            bytes.find_bytes_by(anchors.@(i), strings.@(i), at, earliest).as_some_or(earliest)
        );
        if hit >= length { length };
        _backed_up_to(bytes, prefilter.@_back_class, prefilter.@_back_max, at, hit)
    );

    // How many bytes of the text are read to judge which set of forced byte strings to look for.
    __FORCED_SAMPLE: I64;
    __FORCED_SAMPLE = 16384;

    // How many bytes of the text are counted to tell which byte of a string the text holds least
    // often. Ranking single bytes needs far fewer bytes read than weighing how often whole strings
    // stand.
    __COUNTED: I64;
    __COUNTED = 4096;

    // What to look for over a text: which byte of a forced beginning to ask the C library for, and
    // which forced byte strings to look for where looking for them beats reading for the bytes a
    // match may begin with.
    //
    // Both depend on the text: a byte the text holds everywhere is a poor one to ask for, and a
    // string the text holds everywhere rules out nothing. So they are weighed against a stretch of
    // the text the search is about to read. The byte of the beginning the stretch holds least often
    // is asked for, and the set of strings met least often is taken where it is met less often than
    // the bytes a match may begin with.
    //
    // # Parameters
    // * `bytes` - The bytes the search is over.
    // * `length` - How many of the bytes the text holds. Any after them stand beyond its end.
    // * `sets` - The sets of forced byte strings the pattern offers.
    // * `prefilter` - What to look for so far.
    _fit: Array U8 -> I64 -> Array (Array ForcedRun) -> Prefilter -> Prefilter;
    _fit = |bytes, length, sets, prefilter| (
        // A forced beginning stands where every match begins, so it needs no backing up and nothing
        // read from inside the pattern beats it.
        if prefilter.@_prefix_size >= 2 {
            let sample = min(length, __FORCED_SAMPLE);
            let anchor = _byte_counts(bytes, min(sample, __COUNTED))._rarest_in(prefilter.@_prefix);
            prefilter.set__prefix_anchor(anchor)
        };
        if sets.@size == 0 { prefilter };
        let sample = min(length, __FORCED_SAMPLE);
        let stops = _stops_of_first_bytes(bytes, sample, prefilter.@_first_bytes);
        // Looking for a string costs a reading of its own on top of the walking, so a set is taken
        // only where it rules out enough more than the bytes a match may begin with to pay for it.
        let (best, _) = range(0, sets.@size).fold((-1, stops / 2), |i, (best, fewest)|
            let cost = _stops_of_forced_set(bytes, sample, sets.@(i));
            if cost >= fewest { (best, fewest) };
            (i, cost)
        );
        if best < 0 { prefilter._without_forced_set };
        prefilter._with_forced_set(bytes, length, sets.@(best))
    );

    // What to look for, told to read for the bytes a match may begin with. A scanner kept from one
    // search to the next carries the strings the text of that search wanted looked for, and a text
    // that wants none of them is searched by reading for the bytes instead.
    //
    // # Parameters
    // * `prefilter` - What to look for so far.
    _without_forced_set: Prefilter -> Prefilter;
    _without_forced_set = |prefilter| (
        if prefilter.@_forced_count == 0 { prefilter };
        prefilter._set_forced_strings(Array::empty(0), Array::empty(0))
    );

    // What to look for, told which byte strings to look for and which byte of each to ask the C
    // library for. `_forced_count` holds what `_forced_strings` holds, so this is where both are
    // written.
    //
    // # Parameters
    // * `strings` - The byte strings to look for, none of them where the search is to read for the
    //   bytes a match may begin with.
    // * `anchors` - Where in each string the byte to ask for stands.
    // * `prefilter` - What to look for so far.
    _set_forced_strings: Array (Array U8) -> Array I64 -> Prefilter -> Prefilter;
    _set_forced_strings = |strings, anchors, prefilter| (
        prefilter.set__forced_count(strings.@size)
            .set__forced_strings(strings)
            .set__forced_anchors(anchors)
    );

    // What to look for, told to look for a set of forced byte strings.
    //
    // # Parameters
    // * `bytes` - The bytes the search is over, which the strings are ordered against.
    // * `length` - How many of the bytes the text holds. Any after them stand beyond its end.
    // * `set` - The set to look for.
    // * `prefilter` - What to look for so far.
    _with_forced_set: Array U8 -> I64 -> Array ForcedRun -> Prefilter -> Prefilter;
    _with_forced_set = |bytes, length, set, prefilter| (
        let sample = min(length, __FORCED_SAMPLE);
        let strings = _by_falling_count(bytes, sample, set).map(@bytes);
        let counts = _byte_counts(bytes, min(sample, __COUNTED));
        let (back_max, back_class) = _backing_of(set);
        prefilter._set_forced_strings(strings, strings.map(|string| counts._rarest_in(string)))
            .set__back_max(back_max)
            .set__back_class(back_class)
    );
}

// How many times each byte value stands in a stretch of the text.
//
// # Parameters
// * `bytes` - The text to read.
// * `sample` - How many bytes of it to read.
_byte_counts: Array U8 -> I64 -> Array I64;
_byte_counts = |bytes, sample| (
    range(0, sample).fold(Array::fill(256, 0), |i, counts| counts.mod(bytes.@(i).i64, |n| n + 1))
);

// Where in a byte string the byte stands that a stretch of the text holds least often, the earliest
// such place where several hold it equally often.
//
// # Parameters
// * `string` - The byte string to read.
// * `counts` - How many times each byte value stands in the stretch.
_rarest_in: Array U8 -> Array I64 -> I64;
_rarest_in = |string, counts| (
    let (place, _) = range(0, string.@size).fold((0, I64::maximum), |k, (place, fewest)|
        let count = counts.@(string.@(k).i64);
        if count < fewest { (k, count) } else { (place, fewest) }
    );
    place
);

// How far back from where a forced byte string stands a match holding it may begin, stopping at
// a floor.
//
// # Parameters
// * `bytes` - The bytes to read.
// * `back_class` - The byte values the pattern may read before the string, one bit each.
// * `back_max` - How many bytes the pattern may read before it.
// * `floor` - The position to stop at.
// * `at` - The position the string stands at.
_backed_up_to: Array U8 -> Array U64 -> I64 -> I64 -> I64 -> I64;
_backed_up_to = |bytes, back_class, back_max, floor, at| (
    let stop = max(floor, at - back_max);
    loop(at, |at|
        if at <= stop { break $ at };
        if !back_class._holds_byte(0, bytes.@(at - 1)) { break $ at };
        continue $ at - 1
    )
);

// What a set of forced byte strings says may stand before one of them: how many bytes at most,
// and which byte values. A search looks for the whole set at once, so what it may back over is
// what any member of the set may.
//
// # Parameters
// * `set` - The set to read.
_backing_of: Array ForcedRun -> (I64, Array U64);
_backing_of = |set| (
    set.to_iter.fold((0, _no_bytes), |run, (most, bits)|
        (max(most, run.@back_max), _bytes_union(run.@back_class, bits))
    )
);

// How many times a search would look for where a match may begin over a stretch of the text as it
// stands, reading for the bytes a match may begin with. A run of them counts once: the walk goes on
// through a run without looking again.
//
// # Parameters
// * `bytes` - The text the search is over.
// * `sample` - How many bytes of it to read.
// * `wanted` - The bytes a match may begin with, one bit each.
_stops_of_first_bytes: Array U8 -> I64 -> Array U64 -> I64;
_stops_of_first_bytes = |bytes, sample, wanted| (
    range(0, sample).fold(0, |i, n|
        if !wanted._holds_byte(0, bytes.@(i)) { n };
        if i > 0 && wanted._holds_byte(0, bytes.@(i - 1)) { n };
        n + 1
    )
);

// How many positions a search would walk from over a stretch of the text, were it to look for a
// set of forced byte strings: one for every place a string of the set stands, and one more for
// every position before it a match could begin at.
//
// # Parameters
// * `bytes` - The text the search is over.
// * `sample` - How many bytes of it to read.
// * `set` - The set to weigh.
_stops_of_forced_set: Array U8 -> I64 -> Array ForcedRun -> I64;
_stops_of_forced_set = |bytes, sample, set| (
    let (back_max, bits) = _backing_of(set);
    set.to_iter.fold(0, |run, cost|
        cost + _stops_of_string(bytes, sample, run.@bytes, bits, back_max)
    )
);

// A set of forced byte strings, ordered so that the one a stretch of the text holds most often
// stands first. A search looks for them in the order they stand in, and the one looked for
// first bounds how far the rest are looked for, so the commonest first leaves the least
// reading to the rest.
//
// # Parameters
// * `bytes` - The text the search is over.
// * `sample` - How many bytes of it to read.
// * `set` - The set to order.
_by_falling_count: Array U8 -> I64 -> Array ForcedRun -> Array ForcedRun;
_by_falling_count = |bytes, sample, set| (
    set.map(|run| (_places_of(bytes, sample, run.@bytes), run))
        .sort_by(|((left, _), (right, _))| left > right)
        .map(|(_, run)| run)
);

// How many places a byte string stands at in a stretch of the text.
//
// # Parameters
// * `bytes` - The text to read.
// * `sample` - How many bytes of it to read.
// * `wanted` - The byte string to look for.
_places_of: Array U8 -> I64 -> Array U8 -> I64;
_places_of = |bytes, sample, wanted| _stops_of_string(bytes, sample, wanted, _no_bytes, 0);

// How many positions a search would walk from over a stretch of the text, for one of the forced
// byte strings it looks for: every place the string stands, and every position before it a match
// holding that string could begin at.
//
// # Parameters
// * `bytes` - The text to read.
// * `sample` - How many bytes of it to read.
// * `wanted` - The byte string to look for.
// * `back_class` - The byte values the pattern may read before it, one bit each.
// * `back_max` - How many bytes the pattern may read before it.
_stops_of_string: Array U8 -> I64 -> Array U8 -> Array U64 -> I64 -> I64;
_stops_of_string = |bytes, sample, wanted, back_class, back_max| (
    loop((0, 0), |(at, cost)|
        if at >= sample { break $ cost };
        let hit = bytes.find_bytes_within(wanted, at, sample);
        if hit.is_none { break $ cost };
        let hit = hit.as_some;
        let begin = _backed_up_to(bytes, back_class, back_max, at, hit);
        continue $ (hit + 1, cost + 1 + hit - begin)
    )
);

// The scanner: the automaton walked over sets of threads, so that reading a byte costs one table
// lookup. Where the text below says "the scanner" it means a `DFA`, and "the automaton" an `NFA`.
//
// A search walks the automaton forward from where it is to begin, starting a rank of threads at
// every position until a match is reached, which finds where the leftmost match ends in one
// reading of the text. Where the match begins is where the rank that reached it began. The walk
// reads that off where it can, and otherwise walks the automaton of the pattern read from right to
// left back from where the match ends: the earliest position that walk reaches a match at is where
// the match begins.
//
// The scanner reports where a match begins and ends and nothing else. The groups a match captured
// are read off afterwards by the automaton, over the stretch the match covers.
type DFA = unbox struct {
    _forward: StateTable,  // the automaton, walked forward to find where a match ends
    _backward: StateTable, // the automaton of the pattern read from right to left, walked back from
                           // where a match ends to find where it begins
    _prefilter: Prefilter  // what the forward walk looks for to pass over positions
};

namespace DFA {
    // How many groups the pattern captures, the whole match left out.
    //
    // # Parameters
    // * `dfa` - The automaton.
    capture_count: DFA -> I64;
    capture_count = |dfa| dfa.@_forward.@_nfa.@_group_count - 1;

    // The bytes every match begins with, as far as they are forced. They are worked out once for
    // the automaton and kept in its `_prefix`.
    //
    // # Parameters
    // * `nfa` - The automaton to walk.
    forced_beginning: NFA -> Array U8;
    forced_beginning = |nfa| (
        if nfa._asks_many_rounds { Array::empty(0) };
        let (prefix, _) = StateTable::make(nfa)._forced_prefix;
        prefix
    );

    // How many rounds a counted quantifier may ask for, for the walk that works out the forced
    // beginning to be worth taking.
    //
    // The walk asks each state whether a match can end there, and the answer is worked out by
    // following the automaton with the end of the input reached, which lets a counted quantifier
    // run its rounds out. Every round stands for a thread, and a thread is read against the threads
    // taken so far, so the walk costs the square of the rounds asked for: `(a*){100000,}` spends
    // forty-five seconds on it. A pattern asking for that many rounds is one the forced beginning
    // would not have paid for anyway.
    __MAX_PREFIX_ROUNDS: I64;
    __MAX_PREFIX_ROUNDS = 64;

    // Whether the automaton holds a quantifier asking for more rounds than the walk that works out
    // the forced beginning may take.
    //
    // # Parameters
    // * `nfa` - The automaton to read.
    _asks_many_rounds: NFA -> Bool;
    _asks_many_rounds = |nfa| (
        nfa.@_quant_bounds.to_iter.check_any(|(least, most)|
            least > __MAX_PREFIX_ROUNDS || (most < I64::maximum && most > __MAX_PREFIX_ROUNDS)
        )
    );

    // The scanner a search with an automaton starts from.
    //
    // # Parameters
    // * `nfa` - The automaton to walk, compiled by `NFA::compile`.
    make: NFA -> DFA;
    make = |nfa| nfa.@_scanner.as_some;

    // How many states of each table a scanner is given before any search. A search over a short
    // string reads few bytes, and what it costs is then mostly the states it works out; working
    // out the states every search meets first once for the automaton leaves it reading.
    __AHEAD_STATES: I64;
    __AHEAD_STATES = 8;

    // A scanner holding the states a search meets first, worked out ahead of any search: the states
    // a search begins in and those it reaches from them, every transition of each worked out, up to
    // `__AHEAD_STATES` states a table.
    //
    // A pattern asking for more rounds than the walk that works out the forced beginning may take
    // is searched by the automaton's threads: a state stands for every round a thread may have
    // counted, so working out even the first state costs the square of the rounds asked for.
    //
    // # Parameters
    // * `nfa` - The automaton to walk, holding the automaton of the pattern read from right to
    //   left.
    _worked_out: NFA -> DFA;
    _worked_out = |nfa| (
        let reversed = nfa.@_reversed.as_some;
        if nfa._asks_many_rounds {
            DFA {
                _forward: StateTable::given_up(nfa),
                _backward: StateTable::given_up(reversed),
                _prefilter: Prefilter::make(_all_bytes, Array::empty(0))
            }
        };
        let forward = StateTable::make_seeking(nfa);
        let first_bytes = forward._first_bytes_of(forward.@_interior);
        let backward = StateTable::make(reversed);
        let (at_begin, forward) = forward._start(true, true, false);
        let forward = forward._worked_out_from([forward.@_interior, at_begin], __AHEAD_STATES);
        let (at_end, backward) = backward._start(false, true, false);
        let (inside, backward) = backward._start(false, false, false);
        let backward = backward._worked_out_from([at_end, inside], __AHEAD_STATES);
        DFA {
            _forward: forward,
            _backward: backward,
            _prefilter: Prefilter::make(first_bytes, nfa.@_prefix)
        }
    );

    // The leftmost match in the text that is the first `length` of the bytes, beginning at or after
    // a position and taking the longest of those that begin at the same place, together with the
    // scanner as the search left it.
    //
    // # Parameters
    // * `bytes` - The bytes to read.
    // * `length` - How many of the bytes the text holds. Any after them stand beyond its end.
    // * `from` - The position at or after which the match has to begin.
    // * `dfa` - The scanner.
    find_within: Array U8 -> I64 -> I64 -> DFA -> (Option Groups, DFA);
    find_within = |bytes, length, from, dfa| (
        if from > length { (none(), dfa) };
        let DFA { _forward: forward, _backward: backward, _prefilter: prefilter } = dfa;
        let nfa = forward.@_nfa;
        let ((end, begin), forward) = if forward.@_full {
            ((__GIVEN_UP, -1), forward)
        } else {
            _scan_forward(bytes, length, from, prefilter, forward)
        };
        let (begin, backward) = if end < 0 || begin >= 0 {
            (begin, backward)
        } else if backward.@_full {
            (__GIVEN_UP, backward)
        } else {
            _scan_backward(bytes, length, from, end, backward)
        };
        let dfa = DFA { _forward: forward, _backward: backward, _prefilter: prefilter };
        if end == __GIVEN_UP || begin == __GIVEN_UP {
            (NFA::_search_threads(bytes, length, from, nfa), dfa)
        };
        if end < 0 { (none(), dfa) };
        // The match that ends at `end` begins at or after `from`, and read from right to left it is
        // a match of the reversed pattern, so the walk back reaches a match.
        if begin < 0 { undefined("the walk back from where a match ends reached no beginning") };
        (_match_with_groups(bytes, length, begin, end, nfa), dfa)
    );

    // What a walk reports where the states outgrew what its table may take, and the search is given
    // back to the automaton.
    __GIVEN_UP: I64;
    __GIVEN_UP = -2;

    // Walks the automaton forward from a position, starting a rank of threads at every position
    // until a match is reached, and reports where the leftmost match beginning at or after that
    // position ends, taking the longest of those that begin where it begins, or `-1` where no
    // match begins there or later. Reports with it where the match begins, where the walk could
    // read it off where rank 0 began, or `-1` where it could not.
    //
    // Reports `__GIVEN_UP` for where the match ends where the states outgrew the table.
    //
    // # Parameters
    // * `bytes` - The bytes to read.
    // * `length` - How many of the bytes the text holds. Any after them stand beyond its end.
    // * `from` - The position at or after which the match has to begin.
    // * `prefilter` - What to look for to pass over positions.
    // * `table` - The table of the automaton.
    _scan_forward: Array U8 -> I64 -> I64 -> Prefilter -> StateTable -> ((I64, I64), StateTable);
    _scan_forward = |bytes, length, from, prefilter, table| (
        let (start, table) = if from == 0 || from == length {
            table._start(true, from == 0, from == length)
        } else {
            (table.@_interior, table)
        };
        if start < 0 { ((__GIVEN_UP, -1), table) };
        let best = if table.@_accepts.@(start) { from } else { -1 };
        let fresh = table.@_fresh;
        let fresh_row = if fresh < 0 { -1 } else { 256 * fresh };
        // The walk stops before entering the fresh state where looking for the next position a
        // match may begin at passes over positions faster than walking over them.
        let skipping = fresh >= 0 && prefilter._skips;
        let skip_first = skipping && start == fresh;
        let at = if skip_first { prefilter._skip(bytes, length, from) } else { from };
        // The walk holds the transitions apart from the table while it reads them, so that reading
        // them costs no reference count, and hands them back to the table to work out a new one.
        let (table, transitions) = table[^_transitions].ixchg(StateTable::__HELD_APART);
        let (found, table, transitions) = loop(
            (at, 256 * start, best, at, table, transitions),
            |(at, row, best, begin, table, transitions)|
            let (at, row, best, begin) = _walk_forward(
                bytes, length, transitions, fresh_row, skipping, at, row, best, begin
            );
            if at == length {
                let (rank, table) = table._accepts_at_end(row / 256);
                if rank < 0 { break $ ((best, begin), table, transitions) };
                // In the fresh state rank 0 is the rank begun where the walk stands.
                let begin = if row == fresh_row { length } else { begin };
                break $ ((length, if rank == 0 { begin } else { -1 }), table, transitions)
            };
            let entry = transitions.@(row + bytes.@(at).i64);
            if entry == StateTable::__UNTAKEN {
                let table = table.set__transitions(transitions);
                let (next, table) = table._next(row / 256, bytes.@(at));
                let (table, transitions) = table[^_transitions].ixchg(StateTable::__HELD_APART);
                if next < 0 { break $ ((__GIVEN_UP, -1), table, transitions) };
                continue $ (at, row, best, begin, table, transitions)
            };
            if skipping && entry == fresh_row {
                let at = prefilter._skip(bytes, length, at + 1);
                continue $ (at, entry, best, at, table, transitions)
            };
            let taken = -2 - entry;
            let (row, at) = (taken.shift_right(3), at + 1);
            let best = if taken.bit_and(1) == 1 { at } else { best };
            if row == 256 * StateTable::__DEAD_STATE { break $ ((best, begin), table, transitions) };
            // Rank 0 died, or a later rank reached the accepting node, so where the match begins is
            // no longer where rank 0 began.
            continue $ (at, row, best, -1, table, transitions)
        );
        (found, table.set__transitions(transitions))
    );

    // Walks the automaton of the pattern read from right to left back from where a match ends, and
    // reports where the leftmost match ending there begins, no earlier than a position: the
    // earliest position at or after that one the walk reaches a match at. Reports `__GIVEN_UP` where
    // the states outgrew the table.
    //
    // # Parameters
    // * `bytes` - The bytes to read.
    // * `length` - How many of the bytes the text holds. Any after them stand beyond its end.
    // * `floor` - The position at or after which the match has to begin.
    // * `end` - Where the match ends.
    // * `table` - The table of the reversed automaton.
    _scan_backward: Array U8 -> I64 -> I64 -> I64 -> StateTable -> (I64, StateTable);
    _scan_backward = |bytes, length, floor, end, table| (
        // Read from right to left, the input begins where it ends and ends where it begins, so `$`
        // holds where `^` would and `^` where `$` would.
        let (start, table) = table._start(false, end == length, end == 0);
        if start < 0 { (__GIVEN_UP, table) };
        let best = if table.@_accepts.@(start) { end } else { -1 };
        let (table, transitions) = table[^_transitions].ixchg(StateTable::__HELD_APART);
        let (found, table, transitions) = loop(
            (end, 256 * start, best, table, transitions), |(at, row, best, table, transitions)|
            let (at, row, best) = _walk_backward(bytes, transitions, floor, at, row, best);
            if at == floor {
                // Read from right to left, the input ends where it begins, which only the position
                // where the input begins stands for.
                if floor > 0 { break $ (best, table, transitions) };
                let (rank, table) = table._accepts_at_end(row / 256);
                break $ (if rank >= 0 { 0 } else { best }, table, transitions)
            };
            let entry = transitions.@(row + bytes.@(at - 1).i64);
            if entry == StateTable::__UNTAKEN {
                let table = table.set__transitions(transitions);
                let (next, table) = table._next(row / 256, bytes.@(at - 1));
                let (table, transitions) = table[^_transitions].ixchg(StateTable::__HELD_APART);
                if next < 0 { break $ (__GIVEN_UP, table, transitions) };
                continue $ (at, row, best, table, transitions)
            };
            let taken = -2 - entry;
            let (row, at) = (taken.shift_right(3), at - 1);
            let best = if taken.bit_and(1) == 1 { at } else { best };
            if row == 256 * StateTable::__DEAD_STATE { break $ (best, table, transitions) };
            continue $ (at, row, best, table, transitions)
        );
        (found, table.set__transitions(transitions))
    );

    // The leftmost match beginning at or after a position, taking the longest of those that begin
    // at the same place, together with the scanner as the search left it.
    //
    // A scanner works out what the automaton does with a byte the first time it reads that byte in
    // that state, and keeps the answer, so a search handed a scanner back reads what the searches
    // before it worked out.
    //
    // # Parameters
    // * `bytes` - The bytes to read.
    // * `from` - The position at or after which the match has to begin.
    // * `dfa` - The scanner to search with.
    search_from: Array U8 -> I64 -> DFA -> (Option Groups, DFA);
    search_from = |bytes, from, dfa| dfa.search_from_within(bytes, bytes.@size, from);

    // What `search_from` reports for a text that is the first `length` of the bytes. A string's
    // bytes are searched this way, with the null byte that ends them left beyond the text, where
    // dropping it would copy them.
    //
    // # Parameters
    // * `bytes` - The bytes to read.
    // * `length` - How many of the bytes the text holds. Any after them stand beyond its end.
    // * `from` - The position at or after which the match has to begin.
    // * `dfa` - The scanner to search with.
    search_from_within: Array U8 -> I64 -> I64 -> DFA -> (Option Groups, DFA);
    search_from_within = |bytes, length, from, dfa| (
        dfa._fit(bytes, length).find_within(bytes, length, from)
    );

    // Every match a scanner finds, taken left to right, none of them overlapping another, together
    // with the scanner as the search left it.
    //
    // # Parameters
    // * `bytes` - The bytes to read.
    // * `dfa` - The scanner to search with.
    search_every: Array U8 -> DFA -> (Array Groups, DFA);
    search_every = |bytes, dfa| dfa.search_every_within(bytes, bytes.@size);

    // What `search_every` reports for a text that is the first `length` of the bytes. See
    // `search_from_within`.
    //
    // # Parameters
    // * `bytes` - The bytes to read.
    // * `length` - How many of the bytes the text holds. Any after them stand beyond its end.
    // * `dfa` - The scanner to search with.
    search_every_within: Array U8 -> I64 -> DFA -> (Array Groups, DFA);
    search_every_within = |bytes, length, dfa| dfa._fit(bytes, length)._every_match(bytes, length);

    // The scanner told what to look for over a text. See `Prefilter::_fit`.
    //
    // # Parameters
    // * `bytes` - The bytes the search is over.
    // * `length` - How many of the bytes the text holds. Any after them stand beyond its end.
    // * `dfa` - The scanner.
    _fit: Array U8 -> I64 -> DFA -> DFA;
    _fit = |bytes, length, dfa| (
        let sets = dfa.@_forward.@_nfa.@_forced_sets;
        dfa.mod__prefilter(Prefilter::_fit(bytes, length, sets))
    );

    // Every match a scanner finds, taken left to right, none of them overlapping another, together
    // with the scanner as the search left it. The scanner searches as it stands, looking for
    // whatever it has been told to look for.
    //
    // # Parameters
    // * `bytes` - The bytes to read.
    // * `length` - How many of the bytes the text holds. Any after them stand beyond its end.
    // * `dfa` - The scanner to search with.
    _every_match: Array U8 -> I64 -> DFA -> (Array Groups, DFA);
    _every_match = |bytes, length, dfa| (
        let (matches, _, dfa) = loop(
            (Array::empty(8), 0, dfa), |(matches, from, dfa)|
            if from > length { break $ (matches, from, dfa) };
            let (opt, dfa) = dfa.find_within(bytes, length, from);
            if opt.is_none { break $ (matches, from, dfa) };
            let groups = opt.as_some;
            let (begin, end) = groups.@(0);
            // A match that read nothing would be found again where it was found.
            continue $ (matches.push_back(groups), if end > begin { end } else { begin + 1 }, dfa)
        );
        (matches, dfa)
    );

    // A match together with the groups it captured. A pattern that captures nothing has the whole
    // match for its only group, and one that captures is walked again by the automaton over the
    // stretch the match covers, which is where the groups are read off.
    //
    // # Parameters
    // * `bytes` - The bytes the match was found in.
    // * `length` - How many of the bytes the text holds. Any after them stand beyond its end.
    // * `begin` - Where the match begins.
    // * `end` - Where it ends.
    // * `nfa` - The automaton the match was found with.
    _match_with_groups: Array U8 -> I64 -> I64 -> I64 -> NFA -> Option Groups;
    _match_with_groups = |bytes, length, begin, end, nfa| (
        if nfa.@_group_count <= 1 { some $ [(begin, end)] };
        NFA::_capture_groups(bytes, length, begin, end, nfa)
    );
}

namespace NFA {
    // Runs the automaton over the bytes and reports the leftmost match beginning at or after a
    // position, taking the longest of those that begin at the same place.
    //
    // # Parameters
    // * `bytes` - The bytes to read.
    // * `from` - The position at or after which the match has to begin.
    // * `nfa` - The automaton to run.
    search: Array U8 -> I64 -> NFA -> Option Groups;
    search = |bytes, from, nfa| (
        let (found, _) = DFA::make(nfa).search_from(bytes, from);
        found
    );

    // Every match the automaton finds, taken left to right, none of them overlapping another.
    //
    // # Parameters
    // * `bytes` - The bytes to read.
    // * `nfa` - The automaton to run.
    search_all: Array U8 -> NFA -> Array Groups;
    search_all = |bytes, nfa| (
        let (matches, _) = DFA::make(nfa).search_every(bytes);
        matches
    );
}

// A piece of a replacement string.
type ReplaceFrag = unbox union {
    rep_literal: U8,   // the byte to write out
    rep_group: I64,    // which group to write the captured text of, `0` standing for the whole match
    rep_before: (),    // the text before the match
    rep_after: ()      // the text after the match
};

namespace Replacement {

    // Compiles a replacement string to fragments, reading it as JavaScript reads the replacement
    // string of `String.prototype.replaceAll`:
    // - `$$` stands for a `$`, `$&` for the whole match, `` $` `` for the text before the match and
    //   `$'` for the text after it.
    // - `$` and two digits stand for the group they number where that group exists; otherwise `$`
    //   and the first digit stand for the group it numbers, and the second digit for itself. `$0`
    //   and the number of a group the pattern lacks stand for themselves.
    // - Every other byte stands for itself, a `$` among them.
    //
    // # Parameters
    // * `group_count` - How many groups the pattern captures, the whole match left out.
    // * `replacement` - The replacement string.
    compile: I64 -> String -> Array ReplaceFrag;
    compile = |group_count, replacement| (
        let bytes = replacement.get_bytes;
        let size = replacement.@size;
        // The number the digit at `at` writes, or `-1` where no digit stands there.
        let digit = |at| (
            if at >= size { -1 };
            let byte = bytes.@(at);
            if byte < '0' || '9' < byte { -1 };
            (byte - '0').i64
        );
        let names_group = |index| 1 <= index && index <= group_count;
        loop((Array::empty(size), 0), |(frags, at)|
            if at >= size { break $ frags };
            let byte = bytes.@(at);
            if byte != '$' || at + 1 >= size { continue $ (frags.push_back(rep_literal(byte)), at + 1) };
            let next = bytes.@(at + 1);
            if next == '$' { continue $ (frags.push_back(rep_literal('$')), at + 2) };
            if next == '&' { continue $ (frags.push_back(rep_group(0)), at + 2) };
            if next == '`' { continue $ (frags.push_back(rep_before()), at + 2) };
            if next == '\'' { continue $ (frags.push_back(rep_after()), at + 2) };
            let first = digit(at + 1);
            let second = digit(at + 2);
            if first >= 0 && second >= 0 && names_group(first * 10 + second) {
                continue $ (frags.push_back(rep_group(first * 10 + second)), at + 3)
            };
            if names_group(first) { continue $ (frags.push_back(rep_group(first)), at + 2) };
            continue $ (frags.push_back(rep_literal('$')), at + 1)
        )
    );

    // The text a match is replaced by: the fragments written out one after another, each group
    // standing for the text it captured, and a group that captured nothing for the empty string.
    //
    // # Parameters
    // * `target` - The string the match was found in.
    // * `rep_frags` - The fragments the replacement string compiled to.
    // * `groups` - The groups the match captured.
    calc_replacement: String -> Array ReplaceFrag -> Groups -> String;
    calc_replacement = |target, rep_frags, groups| (
        let (begin, end) = groups.@(0);
        let output: Array U8 = Array::empty(target.@size + rep_frags.@size);
        let output = rep_frags.to_iter.fold(
            output, |rep, output|
            if rep.is_rep_literal {
                output.push_back(rep.as_rep_literal)
            };
            let (from, to) = (
                if rep.is_rep_before { (0, begin) };
                if rep.is_rep_after { (end, target.@size) };
                groups.group_at(rep.as_rep_group)
            );
            output.append(target.substring(from, to).get_bytes.pop_back)
        );
        output._unsafe_to_string
    );
}
