// Character class and Pattern parser. This is internal module of `RegExp`.
module RegExp._Internal.Pattern;

import RegExp._Internal.CaseFold::same_case_units;
import RegExp._Internal.SimpleParser::{
    Parser, 
    Parser::{
        error_parser, filter, get_stream, look_ahead, match_any_char, match_char, 
        match_char_if_exists, match_end_of_stream, not_match, or_else, or_error, repeat, 
        run_parser_str, zero_or_more
    }, 
    Stream::{read_string, Stream::@position}
};
import RegExp._Internal.StdBytes::find_bytes_within;
import Std::{
    undefined, Array, Bool, ErrMsg, I64, Option, Result, String, ToString, U64, U8, 
    Array::{@, @size, append, empty, fill, from_map, mod, push_back, set, to_iter}, Functor::map, I64::maximum, 
    Iterator::{check_any, count_up, fold, map, range, take, to_array}, LessThan::{max, min}, Monad::{bind, pure}, 
    Option::{as_some, is_none, is_some, none, some}, String::{@size, from_U8, get_bytes, join}, ToI64::i64, 
    ToString::to_string, ToU64::u64, ToU8::u8, U64::{bit_or, maximum, shift_left}
};

// Type of a character class.
type CharClass = unbox struct {
    // A label that describes this class (for debugging only)
    label: String,
    // A function that judges whether a character is a member of this class
    f: U8 -> Bool
};

namespace CharClass {
    // An empty character class.
    empty: CharClass;
    empty = CharClass {
        label: "",
        f: |c| false
    };

    // Creates a character class from a label and a member function.
    make: String -> (U8 -> Bool) -> CharClass;
    make = |label, f| CharClass { label:label, f:f };

    // Returns true if the character is a member of the class.
    contains: U8 -> CharClass -> Bool;
    contains = |c, cls| (cls.@f)(c);

    // Creates a character class whose only member is the specified character.
    singleton: U8 -> CharClass;
    singleton = |c| CharClass {
        label: String::from_U8(c),
        f: |c1| c1 == c
    };

    // Creates a character class whose members are characters from start to end.
    range: U8 -> U8 -> CharClass;
    range = |start, end| CharClass {
        label: String::from_U8(start) + "-" + String::from_U8(end),
        f: |c| start <= c && c <= end
    };

    // Creates a character class whose members are characters in the specified string.
    consists_of: String -> CharClass;
    consists_of = |str| CharClass {
        label: str,
        f: |c| str.get_bytes.find_bytes_within([c], 0, str.@size).is_some
    };

    // Negate the member function of a character class.
    negate: CharClass -> CharClass;
    negate = |cls| (
        let label = "^" + cls.@label;
        let f = cls.@f;
        CharClass {
            label: label,
            f: |c| !f(c)
        }
    );

    // Creates union of two character classes.
    union: CharClass -> CharClass -> CharClass;
    union = |cls1, cls2| (
        let f = cls1.@f;
        let g = cls2.@f;
        CharClass {
            label: cls1.@label + cls2.@label,
            f: |c| f(c) || g(c)
        }
    );

    // The class of the bytes that `cls` holds, together with the ASCII characters JavaScript's `i`
    // flag takes for an ASCII character `cls` holds. A byte from 0x80 upward is part of a character
    // of two or more bytes, and is kept as it is.
    fold_case: CharClass -> CharClass;
    fold_case = |cls| CharClass {
        label: cls.@label,
        f: |c| cls.contains(c) || c < 0x80_U8 && same_case_units(c.i64).to_iter.check_any(|unit|
            unit < 0x80 && cls.contains(unit.u8)
        )
    };

    // Adds a character to the character class.
    add: U8 -> CharClass -> CharClass;
    add = |c, cls| cls.union(singleton(c));

    // For optimization, creates a lookup table of same members, and returns a character class
    // using that table.
    to_table: CharClass -> CharClass;
    to_table = |cls| (
        let table = count_up(0).take(256).fold(
            Array::fill(256, false), |i, arr|
            arr.set(i, cls.contains(i.u8))
        );
        CharClass {
            label: cls.@label,
            f: |c| table.@(c.i64)
        }
    );

    // A character class of `.`. (any character except newlines)
    cls_dot: CharClass;
    cls_dot = CharClass::make(".") $ |c| c != '\n' && c != '\r';

    // A character class of `\d`. (digits)
    cls_digit: CharClass;
    cls_digit = CharClass::make("\\d") $ _is_digit;

    // A character class of `\D`. (non-digits)
    cls_non_digit: CharClass;
    cls_non_digit = cls_digit.negate.set_label("\\D");

    // A character class of `\w`. (ie. `[A-Za-z0-9_]`)
    cls_word_char: CharClass;
    cls_word_char = CharClass::make("\\w") $ |c| _is_letter(c) || _is_digit(c) || c == '_';

    // A character class of `\W`. (ie. `[^A-Za-z0-9_]`)
    cls_non_word_char: CharClass;
    cls_non_word_char = cls_word_char.negate.set_label("\\W");

    // A character class of `\s`. (whitespaces)
    cls_whitespace: CharClass;
    cls_whitespace = CharClass::make("\\s") $ |c| 9_U8 <= c && c <= 13_U8 || c == ' ';

    // A character class of `\S`. (non-whitespaces)
    cls_non_whitespace: CharClass;
    cls_non_whitespace = cls_whitespace.negate.set_label("\\S");
}

// Whether `c` is an ASCII digit, `0`..`9`.
_is_digit: U8 -> Bool;
_is_digit = |c| '0' <= c && c <= '9';

// Whether `c` is an ASCII letter, `a`..`z` or `A`..`Z`.
_is_letter: U8 -> Bool;
_is_letter = |c| 'a' <= c && c <= 'z' || 'A' <= c && c <= 'Z';

// The value of `c` as a hexadecimal digit, or `-1` where `c` is not one.
_hex_value: U8 -> I64;
_hex_value = |c| (
    if _is_digit(c) { (c - '0').i64 };
    if 'a' <= c && c <= 'f' { (c - 'a').i64 + 10 };
    if 'A' <= c && c <= 'F' { (c - 'A').i64 + 10 };
    -1
);

// Type of an assertion for regular expressions, such as `^`, `$`.
type PAssertion = unbox union {
    pa_begin: (),       // beginning of line, ie. '^'
    pa_end: ()          // end of line,       ie. '$'
};

// Converts an assertion to a string.
impl PAssertion: ToString {
    to_string = |pa| (
        if pa.is_pa_begin { "^" };
        if pa.is_pa_end { "$" };
        undefined("err")
    );
}

// Type of a parsed regular expression.
type Pattern = box union {
    // Character class pattern, eg. `a`, `[a-z]`, `\d` etc.
    pclass: CharClass,
    // Assertion pattern, eg. `^`, `$`
    passert: PAssertion,
    // Sequence of patterns, eg. `XYZ`
    psequence: Array Pattern,
    // Either pattern, eg. `X|Y`
    peither: (Pattern, Pattern),
    // Quantified pattern, eg. `X?`, `X*`, `X+`, `X{n,m}`: the pattern, the fewest and the most
    // rounds, and whether a match takes as many rounds as it can (greedy) or as few (`X*?` and the
    // like)
    pquant: (Pattern, I64, I64, Bool),
    // Grouped pattern, eg. `(X)`
    pgroup: (/* group_number:*/ I64, Pattern)
};

// Converts a pattern to a string.
impl Pattern: ToString {
    to_string = |pat| (
        if pat.is_pclass {
            "[" + pat.as_pclass.@label + "]"
        };
        if pat.is_passert {
            pat.as_passert.to_string
        };
        if pat.is_psequence {
            pat.as_psequence.to_iter.map(to_string).join("")
        };

        if pat.is_peither {
            let (pat1, pat2) = pat.as_peither;
            pat1.to_string + "|" + pat2.to_string
        };
        if pat.is_pquant {
            let (pat1, min, max, greedy) = pat.as_pquant;
            pat1.to_string + "{" + min.to_string + "," +
                if max == I64::maximum { "" } else { max.to_string }
            + "}" + if greedy { "" } else { "?" }
        };
        if pat.is_pgroup {
            let (n, pat_inner) = pat.as_pgroup;
            "(" + n.to_string + ":" + pat_inner.to_string + ")"
        };
        undefined("err")
    );
}

namespace Pattern {

    // Parses a pattern from specified string. Where `ignore_case` holds, a character matches every
    // character JavaScript's `i` flag takes for it.
    //
    // The parsers below that take `ignore_case` pass it on in this meaning.
    parse: Bool -> String -> Result ErrMsg Pattern;
    parse = |ignore_case, str| (
        parse_pattern(ignore_case).run_parser_str(str).map(|(p,_)| p)
    );

    // Parses a pattern from the stream.
    parse_pattern: Bool -> Parser Pattern;
    parse_pattern = |ignore_case| do {
        let pat = *_parse_peither(ignore_case);
        let _ = *match_end_of_stream;
        pure $ pat
    };

    // Parses either-pattern, ie. `X|Y`
    _parse_peither: Bool -> Parser Pattern;
    _parse_peither = |ignore_case| do {
        let pat1 = *_parse_psequence(ignore_case);
        let bar = *match_char_if_exists('|');
        if bar.is_some {
            let pat2 = *_parse_peither(ignore_case);
            pure $ peither $ (pat1, pat2)
        };
        pure $ pat1
    };

    // Parses sequence of patterns, ie. `XYZ`
    _parse_psequence: Bool -> Parser Pattern;
    _parse_psequence = |ignore_case| do {
        pure $ psequence $ *zero_or_more(
            _parse_passert.or_else(_parse_pquant(ignore_case))
        )
    };

    // Parses an assertion pattern, ie. `^`, `$` etc.
    _parse_passert: Parser Pattern;
    _parse_passert = do {
        let circumflex = *match_char_if_exists('^');
        if circumflex.is_some {
            pure $ passert $ pa_begin()
        };
        let dollar = *match_char_if_exists('$');
        if dollar.is_some {
            pure $ passert $ pa_end()
        };
        not_match
    };

    // Parses Quantified Pattern, ie. `X?`, `X*`, `X+`, `X{n}`, `X{n,}`, `X{n,m}`, each of them
    // followed by `?` where it takes as few rounds as it can.
    _parse_pquant: Bool -> Parser Pattern;
    _parse_pquant = |ignore_case| do {
        let pat = *_parse_quantifiable_item(ignore_case);
        let bounds = *_parse_quantifier.map(some).or_else(pure $ none());
        if bounds.is_none { pure $ pat };
        let (least, most) = bounds.as_some;
        let lazy = *match_char_if_exists('?');
        pure $ pquant $ (pat, least, most, lazy.is_none)
    };

    // Parses a quantifier, ie. `?`, `*`, `+`, `{n}`, `{n,}`, `{n,m}`, as the fewest and the most
    // rounds it admits. A `{` that begins none of the last three is no quantifier.
    _parse_quantifier: Parser (I64, I64);
    _parse_quantifier = do {
        let question = *match_char_if_exists('?');
        if question.is_some { pure $ (0, 1) };
        let asterisk = *match_char_if_exists('*');
        if asterisk.is_some { pure $ (0, maximum) };
        let plus = *match_char_if_exists('+');
        if plus.is_some { pure $ (1, maximum) };
        let lbrace = *match_char_if_exists('{');
        if lbrace.is_none { not_match };
        _parse_braced_bounds
    };

    // Parses the rest of `{n}`, `{n,}` or `{n,m}` after the `{`, as the fewest and the most rounds.
    // Where the text after the `{` takes none of the three forms, nothing is parsed. `{n,m}` whose
    // `n` exceeds `m` is reported as an error.
    _parse_braced_bounds: Parser (I64, I64);
    _parse_braced_bounds = do {
        let start_stream = *get_stream;
        let least = *_parse_count;
        let comma = *match_char_if_exists(',');
        let most = *if comma.is_none {
            pure $ some(least)
        } else {
            _parse_count.map(some).or_else(pure $ none())
        };
        let _ = *match_char('}');
        if most.is_none { pure $ (least, maximum) };
        if least > most.as_some {
            let end = (*get_stream).@position;
            let text = start_stream.read_string(end - start_stream.@position);
            error_parser $ "Invalid quantifier:{" + text
        };
        pure $ (least, most.as_some)
    };

    // Parses the decimal digits of a count of rounds, a count past `I64::maximum` reading as
    // `I64::maximum`.
    _parse_count: Parser I64;
    _parse_count = do {
        let digits = *repeat(match_any_char.filter(_is_digit));
        if digits.@size == 0 { not_match };
        pure $ digits.to_iter.fold(0, |c, count|
            let digit = (c - '0').i64;
            if count > (I64::maximum - digit) / 10 { I64::maximum };
            count * 10 + digit
        )
    };

    // Parses quantifiable item.
    _parse_quantifiable_item: Bool -> Parser Pattern;
    _parse_quantifiable_item = |ignore_case| (
        _parse_pgroup(ignore_case).or_else(_parse_atom(ignore_case))
    );

    // Parses Group Pattern, ie. `(X)`
    _parse_pgroup: Bool -> Parser Pattern;
    _parse_pgroup = |ignore_case| do {
        let lparen = *match_char('(');
        let pat = *_parse_peither(ignore_case);
        let rparen = *match_char(')').or_error("')' is missing");
        let group_idx = 0;  // have to assign group index later
        pure $ pgroup $ (group_idx, pat)
    };

    // The characters that stand for themselves where a pattern reads a character class. `]`, `{`
    // and `}` are among them: `]` closes a bracket expression, and `{` begins a quantifier where
    // `{n}`, `{n,}` or `{n,m}` follows, but outside those places each is the character itself.
    _normal_chars: CharClass;
    _normal_chars = (
        CharClass::consists_of(
            ".?*+^$|[()\\"
        ).negate.to_table
    );

    // Parses an atom that reads characters: a character, `.`, a bracket expression or an escape.
    _parse_atom: Bool -> Parser Pattern;
    _parse_atom = |ignore_case| do {
        let c = *match_any_char;
        let braced = *if c == '{' {
            look_ahead(_parse_braced_bounds).map(|_| true).or_else(pure $ false)
        } else {
            pure $ false
        };
        if braced {
            error_parser $ "A quantifier `{...}` follows nothing it can repeat"
        };
        if _normal_chars.contains(c) {
            _parse_char_pattern(ignore_case, *_parse_rest_of_char(c))
        };
        if c == '.' {
            pure $ pclass(CharClass::cls_dot)
        };
        if c == '[' {
            pure $ pclass(*_parse_pclass_bracket(ignore_case))
        };
        if c == '\\' {
            _parse_escape(ignore_case)
        };
        not_match
    };

    // Parses an escape outside a bracket expression. The backslash itself is parsed already.
    _parse_escape: Bool -> Parser Pattern;
    _parse_escape = |ignore_case| (
        _parse_unsupported_escape
        .or_else(_parse_class_escape.map(pclass))
        .or_else(_parse_escaped_char(false).bind(_parse_char_pattern(ignore_case)))
    );

    // Reports the escapes outside a bracket expression that this library does not implement: `\b`
    // and `\B`, which JavaScript reads as word boundary assertions, and `\1`..`\9`, which it reads
    // as backreferences, or as octal escapes and digits where the pattern has fewer groups. The
    // backslash itself is parsed already.
    _parse_unsupported_escape: Parser Pattern;
    _parse_unsupported_escape = do {
        let c = *match_any_char;
        if c == 'b' || c == 'B' {
            error_parser $ "The word boundary assertion `\\" + from_U8(c) + "` is not supported"
        };
        if '1' <= c && c <= '9' {
            error_parser $ "`\\" + from_U8(c) + "` outside a bracket expression is not supported"
        };
        not_match
    };

    // Parses a character class escape, ie. `\d`, `\D`, `\w`, `\W`, `\s`, `\S`. The backslash itself
    // is parsed already.
    _parse_class_escape: Parser CharClass;
    _parse_class_escape = do {
        let c = *match_any_char;
        if c == 'd' { pure $ CharClass::cls_digit };
        if c == 'D' { pure $ CharClass::cls_non_digit };
        if c == 'w' { pure $ CharClass::cls_word_char };
        if c == 'W' { pure $ CharClass::cls_non_word_char };
        if c == 's' { pure $ CharClass::cls_whitespace };
        if c == 'S' { pure $ CharClass::cls_non_whitespace };
        not_match
    };

    // Parses an escape that stands for one character, and gives the bytes that character matches.
    // The backslash itself is parsed already, and `in_bracket` tells whether the escape is in a
    // bracket expression.
    //
    // A character with no escape of its own stands for itself, as `\.` does. `\c` followed by no
    // control letter stands for the backslash alone, leaving the `c` to be read next.
    _parse_escaped_char: Bool -> Parser (Array U8);
    _parse_escaped_char = |in_bracket| (
        _parse_char_escape(in_bracket).bind(_utf8_of_code_unit)
        .or_else(match_any_char.filter(|c| c != 'c').bind(_parse_rest_of_char))
        .or_else(look_ahead(match_char('c')).map(|_| ['\\']))
        .or_else(error_parser("A pattern ends with `\\`"))
    );

    // Parses an escape that names a character by a letter or a number, and gives the UTF-16 code
    // unit JavaScript reads it as: `\t`, `\n`, `\v`, `\f`, `\r`, `\cX`, `\xhh`, `\uhhhh`, and the
    // octal escapes `\0`..`\377`. The backslash itself is parsed already.
    //
    // In a bracket expression, `\b` is the backspace, `\c` also takes a digit or `_`, and an octal
    // escape may also begin with `1`..`7`. Outside one, an octal escape begins with `0`.
    _parse_char_escape: Bool -> Parser I64;
    _parse_char_escape = |in_bracket| do {
        let c = *match_any_char;
        if c == 't' { pure $ 9 };
        if c == 'n' { pure $ 10 };
        if c == 'v' { pure $ 11 };
        if c == 'f' { pure $ 12 };
        if c == 'r' { pure $ 13 };
        if c == 'b' && in_bracket { pure $ 8 };
        if c == 'c' {
            let letter = *match_any_char.filter(|x|
                _is_letter(x) || in_bracket && (_is_digit(x) || x == '_')
            );
            pure $ letter.i64 % 32
        };
        if c == 'x' { _parse_hex_digits(2, 0) };
        if c == 'u' { _parse_hex_digits(4, 0) };
        if c == '0' || in_bracket && '1' <= c && c <= '7' {
            _parse_octal_digits(if c <= '3' { 2 } else { 1 }, (c - '0').i64)
        };
        not_match
    };

    // Parses `count` hexadecimal digits, and gives `value` followed by them as a number.
    _parse_hex_digits: I64 -> I64 -> Parser I64;
    _parse_hex_digits = |count, value| do {
        if count == 0 { pure $ value };
        let digit = *match_any_char.map(_hex_value).filter(|d| d >= 0);
        _parse_hex_digits(count - 1, value * 16 + digit)
    };

    // Parses up to `most` octal digits, and gives `value` followed by them as a number.
    _parse_octal_digits: I64 -> I64 -> Parser I64;
    _parse_octal_digits = |most, value| do {
        if most == 0 { pure $ value };
        let c = *match_any_char.filter(|c| '0' <= c && c <= '7').map(some).or_else(pure $ none());
        if c.is_none { pure $ value };
        _parse_octal_digits(most - 1, value * 8 + (c.as_some - '0').i64)
    };

    // The UTF-8 encoding of the character whose UTF-16 code unit is `unit`. A surrogate
    // (U+D800..U+DFFF) encodes no character by itself and is reported as an error.
    _utf8_of_code_unit: I64 -> Parser (Array U8);
    _utf8_of_code_unit = |unit| (
        if 0xD800 <= unit && unit <= 0xDFFF {
            error_parser $ "An escape for a surrogate (U+D800..U+DFFF) is not supported"
        };
        pure $ _utf8_of_unit(unit)
    );

    // The UTF-8 encoding of the character whose UTF-16 code unit is `unit`, a code unit outside the
    // surrogates (U+D800..U+DFFF).
    _utf8_of_unit: I64 -> Array U8;
    _utf8_of_unit = |unit| (
        let bytes = if unit < 0x80 {
            [unit]
        } else if unit < 0x800 {
            [0xC0 + unit / 64, 0x80 + unit % 64]
        } else {
            [0xE0 + unit / 4096, 0x80 + unit / 64 % 64, 0x80 + unit % 64]
        };
        bytes.to_iter.map(u8).to_array
    );

    // The UTF-16 code unit of the character whose UTF-8 bytes are `bytes`, or `-1` where they
    // encode a character from U+10000 upward or are no UTF-8 encoding of one character.
    _unit_of_utf8: Array U8 -> I64;
    _unit_of_utf8 = |bytes| (
        let continues = |i| 0x80_U8 <= bytes.@(i) && bytes.@(i) < 0xC0_U8;
        let lead = bytes.@(0).i64;
        if bytes.@size == 1 && lead < 0x80 { lead };
        if bytes.@size == 2 && 0xC2 <= lead && lead < 0xE0 && continues(1) {
            (lead - 0xC0) * 64 + (bytes.@(1).i64 - 0x80)
        };
        if bytes.@size != 3 || lead < 0xE0 || 0xF0 <= lead || !continues(1) || !continues(2) { -1 };
        let unit = (lead - 0xE0) * 4096 + (bytes.@(1).i64 - 0x80) * 64 + (bytes.@(2).i64 - 0x80);
        if unit < 0x800 || 0xD800 <= unit && unit <= 0xDFFF { -1 };
        unit
    );

    // Parses the bytes that follow `first` within one UTF-8 character, and gives all of its bytes.
    _parse_rest_of_char: U8 -> Parser (Array U8);
    _parse_rest_of_char = |first| (
        if first < 0xC0_U8 { pure $ [first] };
        repeat(match_any_char.filter(|c| 0x80_U8 <= c && c < 0xC0_U8))
        .map(|rest| [first].append(rest))
    );

    // Gives the pattern that matches the character whose UTF-8 bytes are `bytes`, so that a
    // quantifier after it repeats the whole character.
    //
    // JavaScript reads a character from U+10000 upward as two UTF-16 code units, and a quantifier
    // after it repeats the second alone, which no sequence of whole bytes can match. Such a
    // character followed by a quantifier is reported as an error. The `i` flag leaves such a
    // character as it is, since no surrogate has a case.
    _parse_char_pattern: Bool -> Array U8 -> Parser Pattern;
    _parse_char_pattern = |ignore_case, bytes| do {
        let quantified = *if bytes.@size < 4 {
            pure $ false
        } else {
            look_ahead(_parse_quantifier).map(|_| true).or_else(pure $ false)
        };
        if quantified {
            error_parser $ "A quantifier after a character from U+10000 upward is not supported"
        };
        let units = if ignore_case { same_case_units(_unit_of_utf8(bytes)) } else { [] };
        if units.@size < 2 { pure $ _pattern_of_bytes(bytes) };
        if units.to_iter.check_any(|unit| unit >= 0x80) {
            pure $ _either_of $ units.map(|unit| _pattern_of_bytes(_utf8_of_unit(unit)))
        };
        pure $ pclass $ units.to_iter.fold(CharClass::empty, |unit, cls| cls.add(unit.u8))
    };

    // The pattern that matches what one of `pats` matches, trying them in order. `pats` is not
    // empty.
    _either_of: Array Pattern -> Pattern;
    _either_of = |pats| (
        let count = pats.@size;
        Iterator::range(1, count).fold(pats.@(count - 1), |i, rest|
            peither $ (pats.@(count - 1 - i), rest)
        )
    );

    // The pattern that matches `bytes` in order.
    _pattern_of_bytes: Array U8 -> Pattern;
    _pattern_of_bytes = |bytes| (
        if bytes.@size == 1 { pclass(CharClass::singleton(bytes.@(0))) };
        psequence $ bytes.to_iter.map(|b| pclass(CharClass::singleton(b))).to_array
    );

    // Parses a character class that begins with '['.
    // The `[` itself is parsed already.
    _parse_pclass_bracket: Bool -> Parser CharClass;
    _parse_pclass_bracket = |ignore_case| do {
        let circumflex = *match_char_if_exists('^');
        let components = *repeat(_parse_bracket_component);
        let _ = *match_char(']').or_error("']' is missing");
        let cls = components.to_iter.fold(CharClass::empty, union);
        let cls = if ignore_case { cls.fold_case } else { cls };
        let cls = if circumflex.is_some { cls.negate } else { cls };
        pure $ cls.to_table
    };

    // Parses each component in a bracket: a class atom, or a range of two joined by `-`. Where a
    // character class escape such as `\d` joins a range, the range stands for both atoms and `-`.
    _parse_bracket_component: Parser CharClass;
    _parse_bracket_component = do {
        let (first, first_char) = *_parse_class_atom;
        let last = *do {
            let _ = *match_char('-');
            _parse_class_atom
        }.map(some).or_else(pure $ none());
        if last.is_none { pure $ first };
        let (last, last_char) = last.as_some;
        if first_char.is_none || last_char.is_none {
            pure $ first.add('-').union(last)
        };
        let (start, end) = (first_char.as_some, last_char.as_some);
        if start > end {
            error_parser $ "Range out of order in character class"
        };
        pure $ CharClass::range(start, end)
    };

    // Parses a class atom of a bracket expression: a character other than `]`, or an escape. It
    // gives the class the atom stands for, and the character where the atom stands for one. A
    // character from U+0080 upward, written as itself or as an escape, is reported as an error.
    _parse_class_atom: Parser (CharClass, Option U8);
    _parse_class_atom = do {
        let c = *match_any_char.filter(|c| c != ']');
        if c != '\\' { _parse_rest_of_char(c).bind(_class_atom_of_char) };
        _parse_class_escape.map(|cls| (cls, none()))
        .or_else(_parse_escaped_char(true).bind(_class_atom_of_char))
    };

    // Gives the class atom of the character whose UTF-8 bytes are `bytes`.
    _class_atom_of_char: Array U8 -> Parser (CharClass, Option U8);
    _class_atom_of_char = |bytes| (
        if bytes.to_iter.check_any(|b| b >= 0x80_U8) {
            error_parser $ "A character from U+0080 upward in a bracket expression is not supported"
        };
        pure $ (CharClass::singleton(bytes.@(0)), some(bytes.@(0)))
    );

    // `pat.assign_group_number(n)` assigns group number for each group.
    // The first group number becomes `n`.
    // It returns the translated pattern along with group count.
    assign_group_number: I64 -> Pattern -> (I64, Pattern);
    assign_group_number = |n, pat| (
        if pat.is_pclass || pat.is_passert {
            (n, pat)
        };
        if pat.is_psequence {
            let input: Array Pattern = pat.as_psequence;
            let output: Array Pattern = Array::empty(input.@size);
            let (n, output) = input.to_iter.fold(
                (n, output), |pat_inner, (n, output)|
                let (n, pat_inner) = pat_inner.assign_group_number(n);
                let output = output.push_back(pat_inner);
                (n, output)
            );
            let pat = psequence $ output;
            (n, pat)
        };
        if pat.is_peither {
            let (pat1, pat2) = pat.as_peither;
            let (n, pat1) = pat1.assign_group_number(n);
            let (n, pat2) = pat2.assign_group_number(n);
            let pat = peither $ (pat1, pat2);
            (n, pat)
        };
        if pat.is_pquant {
            let (pat_inner, min, max, greedy) = pat.as_pquant;
            let (n, pat_inner) = pat_inner.assign_group_number(n);
            let pat = pquant $ (pat_inner, min, max, greedy);
            (n, pat)
        };
        if pat.is_pgroup {
            let (_, pat_inner) = pat.as_pgroup;
            let gn = n;
            let (n, pat_inner) = pat_inner.assign_group_number(gn + 1);
            let pat = pgroup $ (gn, pat_inner);
            (n, pat)
        };
        undefined("err")
    );

    // The pattern read from right to left: it matches the bytes of every match of `pat` taken in
    // the opposite order, `^` and `$` changing places. It captures no group.
    //
    // # Parameters
    // * `pat` - The pattern to read from right to left.
    reverse: Pattern -> Pattern;
    reverse = |pat| (
        if pat.is_pclass { pat };
        if pat.is_passert {
            passert $ if pat.as_passert.is_pa_begin { pa_end() } else { pa_begin() }
        };
        if pat.is_psequence {
            let pats = pat.as_psequence;
            let count = pats.@size;
            psequence $ Array::from_map(count, |i| pats.@(count - 1 - i).reverse)
        };
        if pat.is_peither {
            let (left, right) = pat.as_peither;
            peither $ (left.reverse, right.reverse)
        };
        if pat.is_pquant {
            let (inner, least, most, greedy) = pat.as_pquant;
            pquant $ (inner.reverse, least, most, greedy)
        };
        if pat.is_pgroup {
            let (_, inner) = pat.as_pgroup;
            inner.reverse
        };
        undefined("reverse: unknown pattern")
    );

    // Whether a pattern may match while reading no byte.
    //
    // # Parameters
    // * `pat` - The pattern to read.
    matches_empty: Pattern -> Bool;
    matches_empty = |pat| (
        if pat.is_pclass { false };
        if pat.is_passert { true };
        if pat.is_psequence {
            pat.as_psequence.to_iter.fold(true, |inner, all| all && inner.matches_empty)
        };
        if pat.is_peither {
            let (left, right) = pat.as_peither;
            left.matches_empty || right.matches_empty
        };
        if pat.is_pquant {
            let (inner, least, _, _) = pat.as_pquant;
            least == 0 || inner.matches_empty
        };
        if pat.is_pgroup {
            let (_, inner) = pat.as_pgroup;
            inner.matches_empty
        };
        undefined("matches_empty: unknown pattern")
    );

    // The groups a pattern holds, numbered as `assign_group_number` numbered them: the first
    // number and one past the last, both `0` where it holds none. The groups a pattern holds are
    // numbered one after another.
    //
    // # Parameters
    // * `pat` - The pattern to read.
    groups_within: Pattern -> (I64, I64);
    groups_within = |pat| (
        let join = |(first, end), (other_first, other_end)| (
            if first == end { (other_first, other_end) };
            if other_first == other_end { (first, end) };
            (min(first, other_first), max(end, other_end))
        );
        if pat.is_pclass || pat.is_passert { (0, 0) };
        if pat.is_psequence {
            pat.as_psequence.to_iter.fold((0, 0), |inner, span| join(span, inner.groups_within))
        };
        if pat.is_peither {
            let (left, right) = pat.as_peither;
            join(left.groups_within, right.groups_within)
        };
        if pat.is_pquant {
            let (inner, _, _, _) = pat.as_pquant;
            inner.groups_within
        };
        if pat.is_pgroup {
            let (group, inner) = pat.as_pgroup;
            join((group, group + 1), inner.groups_within)
        };
        undefined("groups_within: unknown pattern")
    );
}
// How many bytes a stretch of a pattern may read where it may read any number of them.
//
// It stands for "any number", and it is a quarter of the largest number there is, so that the
// bound a quantifier with no upper bound carries is itself at least this much, and so that two of
// these added or multiplied together stay a number.
__UNBOUNDED_READ : I64;
__UNBOUNDED_READ = I64::maximum / 4;

// How many sets of forced byte strings are kept for a pattern. Alternation multiplies them, and a
// search takes the one set the text it is over holds least often, so what this bounds is how many
// sets are weighed against the text.
__MAX_FORCED_SETS : I64;
__MAX_FORCED_SETS = 4;

// How many byte strings a set of forced ones may hold. A set is looked for by looking for each of
// its members in turn, so a large one costs more to look for than it rules out.
__MAX_FORCED_MEMBERS : I64;
__MAX_FORCED_MEMBERS = 4;

// How many bytes of a forced byte string are kept. A longer one rules out more, and the reading
// that looks for it costs the same either way, so what bounds this is the room the strings take.
__MAX_FORCED_LENGTH : I64;
__MAX_FORCED_LENGTH = 16;

// The empty set of byte values.
no_bytes : Array U64;
no_bytes = Array::fill(4, 0_U64);

// The set of every byte value.
all_bytes : Array U64;
all_bytes = Array::fill(4, U64::maximum);

// The byte values a character class holds, one bit each, together with the one it holds where it
// holds one alone: `-1` where it holds none and `-2` where it holds several.
//
// Both are read off one walk over the byte values, since a class judges a byte by running a
// function and that is what reading it costs.
//
// # Parameters
// * `cls` - The class to read.
bytes_of_class : CharClass -> (Array U64, I64);
bytes_of_class = |cls| (
    Iterator::range(0, 256).fold((no_bytes, -1), |i, (bits, lone)|
        if !cls.contains(i.u8) { (bits, lone) };
        (
            bits.mod(i / 64, bit_or(1_U64.shift_left((i % 64).u64))),
            if lone == -1 { i } else { -2 }
        )
    )
);

// The byte values either set holds, one bit each.
//
// # Parameters
// * `other` - The set to take together with this one.
// * `bits` - The set to take it together with.
bytes_union : Array U64 -> Array U64 -> Array U64;
bytes_union = |other, bits| (
    Iterator::range(0, 4).fold(bits, |w, bits| bits.mod(w, bit_or(other.@(w))))
);

// The sum of two counts of bytes read, "any number" swallowing whatever it is added to.
_read_sum : I64 -> I64 -> I64;
_read_sum = |a, b| if a >= __UNBOUNDED_READ || b >= __UNBOUNDED_READ { __UNBOUNDED_READ } else { a + b };

// A count of bytes read, taken that many times over, "any number" swallowing whatever multiplies
// it.
_read_times : I64 -> I64 -> I64;
_read_times = |a, n| (
    if a >= __UNBOUNDED_READ || n >= __UNBOUNDED_READ { __UNBOUNDED_READ };
    if n <= 0 || a <= 0 { 0 };
    if a > __UNBOUNDED_READ / n { __UNBOUNDED_READ };
    a * n
);

// A byte string every text a pattern matches holds, together with what the pattern may read before
// it.
//
// A search that finds the string standing at a position knows a match holding that string begins
// no earlier than `back_max` bytes before it, and no earlier than the run of bytes drawn from
// `back_class` that ends there.
type ForcedRun = unbox struct {
    bytes: Array U8,        // the byte string every match holds
    back_max: I64,          // most bytes the pattern may read before it
    back_class: Array U64   // the byte values the pattern may read before it, one bit each
};

// What a pattern forces the text it matches to hold, and what it may read.
//
// What it may read is carried along because a string forced by one stretch of a pattern has
// whatever the stretches before it read standing ahead of it, which is what says how far back a
// match holding that string may begin. Working it out on its own would walk the pattern again for
// every stretch of it.
type Forced = unbox struct {
    // The one byte string the pattern matches, where it matches that one and no other.
    exact: Option (Array U8),
    // Sets of forced byte strings. Every text the pattern matches holds a member of each of these
    // sets, so a search is free to take whichever set it likes and look for that set alone.
    sets: Array (Array ForcedRun),
    // The most bytes the pattern may read, or `__UNBOUNDED_READ` where it may read any number.
    max_read: I64,
    // The byte values the pattern may read, one bit each.
    read_bytes: Array U64
};

// A pattern that forces nothing and reads nothing.
_forced_of_nothing : Forced;
_forced_of_nothing = Forced {
    exact: none(), sets: Array::empty(0), max_read: 0, read_bytes: no_bytes
};

// A pattern that matches one byte string and no other, standing where nothing is read before it.
//
// # Parameters
// * `bytes` - The byte string it matches.
_forced_of_bytes : Array U8 -> Forced;
_forced_of_bytes = |bytes| Forced {
    exact: some(bytes),
    sets: if bytes.@size == 0 { Array::empty(0) } else {
        [[ForcedRun { bytes: bytes, back_max: 0, back_class: no_bytes }]]
    },
    max_read: 0,
    read_bytes: no_bytes
};

// The runs of a set, each told that more may be read before it than it knew.
//
// # Parameters
// * `more` - How many more bytes may be read before them.
// * `bits` - The byte values those bytes may be drawn from.
// * `runs` - The set to move back.
_runs_after : I64 -> Array U64 -> Array ForcedRun -> Array ForcedRun;
_runs_after = |more, bits, runs| (
    runs.map(|run| run
        .mod_back_max(|m| _read_sum(m, more))
        .mod_back_class(bytes_union(bits))
    )
);

// The sets of two stretches a text may match either of, each set of the one taken together with
// each set of the other.
//
// A text that matches either stretch holds a member of every set of that stretch, so a set of one
// put together with a set of the other binds both.
//
// # Parameters
// * `left` - The sets of the one.
// * `right` - The sets of the other.
_sets_together : Array (Array ForcedRun) -> Array (Array ForcedRun) -> Array (Array ForcedRun);
_sets_together = |left, right| (
    if left.@size == 0 || right.@size == 0 { Array::empty(0) };
    left.to_iter.fold(Array::empty(__MAX_FORCED_SETS), |left_set, out|
        right.to_iter.fold(out, |right_set, out|
            if out.@size >= __MAX_FORCED_SETS { out };
            let both = left_set.append(right_set);
            if both.@size > __MAX_FORCED_MEMBERS { out };
            out.push_back(both)
        )
    )
);

// What a sequence of patterns forces the text it matches to hold.
//
// Neighbouring stretches that each match one byte string and no other are read as one byte string,
// which is longer and so stands in fewer places than either. A stretch that matches several breaks
// the string being built and hands over whatever it forces on its own.
//
// # Parameters
// * `pats` - The patterns, in the order the text meets them.
_forced_of_sequence : Array Pattern -> Forced;
_forced_of_sequence = |pats| (
    let empty_run = Array::empty(__MAX_FORCED_LENGTH);
    let start = (empty_run, 0, no_bytes, 0, no_bytes, Array::empty(__MAX_FORCED_SETS), true);
    let (run, run_max, run_bits, total_max, total_bits, sets, is_exact) = pats.to_iter.fold(start,
        |pat, (run, run_max, run_bits, pre_max, pre_bits, sets, is_exact)|
        let forced = forced_of(pat);
        let next_max = _read_sum(pre_max, forced.@max_read);
        let next_bits = bytes_union(forced.@read_bytes, pre_bits);
        if forced.@exact.is_some {
            let more = forced.@exact.as_some;
            let (run_max, run_bits) = if run.@size == 0 { (pre_max, pre_bits) } else { (run_max, run_bits) };
            // A string that would outgrow the room kept for it is broken here, and what follows
            // starts a string of its own, so that every string kept stands in the text entire.
            if run.@size + more.@size > __MAX_FORCED_LENGTH {
                let sets = _sets_with_run_closed(run, run_max, run_bits, sets);
                (more, pre_max, pre_bits, next_max, next_bits, sets, false)
            };
            (run.append(more), run_max, run_bits, next_max, next_bits, sets, is_exact)
        };
        let sets = _sets_with_run_closed(run, run_max, run_bits, sets);
        let sets = forced.@sets.to_iter.fold(sets, |set, sets|
            if sets.@size >= __MAX_FORCED_SETS { sets };
            sets.push_back(_runs_after(pre_max, pre_bits, set))
        );
        (empty_run, 0, no_bytes, next_max, next_bits, sets, false)
    );
    Forced {
        exact: if is_exact { some(run) } else { none() },
        sets: _sets_with_run_closed(run, run_max, run_bits, sets),
        max_read: total_max,
        read_bytes: total_bits
    }
);

// The sets a run being built is put among, where it holds anything.
//
// # Parameters
// * `run` - The byte string built so far.
// * `run_max` - How many bytes the pattern may read before it.
// * `run_bits` - The byte values those bytes may be drawn from.
// * `sets` - The sets to put it among.
_sets_with_run_closed : Array U8 -> I64 -> Array U64 -> Array (Array ForcedRun) -> Array (Array ForcedRun);
_sets_with_run_closed = |run, run_max, run_bits, sets| (
    if run.@size == 0 { sets };
    if sets.@size >= __MAX_FORCED_SETS { sets };
    sets.push_back([ForcedRun { bytes: run, back_max: run_max, back_class: run_bits }])
);

// A byte string written out a number of times over.
//
// # Parameters
// * `bytes` - The byte string to write out.
// * `times` - How many times to write it.
_repeated : Array U8 -> I64 -> Array U8;
_repeated = |bytes, times| (
    Iterator::range(0, times).fold(Array::empty(bytes.@size * times), |_, out| out.append(bytes))
);

// What a pattern forces the text it matches to hold.
//
// # Parameters
// * `pat` - The pattern to read.
forced_of : Pattern -> Forced;
forced_of = |pat| (
    if pat.is_pclass {
        let (bits, lone) = bytes_of_class(pat.as_pclass);
        let forced = if lone < 0 { _forced_of_nothing } else { _forced_of_bytes([lone.u8]) };
        forced.set_max_read(1).set_read_bytes(bits)
    };
    if pat.is_passert { _forced_of_bytes(Array::empty(0)) };
    if pat.is_pgroup { let (_, inner) = pat.as_pgroup; forced_of(inner) };
    if pat.is_psequence { _forced_of_sequence(pat.as_psequence) };
    if pat.is_peither {
        let (left, right) = pat.as_peither;
        let (forced_left, forced_right) = (forced_of(left), forced_of(right));
        Forced {
            exact: none(),
            sets: _sets_together(forced_left.@sets, forced_right.@sets),
            max_read: if forced_left.@max_read >= forced_right.@max_read {
                forced_left.@max_read
            } else {
                forced_right.@max_read
            },
            read_bytes: bytes_union(forced_left.@read_bytes, forced_right.@read_bytes)
        }
    };
    if pat.is_pquant {
        let (inner, least, most, _) = pat.as_pquant;
        let forced = forced_of(inner);
        let read_bytes = forced.@read_bytes;
        let max_read = _read_times(forced.@max_read, most);
        // A round the pattern may do without forces nothing.
        if least == 0 {
            Forced {
                exact: none(), sets: Array::empty(0), max_read: max_read, read_bytes: read_bytes
            }
        };
        if forced.@exact.is_some && forced.@exact.as_some.@size > 0 {
            let once = forced.@exact.as_some;
            // How many rounds the room kept for a forced byte string holds. The count is read off a
            // division, so that it stands whatever number of rounds the quantifier asks for: a
            // pattern names that number, and multiplying by it leaves `I64`.
            let room = __MAX_FORCED_LENGTH / once.@size;
            let rounds = if least > room { room } else { least };
            let run = _repeated(once, rounds);
            Forced {
                exact: if least == most && rounds == least { some(run) } else { none() },
                sets: [[ForcedRun { bytes: run, back_max: 0, back_class: no_bytes }]],
                max_read: max_read,
                read_bytes: read_bytes
            }
        };
        // What one round forces the whole forces, and the rounds before it may be backed over.
        let before_max = _read_times(forced.@max_read, _read_sum(most, -1));
        Forced {
            exact: none(),
            sets: forced.@sets.map(_runs_after(before_max, read_bytes)),
            max_read: max_read,
            read_bytes: read_bytes
        }
    };
    undefined("forced_of: unknown pattern")
);
